{
  "id": "google-calendar-collect",
  "name": "Google Calendar 日程采集",
  "draftVersion": 1,
  "updatedAt": 0,
  "parameters": [
    {
      "name": "connection",
      "label": "我的 Google 连接",
      "type": "string",
      "required": true,
      "default": "personal",
      "description": "填写“我的数据连接”中的连接标识；始终使用当前登录用户自己的凭据。",
      "role": "option"
    },
    {
      "name": "directory",
      "label": "保存来源目录",
      "type": "string",
      "required": true,
      "default": "imports/google",
      "description": "保存到当前执行工作区的目录。扫描范围应包含该目录。",
      "role": "option"
    },
    {
      "name": "maxItems",
      "label": "每次最多采集条数",
      "type": "number",
      "default": 100,
      "description": "1–500；超限会停止并保留已有来源，请缩小时间范围。",
      "role": "policy"
    },
    {
      "name": "calendarId",
      "label": "日历",
      "type": "string",
      "required": true,
      "default": "primary",
      "description": "primary 表示当前账号主日历；也可填写有读取权限的日历 ID。",
      "role": "option"
    },
    {
      "name": "pastDays",
      "label": "回看天数",
      "type": "number",
      "default": 7,
      "description": "相对于采集当天，0–180。",
      "role": "option"
    },
    {
      "name": "futureDays",
      "label": "未来天数",
      "type": "number",
      "default": 30,
      "description": "相对于采集当天，1–180。包含全天日程、重复事件实例和取消状态。",
      "role": "option"
    }
  ],
  "runPolicy": {
    "maxNodes": 4,
    "maxConcurrency": 1
  },
  "nodes": [
    {
      "id": "collect",
      "name": "读取并保存来源",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "capabilities": [
        "google.calendar.collect"
      ],
      "config": {
        "toolId": "google.calendar.collect",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "connection": "${param.connection}",
          "directory": "${param.directory}",
          "maxItems": "${param.maxItems}",
          "calendarId": "${param.calendarId}",
          "pastDays": "${param.pastDays}",
          "futureDays": "${param.futureDays}"
        }
      }
    }
  ],
  "edges": [],
  "outputs": {
    "result": {
      "value": "${nodes.collect.outputs.result}"
    }
  }
}
