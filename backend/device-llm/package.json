{
  "name": "@itookit/device-llm",
  "version": "0.1.0",
  "description": "LLM device provider support, model capabilities and pricing metadata",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {"types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts"},
    "./contracts": {"types": "./src/contracts.ts", "import": "./src/contracts.ts", "default": "./src/contracts.ts"}
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs"},
      "./contracts": {"types": "./dist/contracts.d.ts", "import": "./dist/contracts.js", "require": "./dist/contracts.cjs"}
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup && node scripts/check-entrypoints.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {"@itookit/driver-llm": "workspace:*"},
  "devDependencies": {"tsup": "^8.5.1", "typescript": "^5.9.3", "vitest": "^1.6.1", "@types/node": "20.19.25"}
}
