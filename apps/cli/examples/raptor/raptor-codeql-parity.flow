    {
      "id": "verify",
      "name": "验证样例、查询与依赖锁；记录 CodeQL 版本",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 300000,
        "args": {
          "command": "set -e\nsha256sum -c input.sha256 > flow/input-check.log\ncodeql version --format=json > flow/codeql-version.json\njq -e ' .version == \"2.27.3\" ' flow/codeql-version.json\ncommand -v gcc\ncommand -v javac\ncommand -v go",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "cpp-smt-create",
      "name": "独立构建 cpp-smt 数据库",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 300000,
        "args": {
          "command": "set -e\nGOTOOLCHAIN=local codeql database create flow/cpp-smt-db --language=cpp --source-root=target/smt-c --threads=2 --ram=2048 --common-caches=cache --overwrite '--command=gcc -c smt_codeql_testbench.c' > flow/cpp-smt-create.log 2>&1\njq -nc --arg language cpp-smt '{language:$language,databaseCreated:true}'",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "cpp-smt-analyze",
      "name": "执行 cpp-smt 上游查询并保存全部 SARIF",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 300000,
        "args": {
          "command": "set -e\ncodeql database analyze flow/cpp-smt-db packs/codeql/cpp-queries/1.9.2/codeql-suites/cpp-security-and-quality.qls --format=sarif-latest --output=flow/cpp-smt.sarif --threads=2 --ram=2048 --common-caches=cache --max-paths=4 --threat-model=local > flow/cpp-smt-analyze.log 2>&1\njq -c '{findings:([.runs[].results[]?]|length),codeFlows:([.runs[].results[]?.codeFlows[]?]|length)}' flow/cpp-smt.sarif",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
