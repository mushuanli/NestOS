    {
      "id": "directories",
      "name": "准备独立 CodeQL 数据库和报告目录",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 300000,
        "args": {
          "command": "mkdir -p flow",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
