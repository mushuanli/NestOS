{
  "provider": {
    "id": "doubao-speech",
    "isBuiltin": true,
    "name": "Doubao (豆包语音)",
    "implementation": "custom",
    "baseURL": "https://openspeech.bytedance.com",
    "modelsPath": false,
    "defaultPath": "/api/v3/tts/unidirectional",
    "media": {
      "speech.synthesize": {
        "adapter": "doubao-speech",
        "path": "/api/v3/tts/unidirectional",
        "sampleRate": 24000
      }
    }
  },
  "reference": {
    "version": 1,
    "reviewedAt": "2026-10-22",
    "scope": "HTTP 单向流式合成与公开的 2.0 音色目录快照；不包含账号私有音色，也不代表账号授权。",
    "sources": [
      {
        "id": "http",
        "title": "单向流式语音合成 HTTP",
        "url": "https://docs.volcengine.com/docs/DoubaoVoice/unidirectional-streaming-text-to-speech-http?lang=zh"
      },
      {
        "id": "voices",
        "title": "公开音色列表",
        "url": "https://docs.volcengine.com/docs/DoubaoVoice/Tonelist-1?lang=zh"
      },
      {
        "id": "discovery",
        "title": "ListSpeakers 音色查询",
        "url": "https://docs.volcengine.com/docs/DoubaoVoice/ListSpeakers-LargeModelSoundListNewInterface?lang=zh"
      }
    ],
    "models": [
      {
        "id": "seed-tts-2.0",
        "name": "Doubao Speech 2.0",
        "kind": "resource",
        "support": "implemented",
        "notes": "X-Api-Resource-Id；使用公开 2.0 音色。"
      },
      {
        "id": "seed-icl-2.0",
        "name": "豆包声音复刻 2.0",
        "kind": "resource",
        "support": "unsupported",
        "notes": "需要账号私有复刻音色及独立配置，默认目录不启用。"
      },
      {
        "id": "seed-tts-2.0-standard",
        "name": "复刻标准版",
        "kind": "body-model",
        "support": "unsupported",
        "notes": "请求体 req_params.model 的变体，不能作为资源 ID；默认不支持指令 QA/Cot。"
      },
      {
        "id": "seed-tts-2.0-expressive",
        "name": "复刻表现力增强版",
        "kind": "body-model",
        "support": "unsupported",
        "notes": "请求体模型变体，不能替代 X-Api-Resource-Id；当前适配器未暴露此参数。"
      }
    ],
    "formats": [
      {
        "id": "mp3",
        "name": "MP3",
        "wireValue": "mp3",
        "support": "implemented",
        "sampleRates": [
          8000,
          16000,
          22050,
          24000,
          32000,
          44100,
          48000
        ],
        "defaultSampleRate": 24000
      },
      {
        "id": "opus",
        "name": "Opus",
        "wireValue": "ogg_opus",
        "support": "implemented",
        "sampleRates": [
          48000
        ],
        "defaultSampleRate": 48000,
        "notes": "客户端格式为 opus，适配器转换为 ogg_opus 并使用 48000 Hz。"
      },
      {
        "id": "pcm",
        "name": "PCM",
        "wireValue": "pcm",
        "support": "implemented",
        "sampleRates": [
          8000,
          16000,
          22050,
          24000,
          32000,
          44100,
          48000
        ],
        "defaultSampleRate": 24000,
        "notes": "原始音频不含文件头，当前验证页不提供 PCM 播放预览。"
      },
      {
        "id": "wav",
        "name": "WAV",
        "wireValue": "wav",
        "support": "unsupported",
        "sampleRates": [
          8000,
          16000,
          22050,
          24000,
          32000,
          44100,
          48000
        ],
        "defaultSampleRate": 24000,
        "notes": "官方支持但流式返回可能重复文件头；当前适配器不提供 WAV 输出，推荐使用 PCM。"
      }
    ],
