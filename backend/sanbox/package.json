{
    "name": "@itookit/sanbox",
    "version": "0.1.0",
    "description": "Host-owned Seatbelt and Bubblewrap process sandbox launch plans",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": { "types": "./src/index.ts", "import": "./src/index.ts", "default": "./src/index.ts" },
        "./node": { "types": "./src/node.ts", "import": "./src/node.ts", "default": "./src/node.ts" }
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.cjs",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
            "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js", "require": "./dist/node.cjs" }
        }
    },
    "files": ["dist"],
    "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit" },
    "license": "MIT",
    "devDependencies": { "@types/node": "^20.10.0", "tsup": "^8.5.1", "typescript": "^5.9.3", "vitest": "^3.2.1" }
}
