{
  "name": "@itookit/llm-tasks",
  "version": "0.1.0",
  "description": "Durable LLM task programs, context assembly, and provider-neutral message policies",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./contracts": {
        "import": {
          "types": "./dist/contracts.d.ts",
          "default": "./dist/contracts.js"
        },
        "require": {
          "types": "./dist/contracts.d.cts",
          "default": "./dist/contracts.cjs"
        }
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm build",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "llm-tasks",
    "llm-task",
    "durable-program",
    "typescript"
  ],
  "author": "lizlok@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mushuanli/itookit.git",
    "directory": "packages/llm-tasks"
  },
  "bugs": {
    "url": "https://github.com/mushuanli/itookit/issues"
  },
  "homepage": "https://github.com/mushuanli/itookit/tree/main/packages/llm-tasks#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@itookit/durable-kernel": "workspace:*",
    "@itookit/llm-context": "workspace:*",
    "@itookit/tools": "workspace:*",
    "@itookit/driver-llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@vitest/coverage-v8": "^1.6.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1"
  }
}
