{
  "id": "raptor-parity",
  "name": "RAPTOR 全规则用例与原版基线确定性对比",
  "draftVersion": 1,
  "updatedAt": 0,
  "parameters": [
    {
      "name": "cases",
      "type": "json",
      "required": true,
      "description": "Case records with id, rulePath, targets, expectation and optional exact assertions."
    }
  ],
  "functions": [
    {
      "id": "raptor-parity-case",
      "name": "单个 RAPTOR 用例：扫描、精确断言与基线对比",
      "draftVersion": 1,
      "updatedAt": 0,
      "parameters": [
        {
          "name": "case",
          "type": "json",
          "required": true
        }
      ],
      "nodes": [
        {
          "id": "request",
          "name": "保存已验证的用例参数",
          "plugin": "builtin.tool",
          "pluginVersion": "1.0.0",
          "inputs": {},
          "config": {
            "toolId": "Write",
            "toolVersion": "1",
            "approval": "none",
            "timeoutMs": 30000,
            "args": {
              "file_path": "/workspace/flow/${param.case.id}.params.json",
              "content": "{\"case\":${param.case}}\n"
            }
          },
          "capabilities": [
            "Write"
          ]
        },
        {
          "id": "scan",
          "name": "Semgrep 完整结果落盘；保留失败状态继续比较",
          "plugin": "builtin.tool",
          "pluginVersion": "1.0.0",
          "inputs": {},
          "config": {
            "toolId": "Bash",
            "toolVersion": "1",
            "approval": "none",
            "timeoutMs": 180000,
            "args": {
              "command": "set -e\njq -j '.case | ([\"--config\", (\"rules/\" + .rulePath)] + [.targets[] | \"target/\" + .])[] | ., \"\\u0000\"' flow/${param.case.id}.params.json > flow/${param.case.id}.argv\n: > flow/${param.case.id}.json\nset +e\nxargs -0 -r semgrep scan --json --metrics off --disable-version-check --no-git-ignore --no-rewrite-rule-ids --strict --jobs 1 --json-output flow/${param.case.id}.json < flow/${param.case.id}.argv > flow/${param.case.id}.stdout.log 2> flow/${param.case.id}.stderr.log\nscan_status=$?\njq -nc --argjson exitCode \"$scan_status\" '{exitCode:$exitCode}' > flow/${param.case.id}.status.json\ncat flow/${param.case.id}.status.json",
              "timeout_ms": 180000
            }
          },
          "capabilities": [
            "Bash"
          ],
          "portSchemas": {
            "outputs": {
              "result": {
                "id": "raptor.parity.shell-result",
                "version": "1",
                "definition": {
                  "type": "object",
                  "required": [
                    "stdout",
                    "exitCode",
                    "truncated"
                  ],
                  "properties": {
                    "stdout": {
                      "type": "string"
                    },
                    "exitCode": {
                      "type": "integer",
                      "enum": [
                        0
                      ]
                    },
                    "truncated": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "id": "compare",
          "name": "比较完整 finding 元组、错误、跳过和扫描文件",
          "plugin": "builtin.tool",
          "pluginVersion": "1.0.0",
          "inputs": {},
          "config": {
            "toolId": "Bash",
            "toolVersion": "1",
            "approval": "none",
            "timeoutMs": 180000,
            "args": {
              "command": "set -e\nbaseline_present=false\nif test -f baseline/${param.case.id}.json; then\n  cp baseline/${param.case.id}.json flow/${param.case.id}.baseline.raw.json\n  baseline_present=true\nelse\n  printf '{}\\n' > flow/${param.case.id}.baseline.raw.json\nfi\njq -n --slurpfile spec flow/${param.case.id}.params.json --slurpfile status flow/${param.case.id}.status.json --argjson baselinePresent \"$baseline_present\" --rawfile rawBaseline flow/${param.case.id}.baseline.raw.json --rawfile rawActual flow/${param.case.id}.json 'def relative_path: sub(\"^\\\\./\"; \"\") | sub(\"^target/\"; \"\");\ndef normalized:\n  if type == \"object\" and (.results | type == \"array\") and (.errors | type == \"array\") and (.paths.scanned | type == \"array\") then\n    {valid:true,\n     findings: ([.results[] | {ruleId:.check_id,path:(.path | relative_path),start:{line:.start.line,col:.start.col},end:{line:.end.line,col:.end.col},message:.extra.message,severity:.extra.severity}] | sort_by(.ruleId,.path,.start.line,.start.col,.end.line,.end.col,.message,.severity)),\n     errors: (.errors | walk(if type == \"object\" and (.path | type == \"string\") then .path |= relative_path else . end) | sort_by(tojson)),\n     skipped: ((.paths.skipped // []) | walk(if type == \"object\" and (.path | type == \"string\") then .path |= relative_path else . end) | sort_by(tojson)),\n     scanned: (.paths.scanned | map(relative_path) | unique | sort)}\n  else {valid:false,findings:[],errors:[],skipped:[],scanned:[]} end;\ndef matches($finding; $expected): $finding.path == $expected.path and $finding.start.line == $expected.line and ($finding.ruleId | endswith($expected.ruleIdSuffix));\ndef expectations($actual; $case):\n  ($actual.findings) as $findings |\n  (if $case.expectation == \"negative\" then ($findings | length) == 0\n   elif $case.expectation == \"positive\" then all($case.targets[]; . as $target | any($findings[]; .path == $target))\n   else true end)\n  and (if $case.expected == null then true else\n    all($case.expected[]; . as $expected | any($findings[]; matches(.;$expected)))\n    and all($findings[]; . as $finding | any($case.expected[]; matches($finding;.))) end)\n  and all(($case.expectedLines // [])[]; . as $expected | ([$findings[] | select(.path == $expected.path) | .start.line] | unique | sort) == ($expected.lines | unique | sort));\n($spec[0].case) as $case |\n(try ($rawBaseline | fromjson | normalized) catch {valid:false,findings:[],errors:[],skipped:[],scanned:[]}) as $baseline |\n(try ($rawActual | fromjson | normalized) catch {valid:false,findings:[],errors:[],skipped:[],scanned:[]}) as $actual |\n($baseline == $actual and $baseline.valid and $actual.valid and $baselinePresent) as $equal |\n(expectations($actual;$case)) as $expectationPassed |\n{caseId:$case.id,rulePath:$case.rulePath,targets:$case.targets,expectation:$case.expectation,\n baselinePresent:$baselinePresent,scanExitCode:$status[0].exitCode,equal:$equal,expectationPassed:$expectationPassed,\n passed:($equal and $expectationPassed and $status[0].exitCode == 0 and ($actual.errors | length) == 0),\n baseline:$baseline,actual:$actual,missing:($baseline.findings - $actual.findings),extra:($actual.findings - $baseline.findings)}' > flow/${param.case.id}.comparison.json\njq '.actual' flow/${param.case.id}.comparison.json > flow/${param.case.id}.normalized.json\njq '.baseline' flow/${param.case.id}.comparison.json > flow/${param.case.id}.baseline.normalized.json\njq -c '{summary:{caseId,rulePath,expectation,passed,equal,expectationPassed,baselinePresent,scanExitCode,\n baselineValid:.baseline.valid,flowValid:.actual.valid,\n baselineCount:(.baseline.findings|length),flowCount:(.actual.findings|length),\n baselineErrors:(.baseline.errors|length),flowErrors:(.actual.errors|length),\n baselineSkipped:(.baseline.skipped|length),flowSkipped:(.actual.skipped|length),\n missingCount:(.missing|length),extraCount:(.extra|length),comparisonFile:(\"flow/\"+.caseId+\".comparison.json\")}}' flow/${param.case.id}.comparison.json",
              "timeout_ms": 180000
            }
          },
          "capabilities": [
            "Bash"
          ],
          "portSchemas": {
            "outputs": {
              "result": {
                "id": "raptor.parity.shell-result",
                "version": "1",
                "definition": {
                  "type": "object",
                  "required": [
                    "stdout",
                    "exitCode",
                    "truncated"
                  ],
                  "properties": {
                    "stdout": {
                      "type": "string"
                    },
                    "exitCode": {
                      "type": "integer",
                      "enum": [
                        0
                      ]
                    },
                    "truncated": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "id": "result",
          "name": "读取该用例的完整性与等价结论",
          "plugin": "builtin.transform",
          "pluginVersion": "1.0.0",
          "inputs": {},
          "config": {
            "operation": "pick",
            "value": "${nodes.compare.outputs.result}",
            "path": [
              "stdout",
              "summary"
            ],
            "type": "json"
          }
        }
      ],
      "edges": [
        {
          "id": "request-to-scan",
          "from": "request",
          "to": "scan",
          "kind": "control"
        },
        {
          "id": "scan-to-compare",
          "from": "scan",
          "to": "compare",
          "kind": "control"
        }
      ],
      "outputs": {
        "result": {
          "value": "${nodes.result.outputs.result}"
        }
      }
    }
  ],
  "nodes": [
    {
      "id": "directories",
      "name": "准备持久规则和证据目录",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 180000,
        "args": {
          "command": "mkdir -p flow rules/auth rules/c rules/crypto rules/deserialisation rules/filesystem rules/flows rules/go rules/injection rules/java rules/javascript rules/logging rules/php rules/python rules/secrets rules/sinks rules/web rules/xml",
          "timeout_ms": 180000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "manifest",
      "name": "保存运行用例清单",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/flow/cases.json",
          "content": "{\"cases\":${param.cases}}\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-001",
      "name": "RAPTOR 原始规则 auth/jwt-no-verify.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/auth/jwt-no-verify.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — JWT decoded without signature verification (CWE-345)\n  # Pattern rules (not taint) — the issue is missing verification, not\n  # data flow.\n  # ---------------------------------------------------------------------------\n  - id: raptor.auth.jwt-no-verify.python\n    message: >-\n      JWT is decoded without signature verification. An attacker can forge\n      arbitrary tokens. Always verify the signature with a trusted key\n      and explicit algorithm.\n    languages: [python]\n    severity: CRITICAL\n    pattern-either:\n      # PyJWT >= 2.x — options dict disables verification\n      - pattern: 'jwt.decode($TOKEN, ..., options={\"verify_signature\": False}, ...)'\n      # PyJWT >= 2.x — algorithms=[\"none\"] accepts unsigned tokens\n      - pattern: jwt.decode($TOKEN, ..., algorithms=[\"none\"], ...)\n      # PyJWT < 2.x — verify kwarg\n      - pattern: jwt.decode($TOKEN, ..., verify=False, ...)\n    metadata:\n      cwe: [\"CWE-345\"]\n      owasp_top_10: [\"A2:2021-Cryptographic Failures\"]\n      tags: [\"security\", \"auth\", \"jwt\", \"misconfiguration\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — JWT decoded without signature verification\n  # jsonwebtoken: decode() never verifies; verify() with empty secret is\n  # equivalent to no verification.\n  # ---------------------------------------------------------------------------\n  - id: raptor.auth.jwt-no-verify.javascript\n    message: >-\n      JWT is decoded without signature verification. jwt.decode() never\n      verifies the signature — use jwt.verify() with a trusted secret.\n      An empty string secret is effectively no verification.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    pattern-either:\n      # jsonwebtoken — decode() skips verification entirely\n      - pattern: jwt.decode($TOKEN, ...)\n      # jsonwebtoken — verify with empty string secret\n      - pattern: jwt.verify($TOKEN, \"\", ...)\n      # jose — disabling verification\n      - pattern: jose.decodeJwt($TOKEN)\n    metadata:\n      cwe: [\"CWE-345\"]\n      owasp_top_10: [\"A2:2021-Cryptographic Failures\"]\n      tags: [\"security\", \"auth\", \"jwt\", \"misconfiguration\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-002",
      "name": "RAPTOR 原始规则 auth/tls-skip-verify.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/auth/tls-skip-verify.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — TLS certificate verification disabled (CWE-295)\n  # Covers requests library methods that accept verify=False.\n  # ---------------------------------------------------------------------------\n  - id: raptor.tls.skip-verify.python\n    message: >-\n      TLS certificate verification is disabled via verify=False (or\n      ssl=False for aiohttp). An attacker in a network position can\n      intercept and modify traffic. Always verify certificates against\n      a trusted CA bundle.\n    languages: [python]\n    severity: HIGH\n    pattern-either:\n      # requests — module-level helpers\n      - pattern: requests.get(..., verify=False, ...)\n      - pattern: requests.post(..., verify=False, ...)\n      - pattern: requests.put(..., verify=False, ...)\n      - pattern: requests.patch(..., verify=False, ...)\n      - pattern: requests.delete(..., verify=False, ...)\n      - pattern: requests.head(..., verify=False, ...)\n      - pattern: requests.options(..., verify=False, ...)\n      - pattern: requests.request(..., verify=False, ...)\n      # requests.Session — per-call verify=False and the session-wide\n      # attribute, anchored to a Session constructed in scope\n      - patterns:\n          - pattern-inside: |\n              $S = requests.Session()\n              ...\n          - pattern-either:\n              - pattern: $S.get(..., verify=False, ...)\n              - pattern: $S.post(..., verify=False, ...)\n              - pattern: $S.put(..., verify=False, ...)\n              - pattern: $S.patch(..., verify=False, ...)\n              - pattern: $S.delete(..., verify=False, ...)\n              - pattern: $S.head(..., verify=False, ...)\n              - pattern: $S.options(..., verify=False, ...)\n              - pattern: $S.request(..., verify=False, ...)\n              - pattern: $S.verify = False\n      # httpx — module-level helpers and client constructors\n      - pattern: httpx.get(..., verify=False, ...)\n      - pattern: httpx.post(..., verify=False, ...)\n      - pattern: httpx.put(..., verify=False, ...)\n      - pattern: httpx.patch(..., verify=False, ...)\n      - pattern: httpx.delete(..., verify=False, ...)\n      - pattern: httpx.head(..., verify=False, ...)\n      - pattern: httpx.options(..., verify=False, ...)\n      - pattern: httpx.request(..., verify=False, ...)\n      - pattern: httpx.Client(..., verify=False, ...)\n      - pattern: httpx.AsyncClient(..., verify=False, ...)\n      # aiohttp — ssl=False on the connector or per-request on a\n      # ClientSession constructed in scope\n      - pattern: aiohttp.TCPConnector(..., ssl=False, ...)\n      - patterns:\n          - pattern-either:\n              - pattern-inside: |\n                  $S = aiohttp.ClientSession(...)\n                  ...\n              - pattern-inside: |\n                  async with aiohttp.ClientSession(...) as $S:\n                      ...\n          - pattern-either:\n              - pattern: $S.get(..., ssl=False, ...)\n              - pattern: $S.post(..., ssl=False, ...)\n              - pattern: $S.put(..., ssl=False, ...)\n              - pattern: $S.patch(..., ssl=False, ...)\n              - pattern: $S.delete(..., ssl=False, ...)\n              - pattern: $S.head(..., ssl=False, ...)\n              - pattern: $S.options(..., ssl=False, ...)\n              - pattern: $S.request(..., ssl=False, ...)\n    metadata:\n      cwe: [\"CWE-295\"]\n      asvs: [\"V14.1\"]\n      tags: [\"security\", \"tls\", \"misconfiguration\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — TLS hostname verification disabled (CWE-295)\n  # ---------------------------------------------------------------------------\n  - id: raptor.tls.skip-verify.java\n    message: >-\n      Default TLS hostname verifier overridden globally. This typically\n      disables hostname verification for all HTTPS connections in the JVM.\n      Use the default verifier or configure per-connection verification.\n    languages: [java]\n    severity: HIGH\n    pattern: HttpsURLConnection.setDefaultHostnameVerifier($X)\n    metadata:\n      cwe: [\"CWE-295\"]\n      asvs: [\"V14.1\"]\n      tags: [\"security\", \"tls\", \"misconfiguration\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — TLS verification disabled (CWE-295)\n  # ---------------------------------------------------------------------------\n  - id: raptor.tls.skip-verify.javascript\n    message: >-\n      TLS certificate verification is disabled. An attacker in a network\n      position can intercept and modify traffic. Do not set\n      rejectUnauthorized to false or NODE_TLS_REJECT_UNAUTHORIZED to \"0\"\n      in production.\n    languages: [javascript, typescript]\n    severity: HIGH\n    pattern-either:\n      - pattern: 'process.env.NODE_TLS_REJECT_UNAUTHORIZED = \"0\"'\n      - pattern: 'new $MODULE.Agent({..., rejectUnauthorized: false, ...})'\n    metadata:\n      cwe: [\"CWE-295\"]\n      asvs: [\"V14.1\"]\n      tags: [\"security\", \"tls\", \"misconfiguration\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-003",
      "name": "RAPTOR 原始规则 c/crlf-protocol-line.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/c/crlf-protocol-line.yaml",
          "content": "# raptor: confirm-only\n# (silence from this rule never refutes: it adjudicates a sub-shape\n# narrower than the dispatched class — see run_semgrep_sweep's\n# confirm-only role handling in core/audit/sweep.py.)\nrules:\n  # CWE-93: CRLF residual on a protocol line — a single bare variable\n  # formatted into a line-oriented protocol command (SMTP/IMAP/NNTP/\n  # FTP/HTTP lines) without an intervening CR/LF strip/reject. The\n  # anchor is the FORMAT LITERAL: exactly one conversion, a string\n  # one (%s, flags/width/precision allowed), with a trailing literal\n  # \"\\r\\n\" — a protocol-line template; embedded CR/LF in the value\n  # terminates the command and injects attacker-chosen commands.\n  #\n  # Anchor trade-offs (both directions, at the check site):\n  #   - Single-conversion templates only (\"USER %s\\r\\n\" but not\n  #     \"%d %s\\r\\n\"): semgrep cannot bind an argument to its\n  #     conversion position, so a multi-arg pattern would attribute\n  #     the match to WHATEVER bare argument it finds (an int status\n  #     code next to an escaped string). Multi-conversion protocol\n  #     lines are a documented miss (FN); attributing the wrong\n  #     argument would confirm through correct escaping (FP) — the\n  #     single-conversion anchor stays. This also drops \"%.*s\" (its\n  #     width is a second argument).\n  #   - The argument must be a bare identifier / member / indexed\n  #     expression (no calls, no literals, no arithmetic/ternary/\n  #     comma forms): a call result may be an escaper, a literal is\n  #     not variable data, and a compound expression cannot be\n  #     tracked by the strip/reject exclusions below.\n  #\n  # Guard exclusions are polarity-aware. The strpbrk idiom is\n  # discriminated by shape:\n  #   - reject-then-emit (`if (strpbrk(v, ...)) return/goto; ...`)\n  #     and emit-inside-negated-detect (`if (!strpbrk(v, ...)) {...}`)\n  #     are CORRECT and silence the rule;\n  #   - emit-INSIDE-the-detect-branch (`if (strpbrk(v, ...)) {...}`)\n  #     is the vulnerable inverse and still FIRES — a polarity-blind\n  #     exclusion here would silence exactly the bug the class names.\n  # Char-literal CR/LF handling (strchr rejects, manual strip loops:\n  # any `if` mentioning a '\\r' or '\\n' character literal anywhere in\n  # the function) silences REGARDLESS of polarity — the literal forms\n  # are too varied to discriminate honestly, so they trade FN for\n  # zero FP (confirm-only direction).\n  # Remaining exclusions, all FN-direction by design:\n  #   - $V reassigned from ANY call before the sink (after a\n  #     rebinding the rule cannot honestly claim unmodified variable\n  #     data reaches the line; deliberately not name-anchored);\n  #   - a preceding single-argument statement call on $V (the\n  #     in-place sanitizer idiom, `sanitize(v);` — multi-argument\n  #     in-place sanitizers are a documented miss).\n  #\n  # Known FP mode: a wrapper whose caller sanitized (the rule sees\n  # one function). Bounded by dispatch context — this rule runs only\n  # when a CWE-93/CRLF hypothesis names the file/function; it is not\n  # a blanket scanner. Windows-style \"%s\\r\\n\" log lines share the\n  # template shape, bounded the same way.\n  # Known FN modes (documented misses — silence keeps the class dark,\n  # never clean): PROJECT PRINTF-WRAPPERS — the dominant real-world\n  # miss: mature codebases emit protocol lines through their own\n  # format wrappers (curl_maprintf / curlx_dyn_addf /\n  # apr_brigade_printf / BIO_printf-class), which the libc\n  # sprintf/snprintf/fprintf/dprintf anchor never sees; extending the\n  # sink set per target from learned vocabulary is a follow-up, and\n  # hardcoding project API names here is against doctrine. Also:\n  # strcat/multi-call line assembly; adjacent string literal\n  # concatenation (\"USER \" \"%s\\r\\n\" fails the single-literal\n  # template anchor); multi-conversion templates and \"%.*s\"; %ls wide\n  # conversions; guards phrased through helper predicates the\n  # exclusions cannot bind to $V.\n  - id: raptor.c.crlf-protocol-line.format\n    languages: [c, cpp]\n    severity: MEDIUM\n    message: >\n      A bare variable is formatted into a protocol line (format\n      literal ends with \"\\r\\n\") with no CR/LF strip or reject between\n      the variable's last binding and the emit. Embedded \"\\r\\n\" in\n      the value terminates the current protocol command and injects\n      attacker-chosen commands into the stream. Strip or reject CR\n      and LF from the value before formatting it into the line.\n    patterns:\n      - pattern-either:\n          - pattern: sprintf($BUF, $FMT, $V)\n          - pattern: snprintf($BUF, $N, $FMT, $V)\n          - pattern: fprintf($STREAM, $FMT, $V)\n          - pattern: dprintf($FD, $FMT, $V)\n      # Protocol-line template: exactly one conversion, a %s one\n      # (flags/width/precision allowed), trailing literal CRLF. The\n      # matched text includes the literal's quotes.\n      - metavariable-regex:\n          metavariable: $FMT\n          regex: ^\"[^%]*%[-0-9.*]*s[^%]*\\\\r\\\\n\"$\n      # Bare identifier / member / indexed expression only.\n      - metavariable-regex:\n          metavariable: $V\n          regex: ^[A-Za-z_][A-Za-z0-9_]*((\\.|->)[A-Za-z_][A-Za-z0-9_]*|\\[[A-Za-z0-9_]+\\])*$\n      # Rebinding of the same variable from any call.\n      - pattern-not-inside: |\n          $V = $TRANSFORM(...);\n          ...\n      # In-place sanitizer idiom (single-argument statement call).\n      - pattern-not-inside: |\n          $SAN($V);\n          ...\n      # strpbrk reject-then-emit (return/goto bodies, braced or not).\n      - pattern-not-inside: |\n          if (strpbrk($V, $C)) return ...;\n          ...\n      - pattern-not-inside: |\n          if (strpbrk($V, $C)) { return ...; }\n          ...\n      - pattern-not-inside: |\n          if (strpbrk($V, $C)) goto $L;\n          ...\n      - pattern-not-inside: |\n          if (strpbrk($V, $C)) { goto $L; }\n          ...\n      # strpbrk emit-inside-negated-detect. (The positive-polarity\n      # inverse — emit inside the detect branch — deliberately has NO\n      # exclusion: that shape is the vulnerability.)\n      - pattern-not-inside: |\n          if (!strpbrk($V, $C)) { ... }\n      # Char-literal CR/LF handling anywhere in the function (strchr\n      # rejects, manual strip loops) — any polarity, FN over FP.\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\\r' ...>) $S;\n            ...\n          }\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\\r' ...>) { ... }\n            ...\n          }\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\\n' ...>) $S;\n            ...\n          }\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\\n' ...>) { ... }\n            ...\n          }\n    metadata:\n      cwe: [\"CWE-93\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-004",
      "name": "RAPTOR 原始规则 c/quoted-string-escape.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/c/quoted-string-escape.yaml",
          "content": "# raptor: confirm-only\n# (silence from this rule never refutes: it adjudicates a sub-shape\n# narrower than the dispatched class — see run_semgrep_sweep's\n# confirm-only role handling in core/audit/sweep.py.)\nrules:\n  # CWE-116: quoted-string escape residual — a character escaper that\n  # escapes one of {double-quote, backslash} but not the other while\n  # building a quoted string. Escaping only the quote lets an input\n  # backslash neutralize the escaper's own backslash (\\\" survives as a\n  # literal-backslash-then-closing-quote); escaping only the backslash\n  # lets a raw quote close the string. Either residual hands the\n  # attacker the quote boundary.\n  #\n  # The context anchor is the ESCAPE EMIT: the branch body must write\n  # a literal '\\\\' THROUGH a pointer or into an index (`*p = '\\\\'`,\n  # `buf[i++] = '\\\\'`) — an output store. A tokenizer that merely\n  # tests == '\"', or a state machine that saves '\\\\' into a plain\n  # variable as a marker, never output-stores a literal backslash, so\n  # neither can fire. Trade-off: an escaper that emits via a helper\n  # call or a plain-variable staging buffer is missed (FN); anchoring\n  # on any '\\\\' assignment would fire on state-marker stores (FP) —\n  # the output-store anchor stays.\n  #\n  # The character tests match the LITERAL anywhere in the if\n  # condition (`c == '\"'`, Yoda `'\"' == c`, ||-combined forms), and\n  # the completeness test is function-scoped and literal-based too:\n  # any `if` mentioning the missing character's literal anywhere in\n  # the same function silences the rule (FN-direction — a comparison\n  # does not prove correct handling, but claiming a residual while\n  # the function visibly branches on the other character would be\n  # dishonest). ||-combined conditions, else-if chains, Yoda tests,\n  # and braceless branches therefore all read as complete.\n  #\n  # Known FN modes (documented, confirm-only — CWE-116 stays out of\n  # the tool_coverage silence→clean map so misses classify dark):\n  #   - switch/case escapers: semgrep's C grammar does not bind\n  #     case-label patterns for this shape (verified against semgrep\n  #     1.172.0) — route those through the check-encoding-residual\n  #     SMT verb with LLM-extracted transfer semantics;\n  #   - table-driven escapers (lookup arrays): same route;\n  #   - escapers split across helper functions, or emitting through\n  #     append helpers instead of direct stores.\n  - id: raptor.c.quoted-string-escape.quote-not-backslash\n    languages: [c, cpp]\n    severity: MEDIUM\n    message: >\n      This escaper writes a backslash escape for the double-quote but\n      the enclosing function never tests for the backslash itself. An\n      input backslash passes through unescaped and can neutralize the\n      escape prefix of a following quote, handing the attacker the\n      quoted-string boundary. Escape the backslash as well.\n    patterns:\n      - pattern-either:\n          - pattern: |\n              if (<... '\"' ...>) { ... *$P = '\\\\'; ... }\n          - pattern: |\n              if (<... '\"' ...>) { ... $A[$I] = '\\\\'; ... }\n          - pattern: |\n              if (<... '\"' ...>) *$P = '\\\\';\n          - pattern: |\n              if (<... '\"' ...>) $A[$I] = '\\\\';\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\\\\' ...>) { ... }\n            ...\n          }\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\\\\' ...>) $S;\n            ...\n          }\n    metadata:\n      cwe: [\"CWE-116\"]\n  - id: raptor.c.quoted-string-escape.backslash-not-quote\n    languages: [c, cpp]\n    severity: MEDIUM\n    message: >\n      This escaper writes a backslash escape for the backslash but the\n      enclosing function never tests for the double-quote. A raw quote\n      in the input closes the quoted string early, handing the\n      attacker the string boundary. Escape the double-quote as well.\n    patterns:\n      - pattern-either:\n          - pattern: |\n              if (<... '\\\\' ...>) { ... *$P = '\\\\'; ... }\n          - pattern: |\n              if (<... '\\\\' ...>) { ... $A[$I] = '\\\\'; ... }\n          - pattern: |\n              if (<... '\\\\' ...>) *$P = '\\\\';\n          - pattern: |\n              if (<... '\\\\' ...>) $A[$I] = '\\\\';\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\"' ...>) { ... }\n            ...\n          }\n      - pattern-not-inside: |\n          $RT $FN(...) {\n            ...\n            if (<... '\"' ...>) $S;\n            ...\n          }\n    metadata:\n      cwe: [\"CWE-116\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-005",
      "name": "RAPTOR 原始规则 crypto/insecure-iv-or-nonce.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/insecure-iv-or-nonce.yaml",
          "content": "rules:\n  - id: raptor.crypto.iv.literal.java\n    message: IV or nonce is a constant literal. Use SecureRandom or library-generated nonces. Verify randomness.\n    languages: [java, kotlin]\n    severity: HIGH\n    pattern-either:\n      - pattern: new IvParameterSpec(new byte[] { ... })\n      - pattern: new GCMParameterSpec($T, new byte[] { ... })\n      - pattern: new IvParameterSpec(\"...\".getBytes())\n      - pattern: new IvParameterSpec(\"...\".getBytes(...))\n      - pattern: new GCMParameterSpec($T, \"...\".getBytes())\n      - pattern: new GCMParameterSpec($T, \"...\".getBytes(...))\n    metadata:\n      cwe: [\"CWE-330\"]\n      asvs: [\"V7.3\"]\n\n  # cryptography.hazmat AEAD classes: inline `AESGCM(k).encrypt(b\"...\", ...)`\n  # and the two-step variable-instance shape `a = AESGCM(k)` ... `a.encrypt(b\"...\", ...)`.\n  - id: raptor.crypto.nonce.literal.python\n    message: Nonce is a constant literal. Use os.urandom() or library defaults. Verify randomness.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          - pattern: $AEAD($K).encrypt($NONCE, ...)\n          - pattern: |\n              $A = $AEAD($K)\n              ...\n              $A.encrypt($NONCE, ...)\n      - metavariable-regex:\n          metavariable: $AEAD\n          regex: \"^(AESGCM|ChaCha20Poly1305|AESCCM|AESOCB3)$\"\n      - metavariable-pattern:\n          metavariable: $NONCE\n          patterns:\n            - pattern-either:\n                - pattern: b\"...\"\n                - pattern: b\"...\" * $N\n    metadata:\n      cwe: [\"CWE-330\"]\n      asvs: [\"V7.3\"]\n\n  # pycryptodome: literal nonce / IV passed to AES.new\n  - id: raptor.crypto.iv.literal.pycryptodome.python\n    message: IV or nonce is a constant literal. Use get_random_bytes() or let the library generate it. Verify randomness.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          - pattern: AES.new($K, AES.MODE_GCM, ..., nonce=$IV, ...)\n          - pattern: AES.new($K, AES.MODE_CCM, ..., nonce=$IV, ...)\n          - pattern: AES.new($K, AES.MODE_CTR, ..., nonce=$IV, ...)\n          - pattern: AES.new($K, AES.MODE_CBC, $IV, ...)\n          - pattern: AES.new($K, AES.MODE_CFB, $IV, ...)\n          - pattern: AES.new($K, AES.MODE_OFB, $IV, ...)\n          - pattern: AES.new($K, $MODE, ..., iv=$IV, ...)\n      - metavariable-pattern:\n          metavariable: $IV\n          patterns:\n            - pattern-either:\n                - pattern: b\"...\"\n                - pattern: b\"...\" * $N\n    metadata:\n      cwe: [\"CWE-330\"]\n      asvs: [\"V7.3\"]\n\n  # cryptography.hazmat block modes: literal IV / nonce in the mode constructor\n  - id: raptor.crypto.iv.literal.hazmat-modes.python\n    message: IV or nonce is a constant literal. Use os.urandom() for the mode IV/nonce. Verify randomness.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern: modes.$MODE($IV, ...)\n      - metavariable-regex:\n          metavariable: $MODE\n          regex: \"^(CBC|GCM|CTR|CFB|CFB8|OFB|XTS)$\"\n      - metavariable-pattern:\n          metavariable: $IV\n          patterns:\n            - pattern-either:\n                - pattern: b\"...\"\n                - pattern: b\"...\" * $N\n    metadata:\n      cwe: [\"CWE-330\"]\n      asvs: [\"V7.3\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-006",
      "name": "RAPTOR 原始规则 crypto/insecure-password-hash.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/insecure-password-hash.yaml",
          "content": "rules:\n  # V11.4.2: Passwords must be stored using a computationally intensive KDF\n  # (bcrypt, argon2, scrypt, PBKDF2). General-purpose hash functions are not\n  # suitable for password storage even with a salt.\n  # Note: these rules use variable-name heuristics and will have false positives.\n\n  - id: raptor.crypto.password.weak-hash.python\n    message: >\n      Hashing a password with a general-purpose hash function is insecure even\n      with a salt. Use bcrypt, argon2-cffi, or hashlib.scrypt / pbkdf2_hmac instead.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern: hashlib.$ALGO($VAR, ...)\n      - metavariable-regex:\n          metavariable: $ALGO\n          regex: \"^(md5|sha1|sha224|sha256|sha384|sha512|blake2b|blake2s)$\"\n      - metavariable-regex:\n          metavariable: $VAR\n          regex: \"(?i).*(password|passwd|pwd|passphrase|secret|credential)(?![_.]?(?:policy|reset|type|config|length|url|question|validator|rule|field|name|format|error|message|manager|handler|form|check|strength|history|log|count|prompt|mask|requirement|hint|expiry|enabled|display|header|title|placeholder|help|description|option|setting)).*\"\n    metadata:\n      cwe: [\"CWE-916\"]\n      asvs: [\"V11.4.2\"]\n\n  - id: raptor.crypto.password.weak-hash.java\n    message: >\n      Hashing a password with MessageDigest is insecure. Use BCrypt, SCrypt,\n      or Argon2 via a library such as Spring Security or Bouncy Castle.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: MessageDigest.getInstance($ALG).digest($VAR.getBytes(...))\n      - metavariable-regex:\n          metavariable: $VAR\n          regex: \"(?i).*(password|passwd|pwd|passphrase|secret|credential)(?![_.]?(?:policy|reset|type|config|length|url|question|validator|rule|field|name|format|error|message|manager|handler|form|check|strength|history|log|count|prompt|mask|requirement|hint|expiry|enabled|display|header|title|placeholder|help|description|option|setting)).*\"\n    metadata:\n      cwe: [\"CWE-916\"]\n      asvs: [\"V11.4.2\"]\n\n  - id: raptor.crypto.password.weak-hash.js\n    message: >\n      Hashing a password with a general-purpose hash is insecure. Use bcrypt,\n      argon2, or scrypt instead.\n    languages: [javascript, typescript]\n    severity: HIGH\n    patterns:\n      - pattern: crypto.createHash($ALGO).update($VAR)\n      - metavariable-regex:\n          metavariable: $VAR\n          regex: \"(?i).*(password|passwd|pwd|passphrase|secret|credential)(?![_.]?(?:policy|reset|type|config|length|url|question|validator|rule|field|name|format|error|message|manager|handler|form|check|strength|history|log|count|prompt|mask|requirement|hint|expiry|enabled|display|header|title|placeholder|help|description|option|setting)).*\"\n    metadata:\n      cwe: [\"CWE-916\"]\n      asvs: [\"V11.4.2\"]\n\n  - id: raptor.crypto.password.weak-hash.php\n    message: >\n      md5() and sha1() must not be used for password storage. Use password_hash()\n      with PASSWORD_BCRYPT or PASSWORD_ARGON2ID instead.\n    languages: [php]\n    severity: HIGH\n    pattern-either:\n      - patterns:\n          - pattern: md5($VAR)\n          - metavariable-regex:\n              metavariable: $VAR\n              regex: \"(?i).*(password|passwd|pwd|passphrase|secret|credential)(?![_.]?(?:policy|reset|type|config|length|url|question|validator|rule|field|name|format|error|message|manager|handler|form|check|strength|history|log|count|prompt|mask|requirement|hint|expiry|enabled|display|header|title|placeholder|help|description|option|setting)).*\"\n      - patterns:\n          - pattern: sha1($VAR)\n          - metavariable-regex:\n              metavariable: $VAR\n              regex: \"(?i).*(password|passwd|pwd|passphrase|secret|credential)(?![_.]?(?:policy|reset|type|config|length|url|question|validator|rule|field|name|format|error|message|manager|handler|form|check|strength|history|log|count|prompt|mask|requirement|hint|expiry|enabled|display|header|title|placeholder|help|description|option|setting)).*\"\n    metadata:\n      cwe: [\"CWE-916\"]\n      asvs: [\"V11.4.2\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-007",
      "name": "RAPTOR 原始规则 crypto/pkcs1v15-padding.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/pkcs1v15-padding.yaml",
          "content": "rules:\n  # V11.3.1: PKCS#1 v1.5 padding is vulnerable to Bleichenbacher oracle attacks.\n  # Use OAEP for encryption and PSS for signatures.\n\n  - id: raptor.crypto.rsa.pkcs1v15-encrypt.java\n    message: >\n      RSA with PKCS#1 v1.5 padding is vulnerable to Bleichenbacher oracle attacks.\n      Use RSA/ECB/OAEPWithSHA-256AndMGF1Padding instead.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      # (?i): JCA transformation lookup is case-insensitive per spec.\n      # Bare \"RSA\" defaults to PKCS1 padding on every mainstream\n      # provider, hence the optional suffix.\n      - pattern: Cipher.getInstance($ALGO, ...)\n      - metavariable-regex:\n          metavariable: $ALGO\n          regex: (?i)^\"rsa(/ecb/pkcs1padding)?\"$\n    metadata:\n      cwe: [\"CWE-780\", \"CWE-327\"]\n      asvs: [\"V11.3.1\"]\n      references: [\"https://link.springer.com/chapter/10.1007/BFb0055716\"]\n\n  - id: raptor.crypto.rsa.pkcs1v15-encrypt.python\n    message: >\n      PKCS1_v1_5 encryption is vulnerable to Bleichenbacher oracle attacks.\n      Use Crypto.Cipher.PKCS1_OAEP instead.\n    languages: [python]\n    severity: HIGH\n    pattern-either:\n      - pattern: Crypto.Cipher.PKCS1_v1_5.new(...)\n      - patterns:\n        - pattern: PKCS1_v1_5.new(...)\n        - pattern-not-inside: |\n            from Crypto.Signature import PKCS1_v1_5\n            ...\n        - pattern-not-inside: |\n            import Crypto.Signature.PKCS1_v1_5\n            ...\n    metadata:\n      cwe: [\"CWE-780\", \"CWE-327\"]\n      asvs: [\"V11.3.1\"]\n\n  - id: raptor.crypto.rsa.pkcs1v15.go\n    message: >\n      PKCS#1 v1.5 RSA encryption is vulnerable to Bleichenbacher padding-oracle\n      attacks. Use rsa.EncryptOAEP / rsa.DecryptOAEP instead. (Signatures are a\n      different case — see raptor.crypto.rsa.pkcs1v15-sign.go.)\n    languages: [go]\n    severity: HIGH\n    pattern-either:\n      - pattern: rsa.DecryptPKCS1v15(...)\n      - pattern: rsa.DecryptPKCS1v15SessionKey(...)\n      - pattern: rsa.EncryptPKCS1v15(...)\n    metadata:\n      cwe: [\"CWE-780\", \"CWE-327\"]\n      asvs: [\"V11.3.1\"]\n\n  # PKCS#1 v1.5 *signing* is not Bleichenbacher-vulnerable (that attack needs\n  # a decryption padding oracle); it is merely a legacy scheme. Prefer PSS for\n  # new signature generation. Verification is deliberately not flagged:\n  # verifying legacy v1.5 signatures is unavoidable for interoperability.\n  - id: raptor.crypto.rsa.pkcs1v15-sign.go\n    message: >\n      PKCS#1 v1.5 signature generation is a legacy scheme. Prefer rsa.SignPSS\n      for new signatures; keep v1.5 only where interoperability requires it.\n    languages: [go]\n    severity: MEDIUM\n    pattern: rsa.SignPKCS1v15(...)\n    metadata:\n      cwe: [\"CWE-327\"]\n      asvs: [\"V11.3.1\"]\n\n  - id: raptor.crypto.rsa.pkcs1v15.node\n    message: >\n      RSA_PKCS1_PADDING is vulnerable to Bleichenbacher oracle attacks.\n      Use RSA_PKCS1_OAEP_PADDING instead.\n    languages: [javascript, typescript]\n    severity: HIGH\n    pattern-either:\n      - pattern: \"crypto.privateDecrypt({padding: crypto.constants.RSA_PKCS1_PADDING, ...}, ...)\"\n      - pattern: \"crypto.publicEncrypt({padding: crypto.constants.RSA_PKCS1_PADDING, ...}, ...)\"\n    metadata:\n      cwe: [\"CWE-780\", \"CWE-327\"]\n      asvs: [\"V11.3.1\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-008",
      "name": "RAPTOR 原始规则 crypto/reused-nonce-heuristic.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/reused-nonce-heuristic.yaml",
          "content": "rules:\n  # Actual reuse heuristics. Literal / constant nonces are reported by\n  # insecure-iv-or-nonce.yaml; the rules here fire only on evidence of the\n  # SAME nonce value feeding more than one encryption, which is the\n  # catastrophic case for AES-GCM / ChaCha20-Poly1305 (key stream and auth\n  # key recovery).\n\n  - id: raptor.crypto.nonce.reuse.spec.java\n    message: >\n      Potential nonce reuse. The same GCMParameterSpec instance initialises two\n      Cipher operations, so both use the same IV under (typically) the same key.\n      Generate a fresh nonce per encryption.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: |\n          $S = new GCMParameterSpec(...);\n          ...\n          $C1.init($M1, $K1, $S);\n          ...\n          $C2.init($M2, $K2, $S);\n      - pattern-not: |\n          $S = new GCMParameterSpec(...);\n          ...\n          $C1.init($M1, $K1, $S);\n          ...\n          $S = ...;\n          ...\n          $C2.init($M2, $K2, $S);\n    metadata:\n      cwe: [\"CWE-323\", \"CWE-330\"]\n      asvs: [\"V7.3\"]\n\n  - id: raptor.crypto.nonce.reuse.two-calls.python\n    message: >\n      Potential nonce reuse. The same nonce variable is passed to two encrypt\n      calls on the same AEAD object without being reassigned in between.\n      Generate a fresh nonce per encryption.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern: |\n          $C.encrypt($NONCE, ...)\n          ...\n          $C.encrypt($NONCE, ...)\n      - pattern-not: |\n          $C.encrypt($NONCE, ...)\n          ...\n          $NONCE = ...\n          ...\n          $C.encrypt($NONCE, ...)\n      - metavariable-regex:\n          metavariable: $NONCE\n          regex: \"^[A-Za-z_][A-Za-z0-9_.]*$\"\n    metadata:\n      cwe: [\"CWE-323\", \"CWE-330\"]\n      asvs: [\"V7.3\"]\n\n  - id: raptor.crypto.nonce.reuse.loop.python\n    message: >\n      Potential nonce reuse. A nonce assigned once outside a loop is used for\n      an encrypt call inside the loop, so every iteration encrypts under the\n      same nonce. Generate a fresh nonce inside the loop.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern: |\n          $NONCE = ...\n          ...\n          for $X in $ITER:\n              ...\n              $C.encrypt($NONCE, ...)\n      - pattern-not: |\n          $NONCE = ...\n          ...\n          for $X in $ITER:\n              ...\n              $NONCE = ...\n              ...\n              $C.encrypt($NONCE, ...)\n      - metavariable-regex:\n          metavariable: $NONCE\n          regex: \"^[A-Za-z_][A-Za-z0-9_.]*$\"\n    metadata:\n      cwe: [\"CWE-323\", \"CWE-330\"]\n      asvs: [\"V7.3\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-009",
      "name": "RAPTOR 原始规则 crypto/weak-asym-keysize.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-asym-keysize.yaml",
          "content": "rules:\n  # Known gaps (not cheaply expressible as literal-keysize patterns, left for a\n  # dedicated pass):\n  #   * EC: weak curves are named (secp160r1, prime192v1, ...) not sized —\n  #     needs a curve-name allowlist/blocklist rule per library.\n  #   * DH/DHE: parameter strength usually comes from loaded parameter files\n  #     or library defaults rather than an inline integer.\n\n  - id: raptor.crypto.rsa.small-key.java\n    message: RSA key size too small. Use >= 2048 bits. Verify by regenerating keys and updating tests.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: |\n          KeyPairGenerator $KPG = KeyPairGenerator.getInstance(\"RSA\", ...);\n          ...\n          $KPG.initialize($N, ...);\n      - metavariable-comparison:\n          metavariable: $N\n          comparison: $N < 2048\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.dsa.small-key.java\n    message: DSA key size too small. Use >= 2048 bits (or prefer EdDSA/ECDSA). Verify by regenerating keys.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: |\n          KeyPairGenerator $KPG = KeyPairGenerator.getInstance(\"DSA\", ...);\n          ...\n          $KPG.initialize($N, ...);\n      - metavariable-comparison:\n          metavariable: $N\n          comparison: $N < 2048\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.rsa.small-key.python\n    message: RSA key size too small. Use >= 2048 bits. Verify with known-answer tests.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          # cryptography.hazmat\n          - pattern: rsa.generate_private_key(public_exponent=$E, key_size=$N, ...)\n          # pycryptodome / pycrypto\n          - pattern: Crypto.PublicKey.RSA.generate($N, ...)\n      - metavariable-comparison:\n          metavariable: $N\n          comparison: $N < 2048\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.dsa.small-key.python\n    message: DSA key size too small. Use >= 2048 bits (or prefer EdDSA/ECDSA). Verify with known-answer tests.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          # cryptography.hazmat\n          - pattern: dsa.generate_private_key(key_size=$N, ...)\n          # pycryptodome / pycrypto\n          - pattern: Crypto.PublicKey.DSA.generate($N, ...)\n      - metavariable-comparison:\n          metavariable: $N\n          comparison: $N < 2048\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.rsa.small-key.go\n    message: RSA key size too small. Use >= 2048 bits. Verify with known-answer tests.\n    languages: [go]\n    severity: HIGH\n    patterns:\n      - pattern: rsa.GenerateKey($R, $N)\n      - metavariable-comparison:\n          metavariable: $N\n          comparison: $N < 2048\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-010",
      "name": "RAPTOR 原始规则 crypto/weak-block-modes.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-block-modes.yaml",
          "content": "rules:\n  - id: raptor.crypto.aes.ecb.java\n    message: AES-ECB is insecure. Use AEAD modes like GCM. Verify migration plan.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: Cipher.getInstance($ALGO, ...)\n      - metavariable-regex:\n          metavariable: $ALGO\n          regex: \"\\\"AES/ECB/.*\\\"\"\n    metadata:\n      cwe: [\"CWE-327\"]\n      asvs: [\"V3.11\"]\n\n  # Bare \"AES\" is its own rule so the message can explain the trap: the JCE\n  # default transformation for \"AES\" is AES/ECB/PKCS5Padding.\n  - id: raptor.crypto.aes.default-ecb.java\n    message: >\n      Cipher.getInstance(\"AES\") uses the JCE default transformation\n      AES/ECB/PKCS5Padding — this is ECB. Spell out an AEAD transformation\n      such as \"AES/GCM/NoPadding\" instead.\n    languages: [java, kotlin]\n    severity: HIGH\n    pattern: Cipher.getInstance(\"AES\", ...)\n    metadata:\n      cwe: [\"CWE-327\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.aes.ecb.python\n    message: AES-ECB is insecure. Use AEAD modes like GCM. Verify migration plan.\n    languages: [python]\n    severity: HIGH\n    pattern-either:\n      - pattern: Crypto.Cipher.AES.new($K, Crypto.Cipher.AES.MODE_ECB, ...)\n      - pattern: modes.ECB()\n    metadata:\n      cwe: [\"CWE-327\"]\n      asvs: [\"V3.11\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-011",
      "name": "RAPTOR 原始规则 crypto/weak-hash-extended.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-hash-extended.yaml",
          "content": "rules:\n  # V11.4.1 extended: weak hash detection for languages not covered in weak-hash.yaml\n  # (Java, Python, and Go are handled there; JS, Ruby, PHP, Rust, and C are here)\n\n  - id: raptor.crypto.weak-hash.js\n    message: Weak hash function. Use SHA-256 or better for cryptographic purposes.\n    languages: [javascript, typescript]\n    severity: HIGH\n    patterns:\n      - pattern: crypto.createHash($ALG)\n      - metavariable-regex:\n          metavariable: $ALG\n          # node accepts OpenSSL digest names case-insensitively\n          regex: (?i)^[\"'](md5|sha-?1)[\"']$\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V11.4.1\"]\n\n  - id: raptor.crypto.weak-hash.ruby\n    message: Weak hash function. Use SHA-256 or better for cryptographic purposes.\n    languages: [ruby]\n    severity: HIGH\n    pattern-either:\n      - pattern: Digest::MD5.hexdigest(...)\n      - pattern: Digest::MD5.digest(...)\n      - pattern: Digest::SHA1.hexdigest(...)\n      - pattern: Digest::SHA1.digest(...)\n      # (?i): OpenSSL digest name lookup is case-insensitive, so\n      # OpenSSL::Digest.new(\"md5\") is a fully working weak-hash use.\n      # (The Digest::MD5 constants above stay exact — Ruby constant\n      # names ARE case-sensitive.)\n      - patterns:\n          - pattern: OpenSSL::Digest.new($ALG, ...)\n          - metavariable-regex:\n              metavariable: $ALG\n              regex: (?i)^[\"'](md5|sha-?1)[\"']$\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V11.4.1\"]\n\n  # md5()/sha1() in PHP are pervasively used for non-security purposes\n  # (cache keys, ETags, dedupe), so an unconditional HIGH is a noise cannon.\n  # The genuinely HIGH case — hashing a password — is covered with context by\n  # raptor.crypto.password.weak-hash.php in insecure-password-hash.yaml.\n  - id: raptor.crypto.weak-hash.php\n    message: >\n      Weak hash function. Use hash('sha256', ...) or better for cryptographic\n      purposes. If this hashes a password, see the HIGH finding from\n      raptor.crypto.password.weak-hash.php.\n    languages: [php]\n    severity: MEDIUM\n    pattern-either:\n      - pattern: md5(...)\n      - pattern: sha1(...)\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V11.4.1\"]\n\n  - id: raptor.crypto.weak-hash.rust\n    message: Weak hash function. Use SHA-256 or better for cryptographic purposes.\n    languages: [rust]\n    severity: HIGH\n    pattern-either:\n      - pattern: Md5::new()\n      - pattern: Sha1::new()\n      # one-shot digest API of the RustCrypto `digest` trait\n      - pattern: Md5::digest(...)\n      - pattern: Sha1::digest(...)\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V11.4.1\"]\n\n  - id: raptor.crypto.weak-hash.c\n    message: Weak hash function. Avoid MD5 and SHA-1 for security purposes. Use SHA-256 or better.\n    languages: [c, cpp]\n    severity: HIGH\n    pattern-either:\n      - pattern: MD5_Init(...)\n      - pattern: MD5(...)\n      - pattern: SHA1_Init(...)\n      - pattern: SHA1(...)\n      # OpenSSL EVP surface: EVP_md5()/EVP_sha1() only exist to select the\n      # digest for EVP_DigestInit-family / HMAC setup calls\n      - pattern: EVP_md5()\n      - pattern: EVP_sha1()\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V11.4.1\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-012",
      "name": "RAPTOR 原始规则 crypto/weak-hash.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-hash.yaml",
          "content": "rules:\n  - id: raptor.crypto.weak-hash.java\n    message: Weak hash function detected. Use SHA-256 or better. Verify migration and test vectors.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      # MD2 (RFC 6149) and MD4 (RFC 6150) are strictly weaker than the\n      # MD5 already listed; MD2 is a standard JCA algorithm name and\n      # MD4 is provider-registered (e.g. BouncyCastle). Set kept\n      # consistent with the config-resolved channel's weak-hash set.\n      # (?i): the JCA getInstance lookup is case-insensitive per spec,\n      # so getInstance(\"md5\") is a fully working weak-hash use —\n      # mirroring the python arm's hashlib.new discipline.\n      - pattern: MessageDigest.getInstance($ALG, ...)\n      - metavariable-regex:\n          metavariable: $ALG\n          regex: '(?i)^\"(md2|md4|md5|sha-?1)\"$'\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V3.9\"]\n\n  - id: raptor.crypto.weak-hash.python\n    message: Weak hash function detected. Use SHA-256 or better. Verify migration and test vectors.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          - pattern: hashlib.md5(...)\n          - pattern: hashlib.sha1(...)\n          # hashlib.new with a weak algorithm name (case-insensitive,\n          # matching hashlib's own name handling)\n          - patterns:\n              - pattern: hashlib.new($ALG, ...)\n              - metavariable-regex:\n                  metavariable: $ALG\n                  regex: '(?i)^[\"''](md2|md4|md5|sha-?1)[\"'']$'\n      # usedforsecurity=False is the documented non-cryptographic\n      # escape hatch (checksums, caching keys) — not a weak-hash use.\n      - pattern-not: hashlib.md5(..., usedforsecurity=False, ...)\n      - pattern-not: hashlib.sha1(..., usedforsecurity=False, ...)\n      - pattern-not: hashlib.new(..., usedforsecurity=False, ...)\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V3.9\"]\n\n  - id: raptor.crypto.weak-hash.go\n    message: Weak hash function detected. Use SHA-256 or better. Verify migration and test vectors.\n    languages: [go]\n    severity: HIGH\n    pattern-either:\n      - pattern: md5.New()\n      - pattern: md5.Sum(...)\n      - pattern: sha1.New()\n      - pattern: sha1.Sum(...)\n    metadata:\n      cwe: [\"CWE-328\"]\n      asvs: [\"V3.9\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-013",
      "name": "RAPTOR 原始规则 crypto/weak-kdf-iterations.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-kdf-iterations.yaml",
          "content": "rules:\n  - id: raptor.crypto.pbkdf2.low-iterations.java\n    message: PBKDF2 iterations too low. Set >= 100000. Verify using configuration tests.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: new PBEKeySpec($PW, $SALT, $ITERS, $KEYLEN)\n      - metavariable-comparison:\n          metavariable: $ITERS\n          comparison: $ITERS < 100000\n    metadata:\n      cwe: [\"CWE-916\"]\n      asvs: [\"V2.4\"]\n\n  - id: raptor.crypto.pbkdf2.low-iterations.python\n    message: PBKDF2 iterations too low. Set >= 100000. Verify using configuration tests.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern: hashlib.pbkdf2_hmac($ALG, $PW, $SALT, $ITERS, ...)\n      - metavariable-comparison:\n          metavariable: $ITERS\n          comparison: $ITERS < 100000\n    metadata:\n      cwe: [\"CWE-916\"]\n      asvs: [\"V2.4\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-014",
      "name": "RAPTOR 原始规则 crypto/weak-kdf-keysize.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-kdf-keysize.yaml",
          "content": "rules:\n  - id: raptor.crypto.pbkdf2.small-key.java\n    message: PBKDF2 derived key size too small. Use >= 128 bits. Verify with test vectors.\n    languages: [java, kotlin]\n    severity: MEDIUM\n    patterns:\n      - pattern: new PBEKeySpec($PW, $SALT, $ITERS, $KEYLEN)\n      - metavariable-comparison:\n          metavariable: $KEYLEN\n          comparison: $KEYLEN < 128\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.pbkdf2.small-key.python\n    message: PBKDF2 derived key length too small. Use >= 16 bytes. Verify with test vectors.\n    languages: [python]\n    severity: MEDIUM\n    patterns:\n      - pattern: hashlib.pbkdf2_hmac($ALG, $PW, $SALT, $ITERS, $DKLEN)\n      - metavariable-comparison:\n          metavariable: $DKLEN\n          comparison: $DKLEN < 16\n    metadata:\n      cwe: [\"CWE-326\"]\n      asvs: [\"V3.11\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-015",
      "name": "RAPTOR 原始规则 crypto/weak-prng.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-prng.yaml",
          "content": "rules:\n  # V11.5.1: All security-sensitive random values must use a CSPRNG with >= 128 bits of entropy.\n  #\n  # Severity note: a non-CSPRNG call with no usage context is the same finding\n  # class in every language — the value may be fine for jitter or sampling and\n  # catastrophic for a token. All rules in this file are therefore MEDIUM;\n  # context-aware rules (password/token/key sinks) are where HIGH belongs.\n\n  - id: raptor.crypto.prng.math-random.js\n    message: >\n      Math.random() is not cryptographically secure. Use crypto.getRandomValues()\n      or crypto.randomBytes() for tokens, keys, and secrets.\n    languages: [javascript, typescript]\n    severity: MEDIUM\n    pattern: Math.random()\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n\n  - id: raptor.crypto.prng.random-module.python\n    message: >\n      Python's random module is not cryptographically secure. Use secrets or\n      os.urandom() for tokens, keys, nonces, and passwords.\n    languages: [python]\n    severity: MEDIUM\n    pattern-either:\n      - pattern: random.random()\n      - pattern: random.randint(...)\n      - pattern: random.choice(...)\n      - pattern: random.choices(...)\n      - pattern: random.randbytes(...)\n      - pattern: random.randrange(...)\n      - pattern: random.getrandbits(...)\n      - pattern: random.uniform(...)\n      - pattern: random.shuffle(...)\n      - pattern: random.sample(...)\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n\n  - id: raptor.crypto.prng.java-random.java\n    message: >\n      java.util.Random is not cryptographically secure (and a fixed seed makes\n      the sequence fully predictable). Use java.security.SecureRandom for\n      tokens, keys, and secrets.\n    languages: [java, kotlin]\n    severity: MEDIUM\n    pattern-either:\n      - pattern: new Random()\n      - pattern: new Random($SEED)\n      - pattern: Math.random()\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n\n  - id: raptor.crypto.prng.math-rand.go\n    message: >\n      math/rand is not cryptographically secure. Use crypto/rand for tokens, keys,\n      and security-sensitive values.\n    languages: [go]\n    severity: MEDIUM\n    pattern-either:\n      - pattern: rand.Intn(...)\n      - pattern: rand.Int63n(...)\n      - pattern: rand.Int31()\n      - pattern: rand.Int31n(...)\n      - pattern: rand.Uint32()\n      - pattern: rand.Uint64()\n      - pattern: rand.Perm(...)\n      - pattern: rand.Float64()\n      # zero-arg form is unambiguous: crypto/rand.Int takes (io.Reader, *big.Int)\n      - pattern: rand.Int()\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n\n  # rand.Read exists in BOTH math/rand and crypto/rand with the same shape, so\n  # this rule is anchored on the math/rand import; crypto/rand.Read stays clean.\n  - id: raptor.crypto.prng.math-rand-read.go\n    message: >\n      math/rand.Read fills the buffer from a non-cryptographic PRNG. Use\n      crypto/rand.Read for keys, nonces, tokens, and salts.\n    languages: [go]\n    severity: MEDIUM\n    patterns:\n      - pattern: rand.Read(...)\n      - pattern-inside: |\n          import \"math/rand\"\n          ...\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n\n  - id: raptor.crypto.prng.rand.c\n    message: >\n      rand() is not cryptographically secure. Use getrandom() or read from\n      /dev/urandom for security-sensitive values.\n    languages: [c, cpp]\n    severity: MEDIUM\n    pattern: rand()\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n\n  - id: raptor.crypto.prng.rand.ruby\n    message: >\n      Ruby's rand is not cryptographically secure. Use SecureRandom for tokens,\n      keys, and security-sensitive values.\n    languages: [ruby]\n    severity: MEDIUM\n    pattern-either:\n      - pattern: rand(...)\n      - pattern: Random.rand(...)\n    metadata:\n      cwe: [\"CWE-338\"]\n      asvs: [\"V11.5.1\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-016",
      "name": "RAPTOR 原始规则 crypto/weak-symmetric-cipher.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/crypto/weak-symmetric-cipher.yaml",
          "content": "rules:\n  - id: raptor.crypto.weak.symmetric.java\n    message: Weak symmetric cipher detected. Use AES-GCM or ChaCha20-Poly1305. Verify deprecation plan.\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      # (?i): JCA transformation lookup is case-insensitive per spec.\n      - pattern: Cipher.getInstance($ALGO, ...)\n      - metavariable-regex:\n          metavariable: $ALGO\n          regex: (?i)^\"(des|desede|rc4|arcfour|blowfish)(/[^\"]*)?\"$\n    metadata:\n      cwe: [\"CWE-326\",\"CWE-327\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.weak.symmetric.go\n    message: Weak symmetric cipher detected. Use AES-GCM or ChaCha20-Poly1305. Verify deprecation plan.\n    languages: [go]\n    severity: HIGH\n    pattern-either:\n      - pattern: des.NewCipher(...)\n      - pattern: des.NewTripleDESCipher(...)\n      - pattern: rc4.NewCipher(...)\n    metadata:\n      cwe: [\"CWE-326\",\"CWE-327\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.weak.symmetric.python\n    message: Weak symmetric cipher detected. Use AES-GCM or ChaCha20-Poly1305. Verify deprecation plan.\n    languages: [python]\n    severity: HIGH\n    pattern-either:\n      # pycryptodome\n      - pattern: Crypto.Cipher.DES.new(...)\n      - pattern: Crypto.Cipher.DES3.new(...)\n      - pattern: Crypto.Cipher.ARC4.new(...)\n      - pattern: Crypto.Cipher.ARC2.new(...)\n      - pattern: Crypto.Cipher.Blowfish.new(...)\n      # cryptography.hazmat\n      - pattern: algorithms.TripleDES(...)\n      - pattern: algorithms.ARC4(...)\n      - pattern: algorithms.Blowfish(...)\n    metadata:\n      cwe: [\"CWE-326\",\"CWE-327\"]\n      asvs: [\"V3.11\"]\n\n  - id: raptor.crypto.weak.symmetric.js\n    message: Weak symmetric cipher detected. Use AES-GCM (aes-256-gcm) or ChaCha20-Poly1305. Verify deprecation plan.\n    languages: [javascript, typescript]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          - pattern: crypto.createCipheriv($ALGO, ...)\n          - pattern: crypto.createDecipheriv($ALGO, ...)\n      - metavariable-regex:\n          metavariable: $ALGO\n          # rc4 in any variant, single/triple DES in any variant, and any\n          # algorithm running in ECB mode (case-insensitive).\n          regex: (?i)^[\"'](rc4.*|des.*|.*-ecb)[\"']$\n    metadata:\n      cwe: [\"CWE-326\",\"CWE-327\"]\n      asvs: [\"V3.11\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-017",
      "name": "RAPTOR 原始规则 deserialisation/unsafe-deserialize.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/deserialisation/unsafe-deserialize.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — pattern: always-dangerous deserialisation APIs\n  # pickle/marshal/shelve are unsafe regardless of input source — the mere\n  # presence of these calls on externally-reachable data is a finding.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.python.pickle\n    message: >-\n      pickle.loads/load deserialises arbitrary Python objects. An attacker who\n      controls the input can achieve remote code execution. Use a safe format\n      (JSON, MessagePack) or sign payloads with hmac before unpickling.\n    languages: [python]\n    severity: CRITICAL\n    pattern-either:\n      - pattern: pickle.loads(...)\n      - pattern: pickle.load(...)\n      - pattern: _pickle.loads(...)\n      - pattern: cPickle.loads(...)\n      - pattern: cPickle.load(...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"pickle\", \"rce\"]\n\n  - id: raptor.deserialisation.unsafe.python.marshal\n    message: >-\n      marshal.loads deserialises Python bytecode objects. Untrusted input can\n      achieve code execution. Use a safe format instead.\n    languages: [python]\n    severity: HIGH\n    pattern-either:\n      - pattern: marshal.loads(...)\n      - pattern: marshal.load(...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"marshal\"]\n\n  - id: raptor.deserialisation.unsafe.python.shelve\n    message: >-\n      shelve.open uses pickle internally. An attacker who controls the shelf\n      file can achieve remote code execution.\n    languages: [python]\n    severity: HIGH\n    pattern: shelve.open(...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"shelve\", \"pickle\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — taint: yaml.load with untrusted input (without SafeLoader)\n  # yaml.load(data, Loader=SafeLoader) and yaml.safe_load() are safe.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.python.yaml\n    message: >-\n      yaml.load() without SafeLoader deserialises arbitrary Python objects.\n      Use yaml.safe_load() or pass Loader=SafeLoader explicitly.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          - pattern: flask.request.get_data(...)\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: sys.argv[...]\n          # File reads (common in deserialisation chains). Kept broad\n          # (sockets, uploads, opened files) but in-memory buffers over\n          # string literals are excluded — that data is fully hardcoded.\n          - pattern: open(...).read()\n          - patterns:\n              - pattern: $F.read()\n              - pattern-not: io.StringIO(\"...\").read()\n              - pattern-not: io.BytesIO(\"...\").read()\n              - pattern-not: StringIO(\"...\").read()\n              - pattern-not: BytesIO(\"...\").read()\n    pattern-sinks:\n      - pattern-either:\n          # yaml.load without Loader kwarg — the dangerous form\n          - pattern: yaml.load($X)\n          # yaml.load with FullLoader or UnsafeLoader\n          - pattern: yaml.load($X, Loader=yaml.FullLoader)\n          - pattern: yaml.load($X, Loader=yaml.UnsafeLoader)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"yaml\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — pattern: yaml.load without SafeLoader (no taint needed)\n  # Catches the common mistake even without a traced source.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.python.yaml.noloader\n    message: >-\n      yaml.load() called without an explicit safe Loader. Use\n      yaml.safe_load() or yaml.load(data, Loader=yaml.SafeLoader).\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern: yaml.load(...)\n      # Both spellings of a safe Loader: keyword and positional\n      # (yaml.load(data, SafeLoader) is the documented second\n      # positional parameter). Semgrep resolves the bare imported\n      # name to yaml.SafeLoader, so one pattern per loader covers\n      # qualified and from-imported spellings alike.\n      - pattern-not: yaml.load(..., Loader=yaml.SafeLoader, ...)\n      - pattern-not: yaml.load(..., Loader=yaml.CSafeLoader, ...)\n      - pattern-not: yaml.load(..., Loader=yaml.BaseLoader, ...)\n      - pattern-not: yaml.load($D, yaml.SafeLoader)\n      - pattern-not: yaml.load($D, yaml.CSafeLoader)\n      - pattern-not: yaml.load($D, yaml.BaseLoader)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"yaml\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — pattern: node-serialize (always dangerous)\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.javascript.node-serialize\n    message: >-\n      node-serialize unserialize() deserialises and evaluates JavaScript\n      functions embedded in the input. This is a direct RCE vector. Remove\n      the dependency entirely.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    patterns:\n      # Receiver-anchored: unserialize() is only node-serialize's RCE\n      # vector when the receiver is bound to the node-serialize\n      # module — a project's own codec exposing an unserialize()\n      # method must not mint a CRITICAL verdict by method name alone.\n      - pattern: $NS.unserialize(...)\n      - pattern-either:\n          - pattern-inside: |\n              $NS = require('node-serialize')\n              ...\n          - pattern-inside: |\n              import $NS from 'node-serialize'\n              ...\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"node-serialize\", \"rce\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: serialize-javascript eval pattern\n  # serialize-javascript outputs JS source; eval()ing untrusted input = RCE.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.javascript.serialize-eval\n    message: >-\n      eval() on serialised data can execute arbitrary code. Use JSON.parse()\n      for data interchange instead of eval() on serialised JavaScript.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          - pattern: eval($X)\n          - pattern: new Function($X)\n          - pattern: setTimeout($X, ...)\n          - pattern: setInterval($X, ...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"eval\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: encoding/gob from network sources\n  # gob itself isn't unsafe like pickle (no arbitrary code exec via type\n  # registration), but it can cause panics, resource exhaustion, and logic\n  # bugs when decoding attacker-controlled data. Lower severity than pickle.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.go.gob\n    message: >-\n      encoding/gob decodes attacker-controlled data. gob is not safe for\n      untrusted input — it can cause panics and resource exhaustion. Use a\n      schema-validated format (protobuf, JSON with strict typing) instead.\n    languages: [go]\n    severity: MEDIUM\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.Body\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # network\n          - pattern: $CONN.Read(...)\n          - pattern: os.Getenv(...)\n    pattern-sinks:\n      # Anchored to gob decoders only: a bare $DEC.Decode(...) sink\n      # flagged every json.NewDecoder(r.Body).Decode(&v) handler.\n      - pattern: gob.NewDecoder($R).Decode(...)\n      - patterns:\n          - pattern: $DEC.Decode(...)\n          - pattern-either:\n              - pattern-inside: |\n                  $DEC := gob.NewDecoder(...)\n                  ...\n              - pattern-inside: |\n                  $DEC = gob.NewDecoder(...)\n                  ...\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"gob\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-018",
      "name": "RAPTOR 原始规则 deserialisation/unsafe-java-deserialize.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/deserialisation/unsafe-java-deserialize.yaml",
          "content": "rules:\n  - id: raptor.deserialisation.java.objectinputstream\n    message: Unsafe Java deserialization (ObjectInputStream); prefer safer deserializers and validation.\n    languages: [java, kotlin]\n    severity: HIGH\n    pattern: new ObjectInputStream($STREAM)\n    metadata:\n      cwe: [\"CWE-502\"]\n      asvs: [\"V5.9\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-019",
      "name": "RAPTOR 原始规则 deserialisation/unsafe-java-xml-yaml.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/deserialisation/unsafe-java-xml-yaml.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Java — XMLDecoder deserialises arbitrary beans and executes their\n  # setters/constructors: RCE-equivalent on attacker-controlled input.\n  # Pattern-only, matching the objectinputstream rule's posture: the\n  # presence of the API on a stream is the finding; reachability from\n  # untrusted input is adjudicated downstream.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.java.xmldecoder\n    message: >-\n      java.beans.XMLDecoder deserialises arbitrary objects and invokes their\n      methods during decoding — remote code execution if the stream is\n      attacker-controlled. Parse the XML with a schema-validating parser and\n      construct objects explicitly instead.\n    languages: [java, kotlin]\n    severity: HIGH\n    pattern-either:\n      - pattern: new XMLDecoder($STREAM)\n      - pattern: new XMLDecoder($STREAM, ...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"xmldecoder\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — SnakeYAML with the default constructor instantiates arbitrary\n  # classes from !!com.example.Type tags. new Yaml(new SafeConstructor(...))\n  # is the safe form and is excluded.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.java.snakeyaml-unsafe-constructor\n    message: >-\n      SnakeYAML constructed without SafeConstructor deserialises arbitrary\n      Java types from YAML tags — remote code execution on\n      attacker-controlled documents. Use new Yaml(new SafeConstructor(new\n      LoaderOptions())).\n    languages: [java, kotlin]\n    severity: HIGH\n    patterns:\n      - pattern: new Yaml(...)\n      - pattern-not: new Yaml(new SafeConstructor(...), ...)\n      - pattern-not: new Yaml(new org.yaml.snakeyaml.constructor.SafeConstructor(...), ...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"snakeyaml\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — Jackson polymorphic default typing turns every readValue of\n  # attacker JSON into a gadget-instantiation primitive.\n  # enableDefaultTyping() is the deprecated spelling;\n  # activateDefaultTyping(...) without a restrictive validator is the\n  # modern one. Both are mechanically checkable misconfigurations.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.java.jackson-default-typing\n    message: >-\n      Jackson default typing deserialises attacker-chosen classes\n      (polymorphic type handling on all Object fields) — a well-known RCE\n      gadget surface. Use activateDefaultTyping only with a strict\n      PolymorphicTypeValidator, or model types explicitly.\n    languages: [java, kotlin]\n    severity: HIGH\n    pattern-either:\n      - pattern: $MAPPER.enableDefaultTyping()\n      - pattern: $MAPPER.enableDefaultTyping(...)\n      - pattern: $MAPPER.activateDefaultTyping(LaissezFaireSubTypeValidator.instance, ...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"jackson\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-020",
      "name": "RAPTOR 原始规则 deserialisation/unsafe-python-jsonpickle.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/deserialisation/unsafe-python-jsonpickle.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — jsonpickle.decode reconstructs arbitrary Python objects\n  # (py/object tags name any importable class), giving code execution on\n  # attacker-controlled documents. Pattern-only, matching the pickle rule's\n  # posture: the API on externally-reachable data is the finding.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.python.jsonpickle\n    message: >-\n      jsonpickle.decode reconstructs arbitrary Python objects from\n      attacker-controllable JSON (py/object tags import and instantiate any\n      class). Use plain json.loads with an explicit schema instead.\n    languages: [python]\n    severity: CRITICAL\n    pattern-either:\n      - pattern: jsonpickle.decode(...)\n      - pattern: jsonpickle.loads(...)\n      - pattern: jsonpickle.unpickler.decode(...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"jsonpickle\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — dill / cloudpickle are pickle supersets: same RCE surface,\n  # commonly reached via model/cache loading paths.\n  # ---------------------------------------------------------------------------\n  - id: raptor.deserialisation.unsafe.python.dill\n    message: >-\n      dill/cloudpickle deserialise arbitrary Python objects (pickle\n      supersets) — remote code execution if the input is\n      attacker-controlled. Use a safe format or sign payloads.\n    languages: [python]\n    severity: CRITICAL\n    pattern-either:\n      - pattern: dill.loads(...)\n      - pattern: dill.load(...)\n      - pattern: cloudpickle.loads(...)\n      - pattern: cloudpickle.load(...)\n    metadata:\n      cwe: [\"CWE-502\"]\n      owasp_top_10: [\"A8:2021-Software and Data Integrity Failures\"]\n      tags: [\"security\", \"deserialisation\", \"pickle\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-021",
      "name": "RAPTOR 原始规则 filesystem/path-traversal.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/filesystem/path-traversal.yaml",
          "content": "rules:\n  # NOTE: the former raptor.files.path_traversal.java rule (every\n  # non-literal `new File($X)` at HIGH, no taint requirement) was\n  # removed: raptor.java.path-traversal (java/java-security.yaml)\n  # covers new File / FileInputStream / Paths.get as taint sinks with\n  # real sources, so the untainted variant only added a finding for\n  # every dynamically-built path in the codebase.\n\n  - id: raptor.files.path_traversal.python\n    message: Python open() with concatenated user input; canonicalise and validate inputs.\n    languages: [python]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          - pattern: open($USERINPUT + \"/\" + $REST)\n          - pattern: open(os.path.join($USERINPUT, $REST))\n      - pattern-not: open(\"...\" + \"/\" + $REST)\n      - pattern-not: open(os.path.join(\"...\", $REST))\n    metadata:\n      cwe: [\"CWE-22\"]\n\n  - id: raptor.files.path_traversal.js\n    message: JavaScript path construction from user input; validate or normalise paths.\n    languages: [javascript, typescript]\n    severity: HIGH\n    patterns:\n      - pattern-either:\n          - pattern: fs.openSync($USERINPUT + \"/\" + $REST, ...)\n          - pattern: fs.readFileSync(path.join($USERINPUT, $REST), ...)\n      - pattern-not: fs.openSync(\"...\" + \"/\" + $REST, ...)\n      - pattern-not: fs.readFileSync(path.join(\"...\", $REST), ...)\n    metadata:\n      cwe: [\"CWE-22\"]\n\n  - id: raptor.files.path_traversal.taint.python\n    message: Untrusted data reaches filesystem path operations. Validate or canonicalise the path.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: request.GET[$_]\n          - pattern: request.POST[$_]\n          - pattern: flask.request.args[$_]\n          - pattern: flask.request.form[$_]\n          - pattern: input(...)\n    pattern-sinks:\n      # os.path.join is deliberately not a sink here —\n      # raptor.python.path-join-traversal owns that shape with the\n      # correct focus on the joined component.\n      - pattern-either:\n          - pattern: open($PATH, ...)\n          - pattern: os.open($PATH, ...)\n          - pattern: Path($PATH)\n    # No abspath/resolve sanitizers: both NORMALISE the path — they\n    # resolve \"../\" so the escape takes effect, they do not confine\n    # it. basename genuinely confines (strips directory components).\n    pattern-sanitizers:\n      - pattern: os.path.basename(...)\n    metadata:\n      cwe: [\"CWE-22\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-022",
      "name": "RAPTOR 原始规则 flows/bad-mac-order.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/flows/bad-mac-order.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Java / Kotlin — MAC computed on plaintext while also encrypting it.\n  # CWE-353 / CWE-310: the MAC must cover the ciphertext, not the plaintext.\n  #\n  # NOTE: A companion \"mac-after-decrypt\" rule was removed because\n  # Cipher.doFinal is used for both encryption and decryption, making it\n  # impossible to distinguish Decrypt-then-MAC (bad) from Encrypt-then-MAC\n  # (correct) without type/mode information.  That rule had a structural FP\n  # on every correct Encrypt-then-MAC call site.\n  # ---------------------------------------------------------------------------\n  - id: raptor.crypto.flow.mac-on-plaintext-after-encrypt.java\n    message: >-\n      MAC is computed on the same data passed to Cipher.doFinal rather than\n      on the ciphertext output.  Prefer Encrypt-then-MAC of ciphertext.\n      Verify with test vectors.\n    languages: [java, kotlin]\n    severity: HIGH\n    pattern-either:\n      - pattern: |\n          $T1 $CT = $CIPHER.doFinal($PT);\n          ...\n          $MAC.doFinal($PT);\n      - pattern: |\n          $T1 $CT = $CIPHER.doFinal($PT);\n          ...\n          $T2 $TAG = $MAC.doFinal($PT);\n    metadata:\n      cwe: [\"CWE-353\",\"CWE-310\"]\n      asvs: [\"V3.11\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-023",
      "name": "RAPTOR 原始规则 go/go-security.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/go/go-security.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Go — pattern: defer Close inside loop body — resource exhaustion\n  # ---------------------------------------------------------------------------\n  - id: raptor.go.defer-close-in-loop\n    message: >-\n      defer $X.Close() inside a loop body accumulates deferred calls until\n      the enclosing function returns, causing resource exhaustion. Close\n      explicitly or extract the loop body into a separate function.\n    languages: [go]\n    severity: MEDIUM\n    patterns:\n      - pattern: defer $X.Close()\n      - pattern-inside: |\n          for ... {\n            ...\n          }\n    metadata:\n      cwe: [\"CWE-401\"]\n      tags: [\"security\", \"go\", \"resource-leak\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: web sources -> non-parameterised SQL query sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.go.sql-sprintf-query\n    message: >-\n      Untrusted data flows into a SQL query without parameterisation. Use\n      db.Query(sql, args...) with positional parameters instead of\n      fmt.Sprintf to build query strings.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches db.Query(...), which self-taints the\n          # Query sinks below (any hardcoded db.Query(fmt.Sprintf(..)))\n          # would flag itself with no attacker data involved).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      # Query/Exec are generic method names shared with non-SQL types,\n      # so they only qualify with an inline fmt.Sprintf whose format\n      # string opens with SQL text — the keyword guard is the FP\n      # control. This closes the gap where db.Query(fmt.Sprintf(...))\n      # fell between this rule (which excluded Query/Exec) and\n      # sql-taint.yaml (which requires + concatenation).\n      - patterns:\n          - pattern-either:\n              - pattern: $DB.Query(fmt.Sprintf($FMT, ...), ...)\n              - pattern: $DB.Exec(fmt.Sprintf($FMT, ...), ...)\n              - pattern: $DB.QueryRow(fmt.Sprintf($FMT, ...), ...)\n              - pattern: $DB.QueryContext($CTX2, fmt.Sprintf($FMT, ...), ...)\n              - pattern: $DB.QueryRowContext($CTX2, fmt.Sprintf($FMT, ...), ...)\n              - pattern: $DB.ExecContext($CTX2, fmt.Sprintf($FMT, ...), ...)\n          - metavariable-regex:\n              metavariable: $FMT\n              regex: '(?i)^\"\\s*(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|MERGE|GRANT|REVOKE)\\b.*'\n      # Single-argument calls to SQL-unique methods only.\n      # Bare-variable Query/Exec excluded — generic names shared with\n      # non-SQL types (concat spellings are caught by sql-taint.yaml's\n      # concat + SQL keyword rule; Sprintf spellings by the guard\n      # above). pattern-not excludes string-literal $Q to prevent FPs\n      # on hardcoded queries.\n      - patterns:\n          - pattern: $DB.QueryRow($Q)\n          - pattern-not: $DB.QueryRow(\"...\")\n          - focus-metavariable: $Q\n      - patterns:\n          - pattern: $DB.QueryContext($CTX2, $Q)\n          - pattern-not: $DB.QueryContext($CTX2, \"...\")\n          - focus-metavariable: $Q\n      - patterns:\n          - pattern: $DB.QueryRowContext($CTX2, $Q)\n          - pattern-not: $DB.QueryRowContext($CTX2, \"...\")\n          - focus-metavariable: $Q\n      - patterns:\n          - pattern: $DB.ExecContext($CTX2, $Q)\n          - pattern-not: $DB.ExecContext($CTX2, \"...\")\n          - focus-metavariable: $Q\n    metadata:\n      cwe: [\"CWE-89\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"go\", \"sqli\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — pattern: insecure TLS configuration\n  # ---------------------------------------------------------------------------\n  - id: raptor.go.insecure-tls-skip-verify\n    message: >-\n      InsecureSkipVerify disables TLS certificate verification, allowing\n      man-in-the-middle attacks. Remove InsecureSkipVerify or set it to false.\n    languages: [go]\n    severity: CRITICAL\n    pattern: |\n      tls.Config{..., InsecureSkipVerify: true, ...}\n    metadata:\n      cwe: [\"CWE-295\"]\n      owasp_top_10: [\"A7:2021-Identification and Authentication Failures\"]\n      tags: [\"security\", \"go\", \"tls\"]\n\n  - id: raptor.go.insecure-tls-min-version\n    message: >-\n      TLS MinVersion allows negotiation of deprecated protocol versions\n      (SSLv3, TLS 1.0, TLS 1.1). Set MinVersion to tls.VersionTLS12 or\n      tls.VersionTLS13.\n    languages: [go]\n    severity: HIGH\n    # Real-world bad configs name the deprecated version constants;\n    # an explicit literal 0 is kept for completeness. Known residual\n    # (undetectable in a struct-literal pattern): OMITTING MinVersion\n    # yields the zero value with the same effect — absence of a field\n    # cannot be matched here (U12-F107).\n    pattern-either:\n      - pattern: |\n          tls.Config{..., MinVersion: tls.VersionSSL30, ...}\n      - pattern: |\n          tls.Config{..., MinVersion: tls.VersionTLS10, ...}\n      - pattern: |\n          tls.Config{..., MinVersion: tls.VersionTLS11, ...}\n      - pattern: |\n          tls.Config{..., MinVersion: 0, ...}\n    metadata:\n      cwe: [\"CWE-295\"]\n      tags: [\"security\", \"go\", \"tls\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: web sources -> filesystem path sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.go.filepath-traversal\n    message: >-\n      Untrusted data flows into a filesystem path operation. Validate and\n      sanitise the path to prevent directory traversal — filepath.Join does\n      NOT prevent \"../\" traversal above the base directory.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: os.Open($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: os.ReadFile($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: os.OpenFile($PATH, $FLAGS, $PERM)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: ioutil.ReadFile($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: filepath.Join($BASE, $PATH)\n          - focus-metavariable: $PATH\n    # No filepath.Clean sanitizer: Clean(\"../..\") returns \"../..\" and\n    # Clean(\"/srv/\"+f) resolves the escape rather than preventing it —\n    # it normalises, it does not confine. filepath.Base does confine\n    # (strips every directory component, \"../\" included).\n    pattern-sanitizers:\n      - pattern: filepath.Base(...)\n    metadata:\n      cwe: [\"CWE-22\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"go\", \"path-traversal\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — pattern: strconv result cast to a narrower int without a range check\n  # ---------------------------------------------------------------------------\n  - id: raptor.go.parsed-int-narrowing-cast\n    message: >-\n      A strconv.Atoi/ParseInt result is cast to a narrower integer type with\n      no range check between the parse and the cast. Values outside the\n      narrow type wrap silently (e.g. uid 4294967296 becomes 0, granting\n      root); negative parses wrap to huge unsigned values. Range-check the\n      parsed value against the destination type's bounds first.\n    languages: [go]\n    severity: MEDIUM\n    patterns:\n      - pattern-either:\n          - pattern: uint32($V)\n          - pattern: uint16($V)\n          - pattern: uint8($V)\n          - pattern: int32($V)\n          - pattern: int16($V)\n          - pattern: int8($V)\n      - pattern-inside: |\n          func $F(...) {\n            ...\n            $V, $ERR := strconv.Atoi(...)\n            ...\n          }\n      - pattern-not-inside: |\n          func $F(...) {\n            ...\n            if $V > $MAX { ... }\n            ...\n          }\n      - pattern-not-inside: |\n          func $F(...) {\n            ...\n            if $V < $MIN { ... }\n            ...\n          }\n      - pattern-not-inside: |\n          func $F(...) {\n            ...\n            if $A <= $V && $V <= $B { ... }\n            ...\n          }\n    metadata:\n      cwe: [\"CWE-190\", \"CWE-681\"]\n      tags: [\"security\", \"go\", \"integer\", \"truncation\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-024",
      "name": "RAPTOR 原始规则 injection/command-taint-multi.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/command-taint-multi.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → command execution sinks\n  # exec.Command(\"ls\", \"-la\") with separate args is safe. The real sink is\n  # exec.Command(\"sh\", \"-c\", tainted) where the shell interprets the input.\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.command.taint.go\n    message: >-\n      Untrusted data flows into command execution via a shell interpreter.\n      Avoid passing user input through sh -c. Use exec.Command() with\n      separate arguments instead.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      - pattern-either:\n          # Shell invocation — the dangerous pattern\n          - pattern: exec.Command(\"sh\", \"-c\", $CMD)\n          - pattern: exec.Command(\"bash\", \"-c\", $CMD)\n          - pattern: exec.Command(\"/bin/sh\", \"-c\", $CMD)\n          - pattern: exec.Command(\"/bin/bash\", \"-c\", $CMD)\n          - pattern: exec.CommandContext($CTX2, \"sh\", \"-c\", $CMD)\n          - pattern: exec.CommandContext($CTX2, \"bash\", \"-c\", $CMD)\n          - pattern: exec.CommandContext($CTX2, \"/bin/sh\", \"-c\", $CMD)\n          - pattern: exec.CommandContext($CTX2, \"/bin/bash\", \"-c\", $CMD)\n      # Tainted binary name — attacker controls which program runs.\n      # focus-metavariable restricts taint to $CMD only, preventing FPs\n      # when a constant binary receives tainted arguments (e.g.\n      # exec.Command(\"ls\", \"-la\", userInput)).\n      - patterns:\n          - pattern: exec.Command($CMD, ...)\n          - focus-metavariable: $CMD\n      - patterns:\n          - pattern: exec.CommandContext($CTX2, $CMD, ...)\n          - focus-metavariable: $CMD\n    metadata:\n      cwe: [\"CWE-78\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"command injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → Runtime.exec / ProcessBuilder\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.command.taint.java\n    message: >-\n      Untrusted data flows into command execution. Avoid Runtime.exec() and\n      ProcessBuilder with user-controlled arguments. Use a safe API or\n      strict input validation with an allowlist.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          # Multi-value/map parameter spellings (source-consistency\n          # sweep; the exec args/env array seam is handled by the\n          # array-initializer propagator work — if a duplicate source\n          # addition arrives from that lane, dedup to one).\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-propagators:\n      # Collection round-trips (measured FN class: same-method\n      # map.put(k, tainted) -> get(k) -> sink). put/add taint the\n      # receiver; semgrep then propagates receiver taint through get.\n      # Key-insensitive by engine design — recall-side over-taint on a\n      # different key is adjudicated downstream (gate/validation), the\n      # honest asymmetry for a detector.\n      - pattern: $M.put($K, $V)\n        from: $V\n        to: $M\n      - pattern: $M.add($V)\n        from: $V\n        to: $M\n      # Array initializers (measured FN class: the Benchmark's\n      # String[] args = {\"sh\", \"-c\", tainted} / new String[]{...}\n      # shapes) — a tainted element taints the array variable. The\n      # constant-only initializer stays clean: taint only propagates\n      # when an element already carries it.\n      - pattern: String[] $A = { ..., $X, ... };\n        from: $X\n        to: $A\n      - pattern: $A = new String[] { ..., $X, ... }\n        from: $X\n        to: $A\n    pattern-sinks:\n      - pattern-either:\n          # Runtime.exec — string form invokes the shell\n          - pattern: Runtime.getRuntime().exec($CMD)\n          - pattern: Runtime.getRuntime().exec($CMD, ...)\n          # Variable receiver (Runtime r = Runtime.getRuntime();\n          # r.exec(...)) — the chained spelling misses it (measured:\n          # every OWASP exec miss used a variable receiver). The env\n          # array is a sink position in its own right: attacker-\n          # controlled environment variables reach the child process.\n          - pattern: (Runtime $R).exec($CMD)\n          - pattern: (Runtime $R).exec($CMD, $ENV)\n          # ProcessBuilder\n          - pattern: new ProcessBuilder($CMD, ...)\n          - pattern: new ProcessBuilder(Arrays.asList($CMD, ...))\n          # ProcessBuilder.command with tainted args\n          - pattern: (ProcessBuilder $PB).command($CMD, ...)\n    metadata:\n      cwe: [\"CWE-78\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"command injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → child_process sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.command.taint.javascript\n    message: >-\n      Untrusted data flows into command execution. Avoid child_process.exec()\n      and spawn with shell:true. Use execFile() or spawn() without shell\n      option and pass arguments as an array.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          # child_process.exec — always shell-interpreted\n          - pattern: child_process.exec($CMD, ...)\n          - pattern: child_process.execSync($CMD, ...)\n          - pattern: exec($CMD, ...)\n          - pattern: execSync($CMD, ...)\n          # spawn with shell option\n          - pattern: \"child_process.spawn($CMD, ..., {shell: true, ...}, ...)\"\n          - pattern: \"child_process.spawnSync($CMD, ..., {shell: true, ...}, ...)\"\n          - pattern: \"spawn($CMD, ..., {shell: true, ...}, ...)\"\n          - pattern: \"spawnSync($CMD, ..., {shell: true, ...}, ...)\"\n          # eval — different CWE (CWE-94 code injection) but same\n          # attacker-controls-execution impact in JS contexts\n          - pattern: eval($CMD)\n          - pattern: new Function($CMD)\n    metadata:\n      cwe: [\"CWE-78\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"command injection\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-025",
      "name": "RAPTOR 原始规则 injection/command-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/command-taint.yaml",
          "content": "rules:\n  - id: raptor.injection.command.taint.python\n    message: Untrusted input is passed to command execution. Use safe APIs or sanitise arguments.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask — both the flask.request spelling and the bare\n          # `from flask import request` spelling\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          - pattern: request.args[...]\n          - pattern: request.args.get(...)\n          - pattern: request.form[...]\n          - pattern: request.form.get(...)\n          # FastAPI / Starlette\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          - pattern: subprocess.run($CMD, ..., shell=True, ...)\n          - pattern: subprocess.Popen($CMD, ..., shell=True, ...)\n          - pattern: subprocess.call($CMD, ..., shell=True, ...)\n          - pattern: subprocess.check_call($CMD, ..., shell=True, ...)\n          - pattern: subprocess.check_output($CMD, ..., shell=True, ...)\n          - pattern: os.system($CMD)\n          - pattern: os.popen($CMD)\n    pattern-sanitizers:\n      - pattern: shlex.quote(...)\n      - pattern: shlex.join(...)\n    metadata:\n      cwe: [\"CWE-78\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"command injection\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-026",
      "name": "RAPTOR 原始规则 injection/eval-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/eval-taint.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → eval/exec/compile sinks\n  # CWE-95: Code Injection via eval/exec.\n  #\n  # NOTE: JavaScript eval() and new Function() are already covered by\n  # raptor.injection.command.taint.javascript in command-taint-multi.yaml.\n  # This file covers Python only to avoid duplicate findings.\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.eval.taint.python\n    message: >-\n      Untrusted data flows into eval(), exec(), or compile(). An attacker\n      can execute arbitrary Python code. Use ast.literal_eval() for safe\n      evaluation of literal expressions, or avoid dynamic code execution.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: eval($CODE, ...)\n          - focus-metavariable: $CODE\n      - patterns:\n          - pattern: exec($CODE, ...)\n          - focus-metavariable: $CODE\n      - patterns:\n          - pattern: compile($CODE, $FILENAME, $MODE, ...)\n          - focus-metavariable: $CODE\n    pattern-sanitizers:\n      # ast.literal_eval is a safe subset — only evaluates literals\n      - pattern: ast.literal_eval(...)\n    metadata:\n      cwe: [\"CWE-95\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"code-injection\", \"taint\"]\n      cross_reference: >-\n        JS eval/new Function covered by\n        raptor.injection.command.taint.javascript (command-taint-multi.yaml)\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-027",
      "name": "RAPTOR 原始规则 injection/header-injection.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/header-injection.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → HTTP response header value\n  # CWE-113: HTTP Response Splitting via CRLF in header values.\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.header-injection.taint.python\n    message: >-\n      Untrusted data flows into an HTTP response header value. An attacker\n      can inject CRLF sequences to split the response and inject arbitrary\n      headers or body content. Validate and sanitise header values.\n    languages: [python]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      # Focus on $VALUE to prevent FPs when only the header NAME is\n      # tainted — header-name injection is a different attack class\n      - patterns:\n          - pattern-either:\n              # Django HttpResponse header dict-style assignment\n              - pattern: $RESPONSE[$HEADER] = $VALUE\n              # Flask/Werkzeug response headers\n              - pattern: $RESPONSE.headers[$HEADER] = $VALUE\n              - pattern: $RESPONSE.headers.set($HEADER, $VALUE)\n              - pattern: $RESPONSE.headers.add($HEADER, $VALUE)\n              # Django HttpResponse constructor with headers kwarg\n              - pattern: \"HttpResponse(..., headers={..., $KEY: $VALUE, ...}, ...)\"\n          - focus-metavariable: $VALUE\n    # A sanitizer must handle BOTH \\n and \\r — a single-character\n    # replace (or a \"\\r\\n\" pair replace) still lets the other bare\n    # character through and the response still splits.\n    pattern-sanitizers:\n      - pattern: $X.replace(\"\\n\", ...).replace(\"\\r\", ...)\n      - pattern: $X.replace(\"\\r\", ...).replace(\"\\n\", ...)\n    metadata:\n      cwe: [\"CWE-113\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"header-injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → response header value\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.header-injection.taint.go\n    message: >-\n      Untrusted data flows into an HTTP response header value. An attacker\n      can inject CRLF sequences to split the response. Validate and\n      sanitise header values before setting them.\n    languages: [go]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      # Focus on $VALUE — the header name is not attacker-controlled in\n      # the typical case and flagging it would create FPs.\n      - patterns:\n          - pattern: $W.Header().Set($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n      - patterns:\n          - pattern: $W.Header().Add($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n    # Both \\n and \\r must be handled — a single ReplaceAll leaves the\n    # other character usable for splitting.\n    pattern-sanitizers:\n      - pattern: strings.ReplaceAll(strings.ReplaceAll($X, \"\\n\", ...), \"\\r\", ...)\n      - pattern: strings.ReplaceAll(strings.ReplaceAll($X, \"\\r\", ...), \"\\n\", ...)\n    metadata:\n      cwe: [\"CWE-113\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"header-injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → HttpServletResponse header value\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.header-injection.taint.java\n    message: >-\n      Untrusted data flows into an HTTP response header value. An attacker\n      can inject CRLF sequences to split the response. Validate and\n      sanitise header values before setting them.\n    languages: [java]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      # Focus on $VALUE only\n      - patterns:\n          - pattern: (HttpServletResponse $RESP).setHeader($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n      - patterns:\n          - pattern: (HttpServletResponse $RESP).addHeader($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n    # Both \\n and \\r must be handled — the regex-class replaceAll does,\n    # single-character replaces only qualify chained in both orders.\n    pattern-sanitizers:\n      - pattern: $X.replaceAll(\"[\\n\\r]\", ...)\n      - pattern: $X.replaceAll(\"[\\r\\n]\", ...)\n      - pattern: $X.replace(\"\\n\", ...).replace(\"\\r\", ...)\n      - pattern: $X.replace(\"\\r\", ...).replace(\"\\n\", ...)\n    metadata:\n      cwe: [\"CWE-113\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"header-injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → response header value\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.header-injection.taint.javascript\n    message: >-\n      Untrusted data flows into an HTTP response header value. An attacker\n      can inject CRLF sequences to split the response. Validate and\n      sanitise header values before setting them.\n    languages: [javascript, typescript]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      # Express / Node http — focus on $VALUE\n      - patterns:\n          - pattern: $RES.setHeader($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n      - patterns:\n          - pattern: $RES.set($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n      - patterns:\n          - pattern: $RES.header($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n      - patterns:\n          - pattern: $RES.append($NAME, $VALUE)\n          - focus-metavariable: $VALUE\n    # Both \\n and \\r must be handled — the character-class replace\n    # does, single-character replaces only qualify chained in both\n    # orders.\n    pattern-sanitizers:\n      - pattern: $X.replace(/[\\r\\n]/g, ...)\n      - pattern: $X.replace(/[\\n\\r]/g, ...)\n      - pattern: $X.replace(/\\n/g, ...).replace(/\\r/g, ...)\n      - pattern: $X.replace(/\\r/g, ...).replace(/\\n/g, ...)\n    metadata:\n      cwe: [\"CWE-113\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"header-injection\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-028",
      "name": "RAPTOR 原始规则 injection/ldap-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/ldap-taint.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → LDAP search filter sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ldap.taint.python\n    message: >-\n      Untrusted data flows into an LDAP search filter. Use\n      ldap.filter.escape_filter_chars() or ldap3.utils.conv.escape_filter_chars()\n      to sanitise user input before embedding it in filter strings.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      # python-ldap — search_s / search_st / search_ext_s\n      # Filter argument is at index 2 (0=base, 1=scope, 2=filterstr)\n      - patterns:\n          - pattern: $CONN.search_s($BASE, $SCOPE, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $CONN.search_st($BASE, $SCOPE, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $CONN.search_ext_s($BASE, $SCOPE, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $CONN.search($BASE, $SCOPE, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      # ldap3 — Connection.search\n      - patterns:\n          - pattern: $CONN.search($BASE, $FILTER, ...)\n          - focus-metavariable: $FILTER\n    pattern-sanitizers:\n      - pattern: ldap.filter.escape_filter_chars(...)\n      - pattern: escape_filter_chars(...)\n    metadata:\n      cwe: [\"CWE-90\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ldap\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → DirContext search filter sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ldap.taint.java\n    message: >-\n      Untrusted data flows into an LDAP search filter. Use\n      parameterised search filters with javax.naming.directory.SearchControls\n      or escape special LDAP characters before embedding in filter strings.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-propagators:\n      # Same collection round-trip seam as the other java taint rules.\n      - pattern: $M.put($K, $V)\n        from: $V\n        to: $M\n      - pattern: $M.add($V)\n        from: $V\n        to: $M\n    pattern-sinks:\n      # DirContext.search with filter string\n      - patterns:\n          - pattern: (DirContext $CTX).search($NAME, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: (javax.naming.directory.DirContext $CTX).search($NAME, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: (InitialDirContext $CTX).search($NAME, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: (LdapContext $CTX).search($NAME, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: (InitialLdapContext $CTX).search($NAME, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      # Spring LdapTemplate\n      - patterns:\n          - pattern: (LdapTemplate $LT).search($BASE, $FILTER, ...)\n          - focus-metavariable: $FILTER\n    pattern-sanitizers:\n      - pattern: ESAPI.encoder().encodeForLDAP(...)\n      - pattern: org.owasp.esapi.ESAPI.encoder().encodeForLDAP(...)\n      - pattern: (Encoder $ENC).encodeForLDAP(...)\n    metadata:\n      cwe: [\"CWE-90\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ldap\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → go-ldap search filter sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ldap.taint.go\n    message: >-\n      Untrusted data flows into an LDAP search filter. Escape special\n      LDAP characters in user input before constructing filter strings.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      # go-ldap — NewSearchRequest: filter is argument index 6\n      - patterns:\n          - pattern: ldap.NewSearchRequest($BASE, $SCOPE, $DEREF, $SIZE, $TIME, $TYPES, $FILTER, $ATTRS, $CTRLS)\n          - focus-metavariable: $FILTER\n    pattern-sanitizers:\n      - pattern: ldap.EscapeFilter(...)\n    metadata:\n      cwe: [\"CWE-90\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ldap\", \"taint\"]\n\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-029",
      "name": "RAPTOR 原始规则 injection/log-injection.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/log-injection.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → logging format-string position\n  # CWE-117: Log Injection / Log Forging via CRLF in log messages.\n  # Only fires when user input IS the format string / message, NOT when it\n  # is a format argument (logging.info(\"User: %s\", user_input) is safe).\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.log-injection.taint.python\n    message: >-\n      Untrusted data flows into the log message string. An attacker can\n      inject CRLF sequences to forge log entries or corrupt log parsers.\n      Sanitise newlines before logging, or pass user data as format\n      arguments (logging.info(\"User: %s\", user_input)).\n    languages: [python]\n    severity: MEDIUM\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      # Module-level logging functions — focus on the message/format-string\n      - patterns:\n          - pattern: logging.info($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: logging.warning($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: logging.error($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: logging.debug($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: logging.critical($MSG, ...)\n          - focus-metavariable: $MSG\n      # Logger instance methods\n      - patterns:\n          - pattern: $LOGGER.info($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.warning($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.error($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.debug($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.critical($MSG, ...)\n          - focus-metavariable: $MSG\n    # A sanitizer must handle BOTH \\n and \\r — a single-character\n    # replace (or a \"\\r\\n\" pair replace) still lets the other bare\n    # character forge entries.\n    pattern-sanitizers:\n      - pattern: $X.replace(\"\\n\", ...).replace(\"\\r\", ...)\n      - pattern: $X.replace(\"\\r\", ...).replace(\"\\n\", ...)\n    metadata:\n      cwe: [\"CWE-117\"]\n      owasp_top_10: [\"A9:2021-Security Logging and Monitoring Failures\"]\n      tags: [\"security\", \"injection\", \"log-injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → log format-string position\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.log-injection.taint.go\n    message: >-\n      Untrusted data flows into the log format string. An attacker can\n      inject newlines to forge log entries. Sanitise newlines before\n      logging, or use structured logging (slog) with typed fields.\n    languages: [go]\n    severity: MEDIUM\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      # log.Printf — focus on format string\n      - patterns:\n          - pattern: log.Printf($FMT, ...)\n          - focus-metavariable: $FMT\n      - patterns:\n          - pattern: log.Fatalf($FMT, ...)\n          - focus-metavariable: $FMT\n      - patterns:\n          - pattern: log.Panicf($FMT, ...)\n          - focus-metavariable: $FMT\n      # log.Print/Println — message is the content\n      - patterns:\n          - pattern: log.Println($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: log.Print($MSG, ...)\n          - focus-metavariable: $MSG\n      # slog — structured logger message string\n      - patterns:\n          - pattern: slog.Info($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: slog.Warn($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: slog.Error($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: slog.Debug($MSG, ...)\n          - focus-metavariable: $MSG\n      # Logger instance\n      - patterns:\n          - pattern: $LOGGER.Printf($FMT, ...)\n          - focus-metavariable: $FMT\n      - patterns:\n          - pattern: $LOGGER.Println($MSG, ...)\n          - focus-metavariable: $MSG\n    # Both \\n and \\r must be handled — a single ReplaceAll leaves the\n    # other character usable for forging.\n    pattern-sanitizers:\n      - pattern: strings.ReplaceAll(strings.ReplaceAll($X, \"\\n\", ...), \"\\r\", ...)\n      - pattern: strings.ReplaceAll(strings.ReplaceAll($X, \"\\r\", ...), \"\\n\", ...)\n    metadata:\n      cwe: [\"CWE-117\"]\n      owasp_top_10: [\"A9:2021-Security Logging and Monitoring Failures\"]\n      tags: [\"security\", \"injection\", \"log-injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → Logger message position\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.log-injection.taint.java\n    message: >-\n      Untrusted data flows into the log message string. An attacker can\n      inject CRLF sequences to forge log entries. Sanitise newlines or\n      use structured logging with parameterised messages\n      (logger.info(\"User: {}\", userInput)).\n    languages: [java]\n    severity: MEDIUM\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      # SLF4J / Log4j2 Logger — focus on message position\n      - patterns:\n          - pattern: (Logger $LOG).info($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: (Logger $LOG).warn($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: (Logger $LOG).error($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: (Logger $LOG).debug($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: (Logger $LOG).trace($MSG, ...)\n          - focus-metavariable: $MSG\n    # Both \\n and \\r must be handled — the regex-class replaceAll does,\n    # single-character replaces only qualify chained in both orders.\n    pattern-sanitizers:\n      - pattern: $X.replaceAll(\"[\\n\\r]\", ...)\n      - pattern: $X.replaceAll(\"[\\r\\n]\", ...)\n      - pattern: $X.replace(\"\\n\", ...).replace(\"\\r\", ...)\n      - pattern: $X.replace(\"\\r\", ...).replace(\"\\n\", ...)\n    metadata:\n      cwe: [\"CWE-117\"]\n      owasp_top_10: [\"A9:2021-Security Logging and Monitoring Failures\"]\n      tags: [\"security\", \"injection\", \"log-injection\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → console/logger sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.log-injection.taint.javascript\n    message: >-\n      Untrusted data flows into a log message. An attacker can inject\n      newlines to forge log entries or corrupt log parsers. Sanitise\n      newlines before logging.\n    languages: [javascript, typescript]\n    severity: MEDIUM\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: console.log($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: console.error($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: console.warn($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: console.info($MSG, ...)\n          - focus-metavariable: $MSG\n      # winston / bunyan / pino logger instances\n      - patterns:\n          - pattern: $LOGGER.info($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.warn($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.error($MSG, ...)\n          - focus-metavariable: $MSG\n      - patterns:\n          - pattern: $LOGGER.debug($MSG, ...)\n          - focus-metavariable: $MSG\n    # Both \\n and \\r must be handled — the character-class replace\n    # does, single-character replaces only qualify chained in both\n    # orders.\n    pattern-sanitizers:\n      - pattern: $X.replace(/[\\r\\n]/g, ...)\n      - pattern: $X.replace(/[\\n\\r]/g, ...)\n      - pattern: $X.replace(/\\n/g, ...).replace(/\\r/g, ...)\n      - pattern: $X.replace(/\\r/g, ...).replace(/\\n/g, ...)\n    metadata:\n      cwe: [\"CWE-117\"]\n      owasp_top_10: [\"A9:2021-Security Logging and Monitoring Failures\"]\n      tags: [\"security\", \"injection\", \"log-injection\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-030",
      "name": "RAPTOR 原始规则 injection/nosql-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/nosql-taint.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → MongoDB query sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.nosql.taint.javascript\n    message: >-\n      Untrusted data flows directly into a MongoDB query filter. An attacker\n      can inject query operators (e.g. $gt, $ne, $regex) to bypass\n      authentication or extract data. Validate and sanitise query objects\n      before passing them to MongoDB.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.body\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n                  - pattern: $CTX.request.body\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      # MongoDB native driver — collection methods with filter as first arg\n      - patterns:\n          - pattern: $COLL.find($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.findOne($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.updateOne($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.updateMany($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.deleteOne($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.deleteMany($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.countDocuments($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.distinct($FIELD, $FILTER, ...)\n          - focus-metavariable: $FILTER\n      # MongoDB $where — always dangerous with user input\n      - patterns:\n          - pattern: \"$COLL.find({$where: $EXPR, ...})\"\n          - focus-metavariable: $EXPR\n      # Mongoose model methods\n      - patterns:\n          - pattern: $MODEL.find($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $MODEL.findOne($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $MODEL.findOneAndUpdate($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $MODEL.findOneAndDelete($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $MODEL.findOneAndReplace($FILTER, ...)\n          - focus-metavariable: $FILTER\n    pattern-sanitizers:\n      # mongo-sanitize strips $ keys from objects.\n      #\n      # Known FN mode: the bare `sanitize($X)` spelling matches ANY\n      # user function named `sanitize`, whatever it actually does —\n      # a no-op or wrong-class sanitizer under that name silences a\n      # real finding. The pattern stays because `sanitize` is the\n      # canonical import name of the mongo-sanitize package\n      # (`const sanitize = require('mongo-sanitize')`), which cannot\n      # be distinguished from a same-named local at pattern level.\n      # Missed-finding direction only, never a false confirmation.\n      - pattern: mongoSanitize($X)\n      - pattern: sanitize($X)\n    metadata:\n      cwe: [\"CWE-943\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"nosql\", \"mongodb\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → PyMongo query sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.nosql.taint.python\n    message: >-\n      Untrusted data flows directly into a PyMongo query filter. An attacker\n      can inject query operators (e.g. $gt, $ne, $regex) to bypass\n      authentication or extract data. Validate and sanitise query objects\n      before passing them to MongoDB.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.json\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      # PyMongo collection methods — filter as first arg\n      - patterns:\n          - pattern: $COLL.find($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.find_one($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.update_one($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.update_many($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.delete_one($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.delete_many($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.count_documents($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.find_one_and_update($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.find_one_and_delete($FILTER, ...)\n          - focus-metavariable: $FILTER\n      - patterns:\n          - pattern: $COLL.find_one_and_replace($FILTER, ...)\n          - focus-metavariable: $FILTER\n    metadata:\n      cwe: [\"CWE-943\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"nosql\", \"mongodb\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-031",
      "name": "RAPTOR 原始规则 injection/regex-dos.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/regex-dos.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → regex pattern position\n  # CWE-1333: Regular Expression Denial of Service (ReDoS).\n  # Only fires when the PATTERN comes from user input — using a constant\n  # regex against user-supplied input strings is safe.\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.regex-dos.taint.python\n    message: >-\n      Untrusted data flows into a regular expression pattern. An attacker\n      can craft a malicious regex causing catastrophic backtracking (ReDoS).\n      Use re2 or validate/restrict the pattern before compilation.\n    languages: [python]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: re.compile($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.match($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.search($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.findall($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.finditer($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.sub($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.split($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: re.fullmatch($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n    pattern-sanitizers:\n      - pattern: re.escape(...)\n    metadata:\n      cwe: [\"CWE-1333\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"redos\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → RegExp pattern\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.regex-dos.taint.javascript\n    message: >-\n      Untrusted data flows into a regular expression pattern. An attacker\n      can craft a malicious regex causing catastrophic backtracking (ReDoS).\n      Use a safe regex library (re2) or validate/restrict the pattern.\n    languages: [javascript, typescript]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: new RegExp($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: $STR.match($PATTERN)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: $STR.search($PATTERN)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: $STR.replace($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: $STR.replaceAll($PATTERN, ...)\n          - focus-metavariable: $PATTERN\n      - patterns:\n          - pattern: $STR.split($PATTERN)\n          - focus-metavariable: $PATTERN\n    pattern-sanitizers:\n      # lodash/underscore escape function\n      - pattern: _.escapeRegExp(...)\n      - pattern: escapeRegExp(...)\n      - pattern: escapeStringRegexp(...)\n    metadata:\n      cwe: [\"CWE-1333\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"redos\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → regex pattern position\n  # Only the PATTERN position is a sink — matching untrusted INPUT\n  # against a constant, linear regex is the safe, normal case.\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.regex-dos.taint.java\n    message: >-\n      Untrusted data flows into a regular expression pattern. An attacker\n      can supply a catastrophic-backtracking regex (e.g. \"(a+)+$\") causing\n      a ReDoS that pins a thread per request. Quote the value with\n      Pattern.quote() if it is a literal token, or validate/restrict the\n      pattern before compilation.\n    languages: [java]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Header/parameter enumerations are request data too: the\n          # Enumeration itself is the source; taint reaches values via\n          # nextElement(). Parameter/header NAMES are attacker-chosen.\n          - pattern: (HttpServletRequest $REQ).getHeaders(...)\n          - pattern: (HttpServletRequest $REQ).getHeaderNames()\n          - pattern: (HttpServletRequest $REQ).getParameterNames()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      # focus-metavariable pins the sink to the PATTERN argument so a\n      # tainted SUBJECT string (the overwhelmingly common safe case)\n      # never trips the rule.\n      - patterns:\n          - pattern: Pattern.compile($P, ...)\n          - focus-metavariable: $P\n      - patterns:\n          - pattern: Pattern.matches($P, $IN)\n          - focus-metavariable: $P\n      - patterns:\n          - pattern: $S.matches($P)\n          - focus-metavariable: $P\n      - patterns:\n          - pattern: $S.split($P, ...)\n          - focus-metavariable: $P\n      - patterns:\n          - pattern: $S.replaceAll($P, $R)\n          - focus-metavariable: $P\n      - patterns:\n          - pattern: $S.replaceFirst($P, $R)\n          - focus-metavariable: $P\n    pattern-sanitizers:\n      - pattern: Pattern.quote(...)\n    metadata:\n      cwe: [\"CWE-1333\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"redos\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — literal pattern with a catastrophic-backtracking shape.\n  # Complements the taint rule above: here the pattern is a constant, and\n  # the DoS comes from attacker-controlled INPUT hitting an exponential\n  # regex. Fires only when the literal contains one of three verified\n  # blowup shapes (all guards are precision-first; misses are accepted):\n  #\n  #   A. Nested unbounded quantifier — \"(a+)+\", \"(\\d+)*\", \"(a{2,})+\",\n  #      \"(\\w+\\s?)*\": the group body is built ONLY of quantified runs\n  #      and optional atoms (no required delimiter), so iteration\n  #      boundaries are ambiguous, under an unbounded outer quantifier.\n  #      Excluded: required-delimiter groups (\"(\\.\\w+)*\", \"([^,]*,)+\"\n  #      — the delimiter disambiguates, linear), possessive outer\n  #      \")++\"/\")*+\", atomic \"(?>\", lookarounds (zero-width, match at\n  #      most once), bounded repetition either side, escaped parens\n  #      \"\\(x+\\)+\". Known accepted miss: a required atom that merely\n  #      OVERLAPS the run (\"(\\w\\d+)*\") needs char-class reasoning a\n  #      shape regex cannot do.\n  #   B. Self-repetition alternation — \"(a|aa)+\", \"(ab|abab)*\": both\n  #      branches repeat the same unit, so every input partition is\n  #      ambiguous. Plain overlapping words (\"(cat|dog)+\") do NOT fire.\n  #   C. Unbounded wildcard run inside an unbounded group — \"(.*,)+\",\n  #      \"(a.+b)*\": \".*\"/\".+\" overlaps whatever follows, so iteration\n  #      boundaries are ambiguous. \".\" inside a character class or\n  #      escaped \"\\.\" does not fire.\n  #\n  # Group spellings: every shape admits plain \"(\", non-capturing \"(?:\",\n  # named \"(?<name>\", flag \"(?i:\" / \"(?im-s:\", and inline-flag \"((?i)\"\n  # openings — while still rejecting lookarounds \"(?=\" \"(?!\" \"(?<=\" and\n  # atomic \"(?>\" (zero-width / non-backtracking). A group is \"real\" only\n  # behind an EVEN number of regex-level backslashes, so both \"\\(x+\\)+\"\n  # (escaped parens, no group) and \"\\\\(a+)+\" (literal backslash, real\n  # vulnerable group — fires) classify correctly.\n  #\n  # COMMENTS mode (whitespace-insignificant) gets a coarser core —\n  # unbounded run directly (modulo whitespace) under an unbounded outer\n  # — because delimiter reasoning does not survive ignored whitespace:\n  # inline \"(?x)\" via a gated fourth alternative below, the\n  # Pattern.COMMENTS flag argument via the dedicated clause. Documented\n  # compromise: within COMMENTS mode, required-delimiter linear\n  # patterns whose run touches the close paren (e.g. \"( a+ b+ )+\") can\n  # fire; COMMENTS usage is rare and the miss direction is FP-bounded\n  # there, never recall-bounded elsewhere.\n  #\n  # The shape regexes run over the literal's SOURCE text, where Java\n  # doubles regex backslashes (\"\\\\d\"); the escape guards hold for both\n  # the doubled and the logical single-backslash form (unpaired-form\n  # ambiguity degrades to a miss, never a false fire).\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.regex-dos.literal.java\n    message: >-\n      Regex literal has a catastrophic-backtracking shape (nested\n      unbounded quantifiers, self-repeating alternation, or an unbounded\n      wildcard run inside a repeated group). Non-matching input triggers\n      exponential backtracking in java.util.regex — a short crafted\n      string pins the thread (ReDoS). Rewrite with possessive\n      quantifiers/atomic groups, bounded repetition, or an unambiguous\n      structure.\n    languages: [java]\n    severity: MEDIUM\n    patterns:\n      - pattern-either:\n          # Normal-mode literals on any regex sink: shapes A/B/C plus\n          # the (?x)-gated COMMENTS core as a fourth alternative.\n          - patterns:\n              - pattern-either:\n                  - pattern: Pattern.compile(\"$P\", ...)\n                  - pattern: Pattern.matches(\"$P\", $IN)\n                  - pattern: $S.matches(\"$P\")\n                  - pattern: $S.split(\"$P\", ...)\n                  - pattern: $S.replaceAll(\"$P\", $R)\n                  - pattern: $S.replaceFirst(\"$P\", $R)\n              - metavariable-regex:\n                  metavariable: $P\n                  regex: '(?s).*?(?:(?:(?<!\\\\)(?:\\\\{4})*\\((?:\\?<[a-zA-Z][a-zA-Z0-9]*>|\\?[a-zA-Z-]*:|\\(\\?[a-zA-Z-]+\\)|(?!\\?))(?:(?:\\[[^\\]]*\\]|\\\\+[^\\s]|[^()\\\\\\[\\]+*?{}|])\\?)*(?:\\[[^\\]]*\\]|\\\\+[^\\s]|[^()\\\\\\[\\]+*?{}|])(?:[+*]\\??|\\{\\d+,\\})(?:(?:\\[[^\\]]*\\]|\\\\+[^\\s]|[^()\\\\\\[\\]+*?{}|])(?:[+*]\\??|\\{\\d+,\\}|\\?))*\\)(?:[+*]|\\{\\d+,\\})(?!\\+))|(?:(?<!\\\\)(?:\\\\{4})*\\((?:\\?<[a-zA-Z][a-zA-Z0-9]*>|\\?[a-zA-Z-]*:|\\(\\?[a-zA-Z-]+\\)|(?!\\?))([^()|\\\\]+)(?:\\1)*\\|(?:\\1)+\\)(?:[+*]|\\{\\d+,\\})(?!\\+))|(?:(?<!\\\\)(?:\\\\{4})*\\((?:\\?<[a-zA-Z][a-zA-Z0-9]*>|\\?[a-zA-Z-]*:|\\(\\?[a-zA-Z-]+\\)|(?!\\?))[^()]*(?<![\\\\\\[])\\.[*+](?!\\+)[^()]*\\)(?:[+*]|\\{\\d+,\\})(?!\\+))|(?:(?=.{0,30}?\\(\\?[a-zA-Z-]*x[a-zA-Z-]*[):]).*?(?<!\\\\)(?:\\\\{4})*\\((?:\\?<[a-zA-Z][a-zA-Z0-9]*>|\\?[a-zA-Z-]*:|\\(\\?[a-zA-Z-]+\\)|(?!\\?))[^()]*(?<![\\\\+*])[+*]\\??\\s*\\)\\s*(?:[+*]|\\{\\d+,\\})(?!\\+)))'\n          # COMMENTS passed as a compile flag: whitespace is\n          # insignificant, so only the coarser core applies.\n          - patterns:\n              - pattern-either:\n                  - pattern: Pattern.compile(\"$P\", Pattern.COMMENTS)\n                  - pattern: Pattern.compile(\"$P\", Pattern.COMMENTS | $F)\n                  - pattern: Pattern.compile(\"$P\", $F | Pattern.COMMENTS)\n              - metavariable-regex:\n                  metavariable: $P\n                  regex: '(?s).*?(?<!\\\\)(?:\\\\{4})*\\((?:\\?<[a-zA-Z][a-zA-Z0-9]*>|\\?[a-zA-Z-]*:|\\(\\?[a-zA-Z-]+\\)|(?!\\?))[^()]*(?<![\\\\+*])[+*]\\??\\s*\\)\\s*(?:[+*]|\\{\\d+,\\})(?!\\+)'\n    metadata:\n      cwe: [\"CWE-1333\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"redos\", \"backtracking\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-032",
      "name": "RAPTOR 原始规则 injection/sql-concat.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/sql-concat.yaml",
          "content": "rules:\n  # Concatenation shapes are language-split: the PHP `.` operator and\n  # the Python `%` format don't parse under the other grammars, and a\n  # single multi-language rule dies whole when one branch fails.\n  # Known residual (documented, not detected here): f-strings /\n  # template literals — those are the taint rules' job below.\n  # Pre-fix this rule matched only the exact shape `query = \"SELECT \"\n  # + $X` (variable literally named `query`, literal exactly\n  # \"SELECT \") — effectively dead on real code (U12-F102).\n  - id: raptor.injection.sql.concatenation\n    message: SQL query formed by string concatenation; use parameterised queries or prepared statements.\n    languages: [java, javascript, python]\n    severity: HIGH\n    pattern-either:\n      - pattern: $Q = \"=~/(?i)^\\s*(select|insert|update|delete|create|drop|alter)[^a-z0-9_]/\" + ...\n      - patterns:\n          - pattern: $OBJ.$METHOD(\"=~/(?i)^\\s*(select|insert|update|delete)[^a-z0-9_]/\" + ...)\n          - metavariable-regex:\n              metavariable: $METHOD\n              regex: ^(executeQuery|executeUpdate|execute|executemany|query|rawQuery)$\n    metadata:\n      cwe: [\"CWE-89\"]\n      asvs: [\"V5.1\"]\n\n  - id: raptor.injection.sql.concatenation.format\n    message: SQL query formed by %-formatting; use parameterised queries or placeholders.\n    languages: [python]\n    severity: HIGH\n    pattern: $Q = \"=~/(?i)^\\s*(select|insert|update|delete)[^a-z0-9_]/\" % ...\n    metadata:\n      cwe: [\"CWE-89\"]\n      asvs: [\"V5.1\"]\n\n  - id: raptor.injection.sql.concatenation.php\n    message: SQL query formed by string concatenation; use parameterised queries or prepared statements.\n    languages: [php]\n    severity: HIGH\n    # Deep match on the innermost `\"SQL...\" . $X` node so left-assoc\n    # chains fire; a constant SQL string with no concatenation has no\n    # `.` node and stays silent.\n    pattern: $Q = <... \"=~/(?i)^\\s*(select|insert|update|delete)[^a-z0-9_]/\" . $X ...>;\n    metadata:\n      cwe: [\"CWE-89\"]\n      asvs: [\"V5.1\"]\n\n  - id: raptor.injection.sql.taint.python\n    message: Untrusted data flows into SQL execution. Use parameterised queries or placeholders.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: request.GET[$_]\n          - pattern: request.POST[$_]\n          - pattern: flask.request.args[$_]\n          - pattern: flask.request.form[$_]\n          - pattern: input(...)\n          - pattern: os.environ[$_]\n    pattern-sinks:\n      - pattern-either:\n          - pattern: $DB.execute($QUERY)\n          - pattern: $DB.executemany($QUERY)\n    # NOTE: sqlalchemy.text() and psycopg2.sql.SQL() are NOT\n    # sanitizers — both wrap the string verbatim, so tainted data\n    # concatenated into their argument still reaches the database\n    # as executable SQL. Genuinely parameterised calls\n    # (db.execute(query, params)) are already non-findings: the\n    # one-argument sink patterns above do not match them.\n    pattern-sanitizers:\n      - pattern: int(...)\n    metadata:\n      cwe: [\"CWE-89\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-033",
      "name": "RAPTOR 原始规则 injection/sql-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/sql-taint.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → database/sql query sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.sql.taint.go\n    message: >-\n      Untrusted data flows into a SQL query. Use parameterised queries\n      (db.Query(sql, args...)) instead of string formatting.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the db.Query(...) sinks below, so a\n          # hardcoded db.Query(\"SELECT...\" + \"literal\") self-tainted\n          # with no attacker data involved.\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      - patterns:\n          - pattern-either:\n              - pattern: $DB.Query($Q + $X, ...)\n              - pattern: $DB.QueryRow($Q + $X, ...)\n              - pattern: $DB.Exec($Q + $X, ...)\n              - pattern: $DB.QueryContext($CTX2, $Q + $X, ...)\n              - pattern: $DB.QueryRowContext($CTX2, $Q + $X, ...)\n              - pattern: $DB.ExecContext($CTX2, $Q + $X, ...)\n          - metavariable-regex:\n              metavariable: $Q\n              regex: '(?i).*(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|MERGE|WHERE|FROM|INTO|SET|VALUES|JOIN|UNION|GRANT|REVOKE).*'\n    metadata:\n      cwe: [\"CWE-89\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"sqli\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → Statement query sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.sql.taint.java\n    message: >-\n      Untrusted data flows into a SQL query via Statement. Use\n      PreparedStatement with parameterised queries instead.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Header/parameter enumerations are request data too: the\n          # Enumeration itself is the source; taint reaches values via\n          # nextElement(). Parameter/header NAMES are attacker-chosen.\n          - pattern: (HttpServletRequest $REQ).getHeaders(...)\n          - pattern: (HttpServletRequest $REQ).getHeaderNames()\n          - pattern: (HttpServletRequest $REQ).getParameterNames()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-propagators:\n      # Collection round-trips (measured FN class: same-method\n      # map.put(k, tainted) -> get(k) -> sink). put/add taint the\n      # receiver; semgrep then propagates receiver taint through get.\n      # Key-insensitive by engine design — recall-side over-taint on a\n      # different key is adjudicated downstream (gate/validation), the\n      # honest asymmetry for a detector.\n      - pattern: $M.put($K, $V)\n        from: $V\n        to: $M\n      - pattern: $M.add($V)\n        from: $V\n        to: $M\n    pattern-sinks:\n      - pattern-either:\n          # Statement — always string-based, no parameterisation\n          - pattern: (Statement $STMT).executeQuery($Q)\n          - pattern: (Statement $STMT).executeUpdate($Q)\n          - pattern: (Statement $STMT).execute($Q)\n          # String concat into query (catches format patterns)\n          - pattern: (Statement $STMT).executeQuery($Q + $X)\n          - pattern: (Statement $STMT).executeUpdate($Q + $X)\n          - pattern: (Statement $STMT).execute($Q + $X)\n      # Tainted SQL text handed to prepare — a constant '?' query is\n      # the safe form and carries no taint; concatenated SQL prepared\n      # then executed is injectable despite the PreparedStatement type.\n      - patterns:\n          - pattern-either:\n              - pattern: (Connection $C).prepareStatement($Q, ...)\n              - pattern: (Connection $C).prepareCall($Q, ...)\n              # FQN-declared locals: semgrep type matching is syntactic\n              - pattern: (java.sql.Connection $C).prepareStatement($Q, ...)\n              - pattern: (java.sql.Connection $C).prepareCall($Q, ...)\n          - focus-metavariable: $Q\n      # JdbcTemplate — focus on $Q prevents FPs on parameterised bind args\n      - patterns:\n          - pattern-either:\n              - pattern: (JdbcTemplate $JT).queryForObject($Q, ...)\n              - pattern: (JdbcTemplate $JT).queryForList($Q, ...)\n              - pattern: (JdbcTemplate $JT).queryForMap($Q, ...)\n              - pattern: (JdbcTemplate $JT).query($Q, ...)\n              - pattern: (JdbcTemplate $JT).update($Q, ...)\n              - pattern: (JdbcTemplate $JT).execute($Q)\n          - focus-metavariable: $Q\n      # Distinctive Spring-JDBC method names, untyped receiver: the\n      # receiver is often a cross-file static field whose type\n      # semgrep cannot resolve syntactically; these names are unique\n      # enough to stand alone. Generic names (query/update/execute)\n      # deliberately stay type-gated above.\n      - patterns:\n          - pattern-either:\n              - pattern: $RECV.queryForObject($Q, ...)\n              - pattern: $RECV.queryForList($Q, ...)\n              - pattern: $RECV.queryForMap($Q, ...)\n              - pattern: $RECV.queryForRowSet($Q, ...)\n              - pattern: $RECV.batchUpdate($Q, ...)\n          - focus-metavariable: $Q\n      # Untrusted data concatenated onto SQL-shaped text is the\n      # CWE-89 anti-pattern regardless of the executing API's type —\n      # anchors on the SQL grammar, not the receiver.\n      - patterns:\n          - pattern: '\"$SQL\" + $X'\n          - metavariable-regex:\n              metavariable: $SQL\n              regex: (?i)^(select|insert|update|delete)\\b.*\n          - focus-metavariable: $X\n    metadata:\n      cwe: [\"CWE-89\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"sqli\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → DB query sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.sql.taint.javascript\n    message: >-\n      Untrusted data flows into a SQL query. Use parameterised queries\n      or prepared statements instead of string interpolation.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      # Named DB libraries — specific enough to avoid non-DB FPs\n      - patterns:\n          - pattern: $KNEX.raw($Q, ...)\n          - focus-metavariable: $Q\n      - patterns:\n          - pattern: knex.raw($Q, ...)\n          - focus-metavariable: $Q\n      - patterns:\n          - pattern: sequelize.query($Q, ...)\n          - focus-metavariable: $Q\n      - patterns:\n          - pattern: $DB.prepare($Q)\n          - focus-metavariable: $Q\n      # String concat in query position — SQL keyword in $Q prevents\n      # FPs on non-SQL .query() calls (cache, search, etc.)\n      - patterns:\n          - pattern-either:\n              - pattern: $CONN.query($Q + $X, ...)\n              - pattern: $POOL.query($Q + $X, ...)\n              - pattern: $CLIENT.query($Q + $X, ...)\n              - pattern: $DB.exec($Q + $X)\n          - metavariable-regex:\n              metavariable: $Q\n              regex: '(?i).*(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|MERGE|WHERE|FROM|INTO|SET|VALUES|JOIN|UNION|GRANT|REVOKE).*'\n      # Template-literal query construction in query position. The $Q\n      # regex requires a quoted/backtick literal opening with SQL text,\n      # so identifier names containing SQL words never match; taint can\n      # only reach a template literal through ${...} interpolation, so\n      # parameterised literals without interpolation stay clean.\n      - patterns:\n          - pattern-either:\n              - pattern: $CONN.query($Q, ...)\n              - pattern: $CONN.execute($Q, ...)\n          - metavariable-regex:\n              metavariable: $Q\n              regex: '(?is)^[`\"''].*\\b(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TRUNCATE|MERGE|UNION|GRANT|REVOKE)\\b.*'\n          - focus-metavariable: $Q\n      # Assignment-then-call form: the query text is built into a\n      # variable (template literal or concat) and handed to .query()\n      # later. $Q carries no SQL text to anchor on, so the receiver\n      # name is the FP control — only DB-shaped receivers qualify.\n      - patterns:\n          - pattern-either:\n              - pattern: $DBOBJ.query($Q, ...)\n              - pattern: $DBOBJ.execute($Q, ...)\n          - metavariable-regex:\n              metavariable: $DBOBJ\n              regex: '(?i)^(conn(ection)?|client|pool|db|database|sql|mysql|pg|pgpool|dbconn|dbpool)[0-9_]*$'\n          - focus-metavariable: $Q\n    metadata:\n      cwe: [\"CWE-89\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"sqli\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-034",
      "name": "RAPTOR 原始规则 injection/ssti-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/ssti-taint.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → template-from-string sinks (SSTI)\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ssti.taint.python\n    message: >-\n      Untrusted data flows into a template constructor or from_string API.\n      User-controlled template source is code execution via SSTI. Use\n      render_template with a file path and pass user data as context variables.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      # Jinja2 — Template() from string\n      - patterns:\n          - pattern: jinja2.Template($SRC)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: Template($SRC)\n          - focus-metavariable: $SRC\n      # Jinja2 — Environment.from_string()\n      - patterns:\n          - pattern: $ENV.from_string($SRC)\n          - focus-metavariable: $SRC\n      # Flask render_template_string (also covered in XSS, but SSTI is\n      # the higher-severity classification)\n      - patterns:\n          - pattern: render_template_string($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: flask.render_template_string($SRC, ...)\n          - focus-metavariable: $SRC\n      # Mako\n      - patterns:\n          - pattern: mako.template.Template($SRC)\n          - focus-metavariable: $SRC\n      # Django template from string\n      - patterns:\n          - pattern: django.template.Template($SRC)\n          - focus-metavariable: $SRC\n    metadata:\n      cwe: [\"CWE-1336\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ssti\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → template.Parse sinks (SSTI)\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ssti.taint.go\n    message: >-\n      Untrusted data flows into template.Parse(). Both text/template and\n      html/template allow arbitrary actions when the template source is\n      attacker-controlled. Load templates from files, not user input.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      # text/template and html/template — Parse from user input\n      - patterns:\n          - pattern: $TPL.Parse($SRC)\n          - focus-metavariable: $SRC\n      # template.Must(template.New(\"\").Parse(...))\n      - patterns:\n          - pattern: template.Must($TPL.Parse($SRC))\n          - focus-metavariable: $SRC\n    metadata:\n      cwe: [\"CWE-1336\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ssti\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → template engine sinks (SSTI)\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ssti.taint.java\n    message: >-\n      Untrusted data flows into a template engine as template source.\n      User-controlled templates allow arbitrary code execution. Load\n      templates from files, not user input.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      # Freemarker — Template from reader containing user input\n      - patterns:\n          - pattern: new Template($NAME, new StringReader($SRC), ...)\n          - focus-metavariable: $SRC\n      # Velocity — evaluate with user-controlled template string\n      - patterns:\n          - pattern: Velocity.evaluate($CTX, $W, $TAG, $SRC)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: (VelocityEngine $VE).evaluate($CTX, $W, $TAG, $SRC)\n          - focus-metavariable: $SRC\n      # Thymeleaf — process with user-controlled template name/source\n      - patterns:\n          - pattern: (TemplateEngine $TE).process($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: (SpringTemplateEngine $TE).process($SRC, ...)\n          - focus-metavariable: $SRC\n    metadata:\n      cwe: [\"CWE-1336\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ssti\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → template sinks (SSTI)\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.ssti.taint.javascript\n    message: >-\n      Untrusted data flows into a template engine as template source.\n      User-controlled templates allow arbitrary code execution. Load\n      templates from files, not user input.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      # EJS — render from string\n      - patterns:\n          - pattern: ejs.render($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: ejs.compile($SRC, ...)\n          - focus-metavariable: $SRC\n      # Pug — render from string\n      - patterns:\n          - pattern: pug.render($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: pug.compile($SRC, ...)\n          - focus-metavariable: $SRC\n      # Handlebars — compile from string\n      - patterns:\n          - pattern: Handlebars.compile($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: Handlebars.precompile($SRC, ...)\n          - focus-metavariable: $SRC\n      # Nunjucks — renderString from user input\n      - patterns:\n          - pattern: nunjucks.renderString($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: $NUNJUCKS.renderString($SRC, ...)\n          - focus-metavariable: $SRC\n      # dot.js / underscore templates\n      - patterns:\n          - pattern: doT.template($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: $UNDERSCORE.template($SRC, ...)\n          - focus-metavariable: $SRC\n    metadata:\n      cwe: [\"CWE-1336\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"ssti\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-035",
      "name": "RAPTOR 原始规则 injection/xpath-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/xpath-taint.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet request data → XPath expression sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.xpath.taint.java\n    message: >-\n      Untrusted data flows into an XPath expression. Use parameterised\n      XPath (XPathVariableResolver) or escape the value before\n      concatenating it into the expression.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n    pattern-propagators:\n      - pattern: $M.put($K, $V)\n        from: $V\n        to: $M\n      - pattern: $M.add($V)\n        from: $V\n        to: $M\n    pattern-sinks:\n      # javax.xml.xpath — compile/evaluate take the expression string.\n      # Both simple and FQN typed spellings.\n      - patterns:\n          - pattern: (XPath $XP).compile($E)\n          - focus-metavariable: $E\n      - patterns:\n          - pattern: (javax.xml.xpath.XPath $XP).compile($E)\n          - focus-metavariable: $E\n      - patterns:\n          - pattern: (XPath $XP).evaluate($E, ...)\n          - focus-metavariable: $E\n      - patterns:\n          - pattern: (javax.xml.xpath.XPath $XP).evaluate($E, ...)\n          - focus-metavariable: $E\n    pattern-sanitizers:\n      - pattern: ESAPI.encoder().encodeForXPath(...)\n      - pattern: org.owasp.esapi.ESAPI.encoder().encodeForXPath(...)\n    metadata:\n      cwe: [\"CWE-643\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"xpath\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-036",
      "name": "RAPTOR 原始规则 injection/xss.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/injection/xss.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → unsafe HTML output sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.xss.taint.python\n    message: >-\n      Untrusted data flows into an HTML response without escaping. Use\n      context-aware output encoding or a templating engine with auto-escaping.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          # Django mark_safe — marks string as safe HTML, bypassing auto-escape\n          - pattern: mark_safe($X)\n          - pattern: django.utils.safestring.mark_safe($X)\n          # Jinja2 Markup — same effect as mark_safe\n          - pattern: Markup($X)\n          - pattern: markupsafe.Markup($X)\n          # Flask render_template_string — renders user input as a Jinja2 template\n          - pattern: render_template_string($X, ...)\n          - pattern: flask.render_template_string($X, ...)\n          # Raw HTML responses\n          - pattern: Response($X, ..., content_type=\"text/html\", ...)\n          - pattern: HttpResponse($X, ..., content_type=\"text/html\", ...)\n      # Django HttpResponse without an explicit content_type defaults\n      # to text/html — tainted body is XSS. Explicit non-HTML types\n      # (application/json, text/plain, ...) are excluded.\n      - patterns:\n          - pattern-either:\n              - pattern: HttpResponse($X, ...)\n              - pattern: django.http.HttpResponse($X, ...)\n          - pattern-not: HttpResponse(..., content_type=$CT, ...)\n          - pattern-not: django.http.HttpResponse(..., content_type=$CT, ...)\n          - focus-metavariable: $X\n    pattern-sanitizers:\n      - pattern: html.escape(...)\n      - pattern: markupsafe.escape(...)\n      - pattern: bleach.clean(...)\n    metadata:\n      cwe: [\"CWE-79\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"xss\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → unsafe HTML output sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.xss.taint.go\n    message: >-\n      Untrusted data flows into an HTML response without escaping. Use\n      html/template (auto-escaping) instead of text/template, or call\n      template.HTMLEscapeString() before writing.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      - pattern-either:\n          # template type-casts — bypass html/template auto-escaping\n          - pattern: template.HTML($X)\n          - pattern: template.JS($X)\n          - pattern: template.CSS($X)\n          - pattern: template.HTMLAttr($X)\n    pattern-sanitizers:\n      - pattern: template.HTMLEscapeString(...)\n      - pattern: html.EscapeString(...)\n    metadata:\n      cwe: [\"CWE-79\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"xss\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → unsafe HTML output sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.xss.taint.java\n    message: >-\n      Untrusted data flows into an HTML response without escaping. Use a\n      context-aware encoder such as OWASP Java Encoder or a templating engine\n      with auto-escaping.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          # Multi-value / map spellings of the same parameter data\n          # (measured FN class: getParameterMap cases missed by both\n          # engines; getParameterValues chains missed on the semgrep\n          # side).\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Header/parameter enumerations are request data; taint\n          # reaches values via nextElement(). Names are attacker-chosen.\n          - pattern: (HttpServletRequest $REQ).getHeaders(...)\n          - pattern: (HttpServletRequest $REQ).getHeaderNames()\n          - pattern: (HttpServletRequest $REQ).getParameterNames()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-propagators:\n      # Collection round-trips (measured FN class: same-method\n      # map.put(k, tainted) -> get(k) -> sink). put/add taint the\n      # receiver; semgrep then propagates receiver taint through get.\n      # Key-insensitive by engine design — recall-side over-taint on a\n      # different key is adjudicated downstream (gate/validation), the\n      # honest asymmetry for a detector.\n      - pattern: $M.put($K, $V)\n        from: $V\n        to: $M\n      - pattern: $M.add($V)\n        from: $V\n        to: $M\n      # Array-initializer element flow: Object[] obj = {\"a\", bar}\n      # taints the array (the printf/format varargs vector and the\n      # exec args/env vector share this seam).\n      - pattern: $T[] $A = {..., $V, ...}\n        from: $V\n        to: $A\n    pattern-sinks:\n      - pattern-either:\n          # Servlet response writer\n          - pattern: (HttpServletResponse $RESP).getWriter().write($X)\n          - pattern: (HttpServletResponse $RESP).getWriter().write($X, ...)\n          - pattern: (HttpServletResponse $RESP).getWriter().println($X)\n          - pattern: (HttpServletResponse $RESP).getWriter().print($X)\n          - pattern: (HttpServletResponse $RESP).getOutputStream().write(...)\n          - pattern: (HttpServletResponse $RESP).getWriter().format(...)\n          - pattern: (HttpServletResponse $RESP).getWriter().printf(...)\n          - pattern: (PrintWriter $PW).format(...)\n          - pattern: (PrintWriter $PW).printf(...)\n          # FQN-declared PrintWriter locals are a distinct spelling to\n          # semgrep's syntactic type matcher (no import to normalise\n          # against) — same sink set.\n          - pattern: (java.io.PrintWriter $PW).format(...)\n          - pattern: (java.io.PrintWriter $PW).printf(...)\n          - pattern: (java.io.PrintWriter $PW).write($X)\n          - pattern: (java.io.PrintWriter $PW).println($X)\n          - pattern: (java.io.PrintWriter $PW).print($X)\n          # Servlet response output\n          - pattern: (PrintWriter $PW).write($X)\n          - pattern: (PrintWriter $PW).println($X)\n          - pattern: (PrintWriter $PW).print($X)\n    pattern-sanitizers:\n      # HTML-body context encoders only: the sinks above are response-body\n      # writes, so forHtml/forHtmlContent/escapeHtml4/htmlEscape/\n      # encodeForHTML neutralise them (forHtmlAttribute over-encodes — a\n      # safe superset). JavaScript/CSS/URL encoders are deliberately NOT\n      # listed: they do not neutralise HTML-body injection and would\n      # suppress real findings.\n      - pattern: StringEscapeUtils.escapeHtml4(...)\n      - pattern: HtmlUtils.htmlEscape(...)\n      - pattern: Encode.forHtml(...)\n      - pattern: Encode.forHtmlContent(...)\n      - pattern: Encode.forHtmlAttribute(...)\n      - pattern: org.owasp.encoder.Encode.forHtml(...)\n      # OWASP ESAPI, both the chained singleton and a typed Encoder ref.\n      # The fully-qualified chain is a distinct spelling to semgrep's\n      # syntactic matcher (no import to normalise against when the code\n      # writes org.owasp.esapi.ESAPI inline) — same accepted sanitizer.\n      - pattern: ESAPI.encoder().encodeForHTML(...)\n      - pattern: org.owasp.esapi.ESAPI.encoder().encodeForHTML(...)\n      - pattern: (Encoder $ENC).encodeForHTML(...)\n    metadata:\n      cwe: [\"CWE-79\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"xss\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → unsafe HTML sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.injection.xss.taint.javascript\n    message: >-\n      Untrusted data flows into an HTML response or DOM sink without\n      sanitisation. Use a context-aware encoder or DOMPurify.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          # DOM sinks (client-side or SSR)\n          - pattern: $EL.innerHTML = $X\n          - pattern: document.write($X)\n          - pattern: document.writeln($X)\n          # jQuery\n          - pattern: $EL.html($X)\n          # React — explicit escape hatch\n          - pattern: \"dangerouslySetInnerHTML = {__html: $X}\"\n          # Express — res.send() of a string body defaults to\n          # text/html; res.write() streams the raw body. Both reflect\n          # tainted request data as markup.\n          - pattern: $RES.send($X)\n          - pattern: $RES.write($X)\n    pattern-sanitizers:\n      - pattern: DOMPurify.sanitize(...)\n      - pattern: xss(...)\n      - pattern: sanitizeHtml(...)\n    metadata:\n      cwe: [\"CWE-79\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"injection\", \"xss\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-037",
      "name": "RAPTOR 原始规则 java/java-security.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/java/java-security.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Java — pattern: insecure pseudo-random number generator\n  # ---------------------------------------------------------------------------\n  - id: raptor.java.insecure-random\n    message: >-\n      java.util.Random is a predictable PRNG unsuitable for\n      security-sensitive operations (tokens, keys, nonces). Use\n      java.security.SecureRandom instead.\n    languages: [java]\n    severity: HIGH\n    pattern-either:\n      - pattern: new Random(...)\n      - pattern: new java.util.Random(...)\n      - pattern: Math.random()\n    metadata:\n      cwe: [\"CWE-330\"]\n      owasp_top_10: [\"A2:2021-Cryptographic Failures\"]\n      tags: [\"security\", \"java\", \"random\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — pattern: cookie security flags explicitly disabled\n  # ---------------------------------------------------------------------------\n  - id: raptor.java.insecure-cookie-secure-false\n    message: >-\n      Cookie Secure flag explicitly set to false — the cookie will be sent\n      over unencrypted HTTP, exposing it to network sniffing. Call\n      setSecure(true).\n    languages: [java]\n    severity: HIGH\n    pattern: $COOKIE.setSecure(false)\n    metadata:\n      cwe: [\"CWE-614\"]\n      tags: [\"security\", \"java\", \"cookie\"]\n\n  - id: raptor.java.insecure-cookie-httponly-false\n    message: >-\n      Cookie HttpOnly flag explicitly set to false — the cookie is\n      accessible to client-side JavaScript, enabling session theft via XSS.\n      Call setHttpOnly(true).\n    languages: [java]\n    severity: HIGH\n    pattern: $COOKIE.setHttpOnly(false)\n    metadata:\n      cwe: [\"CWE-1004\"]\n      tags: [\"security\", \"java\", \"cookie\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: Spring MVC redirect open redirect\n  # ---------------------------------------------------------------------------\n  - id: raptor.java.spring-redirect\n    message: >-\n      Untrusted data flows into a Spring MVC \"redirect:\" view name,\n      enabling open redirect attacks. Validate the redirect target against\n      an allowlist of trusted URLs.\n    languages: [java]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      - patterns:\n          - pattern: |\n              \"redirect:\" + $URL\n          - focus-metavariable: $URL\n    metadata:\n      cwe: [\"CWE-601\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"java\", \"open-redirect\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params -> filesystem path sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.java.path-traversal\n    message: >-\n      Untrusted data flows into a filesystem path operation, enabling\n      directory traversal. Validate and canonicalise the path, then verify\n      it stays within the intended base directory.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      - patterns:\n          - pattern: new File($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: new FileInputStream($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: new FileOutputStream($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: new FileReader($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: Paths.get($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: Paths.get($PATH, ...)\n          - focus-metavariable: $PATH\n    metadata:\n      cwe: [\"CWE-22\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"java\", \"path-traversal\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-038",
      "name": "RAPTOR 原始规则 java/trust-boundary.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/java/trust-boundary.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet request data -> session / application-scope writes\n  #\n  # CWE-501 trust boundary violation: data from the untrusted request zone\n  # stored where downstream consumers assume it has been validated (session\n  # and servlet-context attributes). Both the attribute key and value count —\n  # a tainted key poisons the trusted namespace just as a tainted value does,\n  # so no focus-metavariable is used.\n  #\n  # No pattern-sanitizers on purpose: the idioms that genuinely establish\n  # trust (allowlist validation, canonicalisation-then-check) are\n  # branch-shaped and cannot be soundly expressed as taint-mode sanitizers\n  # without name-guessing false-negative risk. Guard adequacy is adjudicated\n  # downstream (Z3 prescreen / LLM validation), matching the SSRF rules'\n  # posture.\n  # ---------------------------------------------------------------------------\n  - id: raptor.java.trust-boundary-session-write\n    message: >-\n      Untrusted request data is stored in the session or servlet context\n      without validation — code reading these attributes typically treats\n      them as trusted (CWE-501 trust boundary violation). Validate against\n      an allowlist before crossing the boundary.\n    languages: [java]\n    severity: MEDIUM\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getParameterValues(...)\n          - pattern: (HttpServletRequest $REQ).getParameterMap()\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getCookies()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          # Header/parameter enumerations are request data; taint\n          # reaches values via nextElement(). Names are attacker-chosen.\n          - pattern: (HttpServletRequest $REQ).getHeaders(...)\n          - pattern: (HttpServletRequest $REQ).getHeaderNames()\n          - pattern: (HttpServletRequest $REQ).getParameterNames()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-propagators:\n      # Collection round-trips (measured FN class: same-method\n      # map.put(k, tainted) -> get(k) -> sink). put/add taint the\n      # receiver; semgrep then propagates receiver taint through get.\n      # Key-insensitive by engine design — recall-side over-taint on a\n      # different key is adjudicated downstream (gate/validation), the\n      # honest asymmetry for a detector.\n      - pattern: $M.put($K, $V)\n        from: $V\n        to: $M\n      - pattern: $M.add($V)\n        from: $V\n        to: $M\n    pattern-sinks:\n      - pattern-either:\n          # Session writes, including the chained request.getSession() form\n          # (type inference cannot always resolve the chain's return type).\n          - pattern: (HttpSession $SESS).setAttribute(...)\n          - pattern: (HttpSession $SESS).putValue(...)\n          - pattern: (HttpServletRequest $REQ).getSession().setAttribute(...)\n          - pattern: (HttpServletRequest $REQ).getSession(...).setAttribute(...)\n          - pattern: (HttpServletRequest $REQ).getSession().putValue(...)\n          - pattern: (HttpServletRequest $REQ).getSession(...).putValue(...)\n          # Application scope, including the chained accessor form\n          - pattern: (ServletContext $CTX).setAttribute(...)\n          - pattern: getServletContext().setAttribute(...)\n    metadata:\n      cwe: [\"CWE-501\"]\n      owasp_top_10: [\"A4:2021-Insecure Design\"]\n      tags: [\"security\", \"java\", \"trust-boundary\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-039",
      "name": "RAPTOR 原始规则 javascript/js-security.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/javascript/js-security.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # JavaScript/TypeScript — pattern: Express cookie with security flags disabled\n  # ---------------------------------------------------------------------------\n  - id: raptor.js.insecure-cookie-secure-false\n    message: >-\n      Express cookie Secure flag explicitly set to false — the cookie will\n      be sent over unencrypted HTTP, exposing it to network sniffing. Set\n      secure: true.\n    languages: [javascript, typescript]\n    severity: HIGH\n    pattern: |\n      $RES.cookie($NAME, $VALUE, {..., secure: false, ...})\n    metadata:\n      cwe: [\"CWE-614\"]\n      tags: [\"security\", \"javascript\", \"cookie\"]\n\n  - id: raptor.js.insecure-cookie-httponly-false\n    message: >-\n      Express cookie httpOnly flag explicitly set to false — the cookie is\n      accessible to client-side JavaScript, enabling session theft via XSS.\n      Set httpOnly: true.\n    languages: [javascript, typescript]\n    severity: HIGH\n    pattern: |\n      $RES.cookie($NAME, $VALUE, {..., httpOnly: false, ...})\n    metadata:\n      cwe: [\"CWE-1004\"]\n      tags: [\"security\", \"javascript\", \"cookie\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript/TypeScript — taint: web sources -> filesystem path sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.js.path-traversal\n    message: >-\n      Untrusted data flows into a filesystem path operation, enabling\n      directory traversal. path.join does NOT prevent \"../\" traversal above\n      the base directory. Validate and sanitise the path component.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: path.join($BASE, $PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: fs.readFile($PATH, ...)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: fs.readFileSync($PATH, ...)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: fs.writeFile($PATH, ...)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: fs.writeFileSync($PATH, ...)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: fs.createReadStream($PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: fs.createWriteStream($PATH)\n          - focus-metavariable: $PATH\n    metadata:\n      cwe: [\"CWE-22\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"javascript\", \"path-traversal\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-040",
      "name": "RAPTOR 原始规则 logging/logs-secrets.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/logging/logs-secrets.yaml",
          "content": "rules:\n  # Pre-fix the patterns matched only exact literals (\"... password: \"\n  # matched the literal three-dots string; receivers were hardcoded\n  # `logger`/`log`) — effectively dead on real code (U12-F103). The\n  # rule now keys on a secret-shaped key prefix (`password:`,\n  # `token=`, ...) inside the format/message literal of any standard\n  # logging method, with the value concatenated, %-formatted, or\n  # passed as a format argument.\n  - id: raptor.logging.secrets.plaintext\n    message: Logging may contain secrets (password, token, key); mask before logging.\n    languages: [python, java, javascript]\n    severity: MEDIUM\n    patterns:\n      - pattern-either:\n          - pattern: $LOG.$METHOD(\"=~/(?i)(password|passwd|pwd|secret|token|api[_-]?key|credential)\\s*[:=]/\" + $X, ...)\n          - pattern: $LOG.$METHOD(\"=~/(?i)(password|passwd|pwd|secret|token|api[_-]?key|credential)\\s*[:=]/\" % $X, ...)\n          - pattern: $LOG.$METHOD(\"=~/(?i)(password|passwd|pwd|secret|token|api[_-]?key|credential)\\s*[:=]/\", $X, ...)\n      - metavariable-regex:\n          metavariable: $METHOD\n          regex: ^(trace|debug|info|warn|warning|error|critical|exception|log|fatal)$\n    metadata:\n      cwe: [\"CWE-532\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-041",
      "name": "RAPTOR 原始规则 php/argument-injection.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/argument-injection.yaml",
          "content": "rules:\n  # CWE-88: argument injection — request data lands inside a shell\n  # command string with no per-argument quoting. escapeshellcmd is\n  # deliberately NOT a sanitizer: it neutralizes shell metacharacters\n  # for the command as a whole but leaves spaces and leading dashes\n  # untouched, so a value placed in argument position can still smuggle\n  # extra options/arguments (\"-oProxyCommand=...\", \"--include=/etc/*\").\n  # Only escapeshellarg (single argument, fully quoted) or a numeric\n  # cast neutralizes argument boundaries.\n  #\n  # Known FP modes:\n  #   - Values validated by means the rule cannot see (ctype_alnum\n  #     guard, preg_match allowlist in an early-return branch) still\n  #     fire — guard-shaped validation is invisible to taint mode.\n  #   - Overlaps CWE-78 command injection on purpose: an unquoted\n  #     tainted value is both; reviews emitting either class get a\n  #     verifying chain.\n  # Known FN modes:\n  #   - escapeshellarg clears taint, but a quoted standalone value in\n  #     OPTION position (\"-oProxyCommand=...\") is still argument\n  #     injection when the program treats leading-dash words as\n  #     options — the sanitizer neutralizes word splitting, not the\n  #     callee's option parsing. Stated residual, not expressible\n  #     without knowing the callee's argv contract.\n  #   - Taint through helper indirection (a getter function wrapping\n  #     the superglobal read) is invisible to single-function taint.\n  - id: raptor.php.argument-injection.exec-family\n    mode: taint\n    languages: [php]\n    severity: HIGH\n    message: >\n      Request data is concatenated into a shell command string without\n      escapeshellarg. Even under escapeshellcmd, spaces and leading\n      dashes survive, so the attacker can append extra arguments or\n      options to the invoked program (argument injection). Quote each\n      value with escapeshellarg or avoid the shell (proc_open with an\n      argument array).\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n    pattern-sanitizers:\n      - pattern: escapeshellarg(...)\n      - pattern: intval(...)\n      - pattern: (int) $X\n      - pattern: (float) $X\n    pattern-sinks:\n      - pattern: exec(...)\n      - pattern: system(...)\n      - pattern: passthru(...)\n      - pattern: shell_exec(...)\n      - pattern: popen(...)\n      # proc_open with an argv ARRAY bypasses the shell entirely (no\n      # word splitting, no metacharacters) — it is this rule's own\n      # recommended remediation and must not fire. Only the\n      # string-command form is a sink; the other sink functions are\n      # string-only by signature.\n      - patterns:\n          - pattern: proc_open($CMD, ...)\n          - pattern-not: proc_open([...], ...)\n          - pattern-not: proc_open(array(...), ...)\n    metadata:\n      cwe: [\"CWE-88\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-042",
      "name": "RAPTOR 原始规则 php/attr-encoding.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/attr-encoding.yaml",
          "content": "rules:\n  # CWE-116: improper encoding for the output context — the\n  # single-quoted-attribute residual of htmlspecialchars. A flags\n  # argument without ENT_QUOTES leaves the single quote unencoded, so\n  # a value emitted right after a ...=' attribute opener can close the\n  # attribute and add event-handler attributes. Both rules key on the\n  # string literal IMMEDIATELY concatenated before the call ending in\n  # an attribute opener — echoing into text content stays clean.\n  #\n  # Flagless htmlspecialchars($x) is deliberately NOT matched: since\n  # PHP 8.1 the default flags include ENT_QUOTES, so a flagless call\n  # is only unsafe on older runtimes — flagging it would FP on every\n  # modern codebase (known FN on legacy PHP instead).\n  #\n  # Known FP modes:\n  #   - The attribute opener and the encoded value assembled in\n  #     different statements (sprintf templates, heredoc) are missed\n  #     (FN); conversely a literal that merely ENDS with ='/=\" outside\n  #     real HTML (e.g. building a config line) would fire (FP) —\n  #     both bounded by requiring the explicit non-ENT_QUOTES\n  #     constant expression.\n  - id: raptor.php.attr-encoding.single-quote-attr\n    languages: [php]\n    severity: MEDIUM\n    message: >\n      htmlspecialchars without ENT_QUOTES leaves single quotes\n      unencoded, but the value is emitted into a single-quoted\n      attribute (literal ends with ='). The attacker closes the\n      attribute and injects event handlers. Pass ENT_QUOTES.\n    patterns:\n      - pattern: $LIT . htmlspecialchars($X, $FLAGS, ...)\n      - metavariable-regex:\n          metavariable: $LIT\n          regex: .*='\"$\n      - metavariable-regex:\n          metavariable: $FLAGS\n          regex: ^(?!.*ENT_QUOTES)ENT_\\w+(\\s*\\|\\s*ENT_\\w+)*$\n    metadata:\n      cwe: [\"CWE-116\"]\n  - id: raptor.php.attr-encoding.noquotes-double-attr\n    languages: [php]\n    severity: MEDIUM\n    message: >\n      htmlspecialchars with ENT_NOQUOTES encodes neither quote\n      character, but the value is emitted into a double-quoted\n      attribute (literal ends with =\"). The attacker closes the\n      attribute and injects event handlers. Pass ENT_QUOTES.\n    patterns:\n      - pattern: $LIT . htmlspecialchars($X, $FLAGS, ...)\n      - metavariable-regex:\n          metavariable: $LIT\n          regex: .*=\"'$\n      # ENT_NOQUOTES present, nothing that re-enables double-quote\n      # encoding (ENT_QUOTES or ENT_COMPAT) OR-ed in.\n      - metavariable-regex:\n          metavariable: $FLAGS\n          regex: ^(?=.*ENT_NOQUOTES)(?!.*ENT_QUOTES)(?!.*ENT_COMPAT)ENT_\\w+(\\s*\\|\\s*ENT_\\w+)*$\n    metadata:\n      cwe: [\"CWE-116\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-043",
      "name": "RAPTOR 原始规则 php/attr-xss.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/attr-xss.yaml",
          "content": "rules:\n  # CWE-79: reflected XSS, attribute-context subset — request data\n  # emitted into a single-quoted or unquoted HTML attribute with NO\n  # output encoding at all. One taint rule, three sink spellings:\n  #   1. concatenation after a single-quoted attribute opener — a\n  #      double-quote-delimited literal whose content opens ...=' and\n  #      never closes it, immediately followed by `.` and the value;\n  #   2. the same for an unquoted attribute opener (literal ends\n  #      attr= with its single quotes BALANCED — unbalanced tails\n  #      belong to shape 1);\n  #   3. double-quoted string INTERPOLATION in an echo/print\n  #      statement: \"<font color='$c'>\" / '{$_POST[...]}' with the\n  #      interpolation directly in the single-quoted attribute opener\n  #      position.\n  # An embedded quote or whitespace in the value closes the attribute\n  # and adds event-handler attributes — htmlspecialchars alone does\n  # not help in the unquoted context, which is why the fix is\n  # ENT_QUOTES plus a quoted attribute.\n  #\n  # Shape note (load-bearing, do not \"simplify\" back): the\n  # concatenation sinks are text-level (pattern-regex), not the AST\n  # shape `$LIT . $V`. The AST shape enumerates operand splits of a\n  # flattened concatenation chain, which is superlinear on 100+-term\n  # chains — past semgrep's default per-rule-per-file timeout, so a\n  # whole-pack scan silently STRIPPED this rule from exactly the\n  # concat-heavy files it targets. The text anchor scans flat and\n  # also covers openers mid-chain (a leading expression before the\n  # opener literal needs no separate pattern). The literal-content\n  # classes are newline-bounded, so an OPENER LITERAL never spans\n  # lines, and only whitespace may sit between literal, dot, and\n  # value — that whitespace may span lines (dot-continuation across\n  # lines still fires), while a comment in between is a pinned\n  # boundary shape.\n  #\n  # Division of labour: ANY htmlspecialchars/htmlentities call\n  # (qualified or not) clears taint here — the encoded-but-wrong-flags\n  # residual (ENT_COMPAT / ENT_NOQUOTES into a quoted attribute) is\n  # php/attr-encoding.yaml's (CWE-116) job, so the two rules never\n  # double-claim one shape.\n  #\n  # Known FP modes:\n  #   - The concatenation sinks are expression-level, not echo-bound:\n  #     a tainted value concatenated after an attribute-opener-shaped\n  #     literal fires even when the result never reaches output —\n  #     bounded by requiring a <tag prefix in the literal (a config\n  #     line ending in = stays silent).\n  #   - The text-level sinks match opener-shaped character runs\n  #     anywhere in a line, including inside a longer string's\n  #     CONTENT (a code sample embedded in a string) — a tainted\n  #     expression must still land inside the matched range for a\n  #     finding, which bounds the mode to concatenations adjacent to\n  #     such text.\n  #   - The interpolation sink is string-granular: it requires an\n  #     interpolation directly after a single-quoted attribute opener\n  #     and taint somewhere in the string, but does not prove they\n  #     are the SAME slot — a string with a safe '$var' in opener\n  #     position and the tainted variable elsewhere still fires.\n  # Sanitizer note: ANY htmlspecialchars call clears taint, flagged\n  #   or flagless — since PHP 8.1 the default flags include\n  #   ENT_QUOTES, so flagging the flagless call would FP on every\n  #   modern codebase (the php/attr-encoding.yaml precedent).\n  #\n  # Scope pins: an opener is one double-quote-delimited literal with\n  #   no embedded escapes (the php/attr-encoding.yaml delimiter\n  #   restriction); the value arrives by direct concatenation or by\n  #   interpolation in ONE echoed/printed string; taint is\n  #   single-function; double-quoted attributes and text content\n  #   belong to the generic echo-XSS class, which this rule does not\n  #   claim. The negative fixture carries out-of-scope shape pins for\n  #   each boundary — each flips when a matching shape lands.\n  - id: raptor.php.attr-xss.attr-context\n    mode: taint\n    languages: [php]\n    severity: HIGH\n    message: >\n      Request data is emitted into a single-quoted or unquoted HTML\n      attribute with no output encoding. An embedded quote (or, in\n      the unquoted context, whitespace) closes the attribute and\n      injects event-handler attributes. Quote the attribute AND\n      encode with htmlspecialchars($v, ENT_QUOTES) at the emission\n      site.\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n    pattern-sanitizers:\n      - pattern-either:\n          - pattern: htmlspecialchars(...)\n          - pattern: \\htmlspecialchars(...)\n          - pattern: htmlentities(...)\n          - pattern: \\htmlentities(...)\n          - pattern: urlencode(...)\n          - pattern: \\urlencode(...)\n          - pattern: rawurlencode(...)\n          - pattern: \\rawurlencode(...)\n          - pattern: intval(...)\n          - pattern: \\intval(...)\n          - pattern: (int) $X\n    pattern-sinks:\n      # 1: single-quoted attribute opener literal, then `.` and the\n      # value (which must carry the taint).\n      - pattern-regex: '\"[^\"\\n]*<[a-zA-Z][^>\"\\n]*=''[^''\"\\n]*\"\\s*\\.\\s*\\S{1,120}'\n      # 2: unquoted attribute opener literal (single quotes balanced\n      # — an unclosed opener belongs to shape 1), then `.` and the\n      # value.\n      - pattern-regex: '\"(?:[^\"''\\n]|''[^''\\n]*'')*<[a-zA-Z](?:[^\"''>\\n]|''[^''\\n]*'')*[a-zA-Z0-9_-]=\"\\s*\\.\\s*\\S{1,120}'\n      # 3: interpolation in the single-quoted opener position of one\n      # echoed/printed double-quoted string.\n      - patterns:\n          - pattern-either:\n              - pattern: echo $S;\n              - pattern: print $S;\n          - metavariable-regex:\n              metavariable: $S\n              regex: ^\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\"$\n          - metavariable-regex:\n              metavariable: $S\n              regex: .*<[a-zA-Z][^>]*='[^']*\\{?\\$\n    metadata:\n      cwe: [\"CWE-79\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-044",
      "name": "RAPTOR 原始规则 php/crlf-injection.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/crlf-injection.yaml",
          "content": "rules:\n  # CWE-93: CRLF injection into protocol streams (SMTP/IMAP/NNTP/FTP\n  # command channels). Request data reaching a socket write without\n  # CR/LF neutralization lets the attacker terminate the current\n  # protocol command and append their own.\n  #\n  # Known FP/FN modes:\n  #   - Any str_replace/preg_replace call on the tainted path counts\n  #     as a sanitizer even when its arguments do not touch CR/LF, so\n  #     a no-op replace silences a real finding. That is a missed\n  #     finding and never a false confirmation of the code — and it\n  #     stays harmless only while CWE-93 is absent from the\n  #     gate-resolution coverage map (core/audit/tool_coverage.py):\n  #     silence classifies the claim dark there, never clean.\n  #   - A socket handle received as a function parameter or stored on\n  #     $this between methods (the mailer-class shape) is not\n  #     recognised, so those writes are missed (FN, not FP).\n  #   - header()/mail() response/header splitting is out of scope by\n  #     design — reviews tag it CWE-93 too, which is exactly why the\n  #     class must not claim coverage from this rule.\n  - id: raptor.php.crlf-injection.socket-write\n    mode: taint\n    languages: [php]\n    severity: HIGH\n    message: >\n      Request data flows into a socket write without CR/LF\n      neutralization. Embedded \"\\r\\n\" terminates the current protocol\n      command (SMTP/IMAP/NNTP/FTP) and injects attacker-chosen\n      commands into the stream. Strip or reject CR/LF\n      (e.g. str_replace([\"\\r\", \"\\n\"], '', $value)) before writing.\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n    pattern-sanitizers:\n      - pattern: str_replace(...)\n      - pattern: preg_replace(...)\n      - pattern: urlencode(...)\n      - pattern: rawurlencode(...)\n      - pattern: intval(...)\n      - pattern: (int) $X\n    pattern-sinks:\n      # fwrite/fputs count only when the handle is provably a network\n      # stream (opened in the same function): a plain fwrite to a file\n      # handle is log injection, a different class.\n      - patterns:\n          - pattern-either:\n              - pattern: fwrite($SOCK, ...)\n              - pattern: fputs($SOCK, ...)\n          - pattern-either:\n              - pattern-inside: |\n                  $SOCK = fsockopen(...);\n                  ...\n              - pattern-inside: |\n                  $SOCK = stream_socket_client(...);\n                  ...\n      # The socket_* API is sockets-only, no handle-origin proof needed.\n      - pattern: socket_write(...)\n      - pattern: socket_send(...)\n    metadata:\n      cwe: [\"CWE-93\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-045",
      "name": "RAPTOR 原始规则 php/include-injection.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/include-injection.yaml",
          "content": "rules:\n  # CWE-22: include-injection — cookie/request data concatenated or\n  # interpolated into an include/require(_once) path. Scoped to the\n  # code-inclusion sinks ONLY: a traversal into include executes the\n  # reached file (or a remote/wrapper URL where configuration allows),\n  # which is a code-execution class, not the read/write file-op\n  # traversal the generic CWE-22 file-op shapes cover — fopen/\n  # file_get_contents/readfile sinks are deliberately out of scope\n  # here so this rule never claims that ground.\n  #\n  # A constant directory prefix or a constant '.php' suffix does NOT\n  # neutralize: ../ climbs out of the prefix, and on legacy runtimes\n  # a %00/long-path trick — or simply targeting another in-tree .php\n  # file — defeats the suffix.\n  #\n  # Known FP modes:\n  #   - Sequence-stripping \"fixes\" (str_replace('..', '', $p) and\n  #     similar) still fire — DELIBERATE: single-pass stripping is\n  #     bypassable (....// survives one round), so clearing taint on\n  #     it would launder the classic broken remediation.\n  #   - A correct character-class allowlist rewrite\n  #     (preg_replace('/[^a-z0-9_]/', '', $p)) also still fires —\n  #     the pattern cannot read regex semantics, so it cannot tell\n  #     the safe rewrite from the bypassable strip. Guard-shaped\n  #     validation (preg_match allowlist in an aborting branch) is\n  #     likewise invisible.\n  #   - The in_array/array_key_exists/isset sanitizers are\n  #     by-side-effect and blind to haystack content and branch\n  #     polarity (the php/unsafe-reflection.yaml precedent).\n  #   - A tainted INDEX taints the element read: an UNCHECKED lookup\n  #     into a literal-keyed map (include $pages[$_GET['k']]) fires\n  #     even though the reachable values are the map's literals (an\n  #     unknown key includes null — a warning, not traversal). The\n  #     recommended form — the same map behind an array_key_exists\n  #     guard — is silent, so the remediation never re-fires.\n  # Sanitizer note: basename() clears taint — it removes the\n  #   traversal and stream-wrapper vectors that make this class\n  #   code-execution (the message still recommends an allowlist on\n  #   top for the remaining same-directory selection).\n  #\n  # Scope pins: taint is single-function, and the sinks are the\n  #   include/require family only (see the scoping note above). The\n  #   negative fixture carries out-of-scope shape pins for both\n  #   boundaries — each flips when a matching shape lands.\n  - id: raptor.php.include-injection.request-path\n    mode: taint\n    languages: [php]\n    severity: HIGH\n    message: >\n      Request data reaches an include/require path. Path traversal\n      sequences (or a stream wrapper, where configuration allows)\n      make the interpreter execute an attacker-chosen file — constant\n      prefixes and .php suffixes do not contain it. Resolve the value\n      through a literal-keyed allowlist map (or basename() plus an\n      allowlist) before including.\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n    pattern-sanitizers:\n      - pattern-either:\n          - pattern: basename(...)\n          - pattern: \\basename(...)\n          - pattern: intval(...)\n          - pattern: \\intval(...)\n          - pattern: (int) $X\n      - by-side-effect: true\n        patterns:\n          - pattern-either:\n              - pattern: in_array($V, ...)\n              - pattern: \\in_array($V, ...)\n              - pattern: array_key_exists($V, ...)\n              - pattern: \\array_key_exists($V, ...)\n              - pattern: isset($MAP[$V])\n          - focus-metavariable: $V\n    pattern-sinks:\n      - pattern: include $PATH;\n      - pattern: include_once $PATH;\n      - pattern: require $PATH;\n      - pattern: require_once $PATH;\n    metadata:\n      cwe: [\"CWE-22\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-046",
      "name": "RAPTOR 原始规则 php/open-redirect.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/open-redirect.yaml",
          "content": "rules:\n  # CWE-601: open redirect — a Location response header built from\n  # request-derived data. Sources are the request parameters plus the\n  # attacker-controlled $_SERVER members that commonly seed\n  # \"self\"-redirect URLs: HTTP_HOST and HTTP_X_FORWARDED_HOST (client\n  # header echoes — a host-header-derived base URL redirects to an\n  # attacker host), HTTP_REFERER (the redirect-back shape — the\n  # header is fully client-chosen), PHP_SELF (carries decoded\n  # PATH_INFO), REQUEST_URI and QUERY_STRING (raw request echoes).\n  #\n  # Sinks — header()/\\header() first arguments in four spellings,\n  # each anchored on a case-insensitive Location: literal (header\n  # names are case-insensitive): a literal-led concatenation, an\n  # interpolated \"Location: $x\" string, a sprintf('Location: %s', ..)\n  # build, and the one-hop variable form ($loc = 'Location: ' . ...;\n  # header($loc)). Every sink focuses the first argument, so taint in\n  # ANY OTHER argument (header('Location: /fixed', true, $code))\n  # never fires.\n  #\n  # Known FP modes:\n  #   - Guard-shaped validation is invisible to taint mode: a strict\n  #     equality/preg_match check on the value in an early-return\n  #     branch still fires. The in_array/array_key_exists/isset\n  #     sanitizers are by-side-effect and blind to haystack content\n  #     and branch polarity (the php/unsafe-reflection.yaml\n  #     precedent) — a membership check suppresses, a comparison\n  #     does not.\n  #   - urlencode/rawurlencode clear taint on the redirect TARGET\n  #     path assumption (an encoded value cannot introduce a scheme\n  #     or authority); a value encoded and used as the ENTIRE URL\n  #     would be a broken redirect, not a working open one.\n  # Scope pins: the anchor is one Location: literal in the first\n  #   argument (case-insensitive), at most one assignment hop away;\n  #   taint is single-function; non-Location redirects (Refresh:,\n  #   markup, script) are output-encoding shapes, not response-header\n  #   shapes. The negative fixture carries out-of-scope shape pins\n  #   for each boundary — each flips when a matching shape lands.\n  - id: raptor.php.open-redirect.header-location\n    mode: taint\n    languages: [php]\n    severity: MEDIUM\n    message: >\n      A Location response header is built from request-derived data\n      (request parameter, host/referer header, or request-URI echo),\n      so the redirect target is attacker-influenced (open redirect —\n      phishing bounce, and token leakage via Referer). Compare the\n      value against a fixed allowlist of local paths, or send a\n      server-configured absolute base URL.\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n          - patterns:\n              - pattern: $_SERVER[$KEY]\n              - metavariable-regex:\n                  metavariable: $KEY\n                  regex: ^['\"](HTTP_HOST|HTTP_X_FORWARDED_HOST|HTTP_REFERER|PHP_SELF|REQUEST_URI|QUERY_STRING)['\"]$\n    pattern-sanitizers:\n      - pattern-either:\n          - pattern: urlencode(...)\n          - pattern: \\urlencode(...)\n          - pattern: rawurlencode(...)\n          - pattern: \\rawurlencode(...)\n          - pattern: intval(...)\n          - pattern: \\intval(...)\n          - pattern: (int) $X\n      - by-side-effect: true\n        patterns:\n          - pattern-either:\n              - pattern: in_array($V, ...)\n              - pattern: \\in_array($V, ...)\n              - pattern: array_key_exists($V, ...)\n              - pattern: \\array_key_exists($V, ...)\n              - pattern: isset($MAP[$V])\n          - focus-metavariable: $V\n    pattern-sinks:\n      # Literal-led concatenation or interpolated string as the first\n      # argument.\n      - patterns:\n          - pattern-either:\n              - pattern: header($ARG, ...)\n              - pattern: \\header($ARG, ...)\n          - focus-metavariable: $ARG\n          - metavariable-regex:\n              metavariable: $ARG\n              regex: '^[''\"](?i:location)\\s*:'\n      # sprintf-built first argument (focused like the others: taint\n      # in a later header() argument must not ride on it).\n      - patterns:\n          - pattern-either:\n              - pattern: header($F, ...)\n              - pattern: \\header($F, ...)\n          - focus-metavariable: $F\n          - metavariable-pattern:\n              metavariable: $F\n              patterns:\n                - pattern: sprintf($LIT, ...)\n                - metavariable-regex:\n                    metavariable: $LIT\n                    regex: '^[''\"](?i:location)\\s*:'\n      # One-hop variable: the Location string is assembled into a\n      # local and passed by name.\n      - patterns:\n          - pattern-inside: |\n              $LOC = $LIT . $REST;\n              ...\n          - pattern-either:\n              - pattern: header($LOC, ...)\n              - pattern: \\header($LOC, ...)\n          - focus-metavariable: $LOC\n          - metavariable-regex:\n              metavariable: $LIT\n              regex: '^[''\"](?i:location)\\s*:'\n    metadata:\n      cwe: [\"CWE-601\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-047",
      "name": "RAPTOR 原始规则 php/unsafe-reflection.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/unsafe-reflection.yaml",
          "content": "rules:\n  # CWE-470: unsafe reflection — attacker-selected code unit. Request\n  # data used as a variable-function name ($fn()), a callable handed\n  # to call_user_func/call_user_func_array, a dynamically instantiated\n  # class (new $cls), or a variable method name ($obj->$m()).\n  #\n  # Known FP modes:\n  #   - The in_array/array_key_exists/isset sanitizers are\n  #     by-side-effect: ANY membership check on the tainted value\n  #     downstream-clears it, including a check against an\n  #     attacker-influencable array (rare, but a check against\n  #     array_keys($_POST) would clear taint it should not).\n  #   - A deny-style check (in_array against a blocklist, taken\n  #     branch aborts on MATCH rather than on miss) also clears taint\n  #     — the rule cannot see branch polarity.\n  #   Both modes suppress findings on code that performs *some*\n  #   membership check; neither invents a finding on unchecked code.\n  - id: raptor.php.unsafe-reflection.tainted-callable\n    mode: taint\n    languages: [php]\n    severity: HIGH\n    message: >\n      Request data is used to select the code to execute (variable\n      function, call_user_func callable, dynamic class instantiation,\n      or variable method name). An attacker can invoke any defined\n      function/class, e.g. system or an autoloadable gadget class.\n      Route through a fixed allowlist (in_array($v, [...], true) or a\n      literal-keyed dispatch map) before the call.\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n    pattern-sanitizers:\n      - by-side-effect: true\n        patterns:\n          - pattern-either:\n              - pattern: in_array($V, ...)\n              - pattern: array_key_exists($V, ...)\n              - pattern: isset($MAP[$V])\n          - focus-metavariable: $V\n    pattern-sinks:\n      - patterns:\n          - pattern: $FN(...)\n          - focus-metavariable: $FN\n      - patterns:\n          - pattern-either:\n              - pattern: call_user_func($FN, ...)\n              - pattern: call_user_func_array($FN, ...)\n          - focus-metavariable: $FN\n      - patterns:\n          - pattern: new $CLS(...)\n          - focus-metavariable: $CLS\n      - patterns:\n          - pattern: $OBJ->$M(...)\n          - focus-metavariable: $M\n    metadata:\n      cwe: [\"CWE-470\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-048",
      "name": "RAPTOR 原始规则 php/unserialize-taint.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/unserialize-taint.yaml",
          "content": "rules:\n  # CWE-502: deserialization of untrusted data — request data reaching\n  # unserialize() with no class restriction. A serialized object\n  # string instantiates any autoloadable class, so magic methods\n  # (__wakeup/__destruct/__toString) on any loaded gadget run with\n  # attacker-chosen properties. Direct superglobal arguments, nested\n  # array-field reads, and single-assignment hops are all in scope\n  # (intraprocedural taint); decoding wrappers (base64_decode and\n  # friends) propagate taint through to the sink; the fully-qualified\n  # (\\unserialize) and error-suppressed (@unserialize) spellings\n  # match.\n  #\n  # Two-arg calls: the options form is matched ONLY in its cheapest\n  # dangerous spelling — a literal 'allowed_classes' => true (any\n  # bracket syntax, extra keys allowed). 'allowed_classes' => false\n  # is this rule's own recommended remediation and stays silent.\n  #\n  # Known FP modes:\n  #   - Integrity checks the rule cannot see (an hash_equals/HMAC\n  #     guard branch before the call, a preg_match shape check) still\n  #     fire — guard-shaped validation is invisible to taint mode.\n  # Scope pins: taint is single-function, and options arrays\n  #   participate only in the literal-true spelling above. The\n  #   negative fixture carries out-of-scope shape pins for both\n  #   boundaries — each flips when a matching shape lands.\n  - id: raptor.php.unserialize-taint.request-data\n    mode: taint\n    languages: [php]\n    severity: HIGH\n    message: >\n      Request data reaches unserialize() with no class restriction. A\n      serialized-object payload instantiates any autoloadable class\n      and its magic methods run with attacker-chosen properties\n      (object injection). Pass a strict class allowlist\n      (unserialize($v, ['allowed_classes' => false])) or move the\n      format to json_decode.\n    pattern-sources:\n      - pattern-either:\n          - pattern: $_GET[...]\n          - pattern: $_POST[...]\n          - pattern: $_REQUEST[...]\n          - pattern: $_COOKIE[...]\n    pattern-sinks:\n      - pattern-either:\n          - pattern: unserialize($DATA)\n          - pattern: \\unserialize($DATA)\n          - pattern: unserialize($DATA, [..., 'allowed_classes' => true, ...])\n          - pattern: \\unserialize($DATA, [..., 'allowed_classes' => true, ...])\n          - pattern: unserialize($DATA, array(..., 'allowed_classes' => true, ...))\n          - pattern: \\unserialize($DATA, array(..., 'allowed_classes' => true, ...))\n    metadata:\n      cwe: [\"CWE-502\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-049",
      "name": "RAPTOR 原始规则 php/weak-password-hash.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/weak-password-hash.yaml",
          "content": "rules:\n  # CWE-327: md5/sha1 as a password digest. Both are broken for\n  # authentication material: unsalted, GPU-friendly, rainbow-tabled.\n  # Anchored on password-shaped names on either side of the call —\n  # the argument (md5($password)) or the stored/compared lvalue\n  # ($row['password'] = sha1(...)) — so md5-as-checksum/etag/cache-key\n  # never fires.\n  #\n  # Known FP modes:\n  #   - Name-anchored: a password digested under a neutral name\n  #     ($input, $val) is missed (FN); a non-credential name carrying\n  #     a letter-bounded pass/pwd segment ($pass_count, $pwd_dir)\n  #     fires (FP). Letter-run continuations stay clean ($passthrough,\n  #     $bypassed).\n  #   - md5($password) used to derive a non-auth artifact (a legacy\n  #     mail-hash of the password) still fires — digesting a password\n  #     with md5 is the flagged act.\n  - id: raptor.php.weak-password-hash.arg\n    languages: [php]\n    severity: HIGH\n    message: >\n      A password is digested with md5/sha1. Both are unsalted,\n      fast, and precomputed-table friendly — offline recovery of user\n      passwords from a leaked table is practical. Use\n      password_hash()/password_verify().\n    patterns:\n      - pattern-either:\n          - pattern: md5($P)\n          - pattern: md5($P, ...)\n          - pattern: sha1($P)\n          - pattern: sha1($P, ...)\n          # hash()'s algo argument is case-insensitive at runtime\n          # (\"MD5\" == \"md5\"), so the match must be too; the regex\n          # keeps hash(\"sha256\", $password) out.\n          - patterns:\n              - pattern: hash($ALG, $P, ...)\n              - metavariable-regex:\n                  metavariable: $ALG\n                  regex: (?i)^[\"'](md5|sha1)[\"']$\n      # Lookarounds instead of \\b: underscores are word chars, so \\b\n      # never fires inside $user_password; a letter-boundary does.\n      - metavariable-regex:\n          metavariable: $P\n          regex: (?i).*(?<![a-z])(pass(word|wd|phrase)?|pwd)(?![a-z]).*\n    metadata:\n      cwe: [\"CWE-327\"]\n  - id: raptor.php.weak-password-hash.store\n    languages: [php]\n    severity: HIGH\n    message: >\n      A password-named field is assigned an md5/sha1 digest. Both are\n      unsalted, fast, and precomputed-table friendly — offline\n      recovery of user passwords from a leaked table is practical.\n      Use password_hash()/password_verify().\n    patterns:\n      - pattern-either:\n          - pattern: $LVAL = md5(...);\n          - pattern: $LVAL = sha1(...);\n          - pattern: $OBJ->$LVAL = md5(...);\n          - pattern: $OBJ->$LVAL = sha1(...);\n          - pattern: $ARR[$LVAL] = md5(...);\n          - pattern: $ARR[$LVAL] = sha1(...);\n      # Lookarounds instead of \\b: underscores are word chars, so \\b\n      # never fires inside $password_hash; a letter-boundary does.\n      - metavariable-regex:\n          metavariable: $LVAL\n          regex: (?i).*(?<![a-z])(pass(word|wd)?|pwd)(?![a-z]).*\n    metadata:\n      cwe: [\"CWE-327\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-050",
      "name": "RAPTOR 原始规则 php/weak-prng-token.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/php/weak-prng-token.yaml",
          "content": "rules:\n  # CWE-338: non-cryptographic PRNG output stored under a\n  # security-material name (token/secret/nonce/otp/csrf/api key/\n  # session id/activation/reset/pad). mt_rand/rand/uniqid/lcg_value\n  # are seedable/predictable; str_shuffle and array_rand draw from\n  # them. The name anchor is the precision gate — a bare mt_rand()\n  # (jitter, sampling, shard selection) never fires, only one whose\n  # result is stored as security material. Hashing the PRNG output\n  # (md5(uniqid(rand(), true))) does not add entropy; the deep\n  # expression match (<... ...>) sees through those wrappers.\n  #\n  # Anchors use letter-run lookarounds, not \\b: underscores are word\n  # chars so \\b never fires inside $reset_token, while a bare\n  # substring test fires inside $preset/$notepad. (?<![a-z])reset\n  # matches $reset_token but not $preset; pad(?![a-z]) matches\n  # $pad_bytes but not $keypad_layout.\n  #\n  # Known FP/FN modes:\n  #   - Name-anchored: security material stored under a neutral name\n  #     ($val, $r), returned directly without assignment, or hopped\n  #     through an intermediate variable before the named store is\n  #     missed (FN, executable examples in the negative fixture).\n  #     Bare \"key\" is deliberately NOT an anchor — $cache_key/\n  #     $array_key would swamp the signal; apikey/api_key carry the\n  #     security sense.\n  - id: raptor.php.weak-prng-token.var\n    languages: [php]\n    severity: HIGH\n    message: >\n      Security material is derived from a non-cryptographic PRNG\n      (mt_rand/rand/uniqid/lcg_value/str_shuffle/array_rand). These\n      sequences are predictable from a small number of outputs or a\n      guessable seed, so the token/secret is forgeable. Use\n      random_bytes()/random_int() (CSPRNG).\n    patterns:\n      - pattern: $VAR = <... $RAND(...) ...>;\n      - metavariable-regex:\n          metavariable: $RAND\n          regex: ^(mt_rand|rand|uniqid|lcg_value|str_shuffle|array_rand)$\n      # Fully anchored to the plain-variable shape ($name only): the\n      # $VAR metavariable also binds property/array lvalues, and an\n      # unanchored regex would double-report the shapes the property\n      # and array-store rules own — and defeat the property rule's\n      # deliberate 'pad' exclusion via $obj->pad.\n      - metavariable-regex:\n          metavariable: $VAR\n          regex: (?i)^\\$[a-z0-9_]*(?<![a-z])(token|secret|nonce|otp|csrf|apikey|api_key|sessid|session_id|activation|reset|pad)(?![a-z])[a-z0-9_]*$\n    metadata:\n      cwe: [\"CWE-338\"]\n  - id: raptor.php.weak-prng-token.property\n    languages: [php]\n    severity: HIGH\n    message: >\n      Security material is derived from a non-cryptographic PRNG\n      (mt_rand/rand/uniqid/lcg_value/str_shuffle/array_rand). These\n      sequences are predictable from a small number of outputs or a\n      guessable seed, so the token/secret is forgeable. Use\n      random_bytes()/random_int() (CSPRNG).\n    patterns:\n      - pattern: $OBJ->$PROP = <... $RAND(...) ...>;\n      - metavariable-regex:\n          metavariable: $RAND\n          regex: ^(mt_rand|rand|uniqid|lcg_value|str_shuffle|array_rand)$\n      - metavariable-regex:\n          metavariable: $PROP\n          regex: (?i).*(?<![a-z])(token|secret|nonce|otp|csrf|apikey|api_key|sessid|session_id|activation|reset)(?![a-z]).*\n    metadata:\n      cwe: [\"CWE-338\"]\n  # The canonical CSRF shape stores into an array slot, not a\n  # variable: $_SESSION['csrf_token'] = md5(mt_rand()). The key\n  # literal carries the anchor.\n  - id: raptor.php.weak-prng-token.array-store\n    languages: [php]\n    severity: HIGH\n    message: >\n      Security material is derived from a non-cryptographic PRNG\n      (mt_rand/rand/uniqid/lcg_value/str_shuffle/array_rand). These\n      sequences are predictable from a small number of outputs or a\n      guessable seed, so the token/secret is forgeable. Use\n      random_bytes()/random_int() (CSPRNG).\n    patterns:\n      - pattern: $ARR[$KEY] = <... $RAND(...) ...>;\n      - metavariable-regex:\n          metavariable: $RAND\n          regex: ^(mt_rand|rand|uniqid|lcg_value|str_shuffle|array_rand)$\n      - metavariable-regex:\n          metavariable: $KEY\n          regex: (?i).*(?<![a-z])(token|secret|nonce|otp|csrf|apikey|api_key|sessid|session_id|activation|reset)(?![a-z]).*\n    metadata:\n      cwe: [\"CWE-338\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-051",
      "name": "RAPTOR 原始规则 python/python-security.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/python/python-security.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — pattern: insecure tempfile.mktemp (TOCTOU race)\n  # ---------------------------------------------------------------------------\n  - id: raptor.python.insecure-tempfile\n    message: >-\n      tempfile.mktemp() is vulnerable to a TOCTOU race — another process\n      can create the file between name generation and open. Use\n      tempfile.mkstemp() or tempfile.NamedTemporaryFile() instead.\n    languages: [python]\n    severity: HIGH\n    pattern: tempfile.mktemp(...)\n    metadata:\n      cwe: [\"CWE-377\"]\n      tags: [\"security\", \"python\", \"tempfile\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — pattern: weak SSL/TLS context configuration\n  # ---------------------------------------------------------------------------\n  - id: raptor.python.weak-ssl-context-unverified\n    message: >-\n      ssl._create_unverified_context() disables certificate verification,\n      allowing man-in-the-middle attacks. Use ssl.create_default_context()\n      which enables verification by default.\n    languages: [python]\n    severity: CRITICAL\n    pattern: ssl._create_unverified_context(...)\n    metadata:\n      cwe: [\"CWE-295\"]\n      owasp_top_10: [\"A7:2021-Identification and Authentication Failures\"]\n      tags: [\"security\", \"python\", \"ssl\"]\n\n  - id: raptor.python.weak-ssl-no-hostname-check\n    message: >-\n      Disabling check_hostname allows connections to hosts that do not\n      match the certificate subject, enabling man-in-the-middle attacks.\n    languages: [python]\n    severity: CRITICAL\n    pattern: $CTX.check_hostname = False\n    metadata:\n      cwe: [\"CWE-295\"]\n      owasp_top_10: [\"A7:2021-Identification and Authentication Failures\"]\n      tags: [\"security\", \"python\", \"ssl\"]\n\n  - id: raptor.python.weak-ssl-cert-none\n    message: >-\n      Setting verify_mode to CERT_NONE disables TLS certificate\n      verification, allowing man-in-the-middle attacks. Use\n      ssl.CERT_REQUIRED.\n    languages: [python]\n    severity: CRITICAL\n    pattern: $CTX.verify_mode = ssl.CERT_NONE\n    metadata:\n      cwe: [\"CWE-295\"]\n      owasp_top_10: [\"A7:2021-Identification and Authentication Failures\"]\n      tags: [\"security\", \"python\", \"ssl\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — taint: web sources -> filesystem path sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.python.path-join-traversal\n    message: >-\n      Untrusted data flows into a filesystem path operation. os.path.join\n      discards the base directory when the second argument is an absolute\n      path, and \"../\" components traverse above the base. Use\n      os.path.basename() to strip directory components, or validate the\n      resolved path stays within the intended base.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern: os.path.join($BASE, $PATH)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: open($PATH, ...)\n          - focus-metavariable: $PATH\n      - patterns:\n          - pattern: open($PATH)\n          - focus-metavariable: $PATH\n    pattern-sanitizers:\n      - pattern: os.path.basename(...)\n    metadata:\n      cwe: [\"CWE-22\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"python\", \"path-traversal\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Python — pattern: header value interpolated into a composed URL authority\n  # ---------------------------------------------------------------------------\n  - id: raptor.python.header-url-boundary-injection\n    message: >-\n      A header-derived value is interpolated directly after \"://\" in a\n      composed URL. A \"/\", \"?\", or \"#\" inside the value shifts the\n      path/query/fragment boundaries when the composite is re-parsed\n      (urlsplit/urlparse), so the parsed path diverges from the routed path\n      and path-based authorization can be bypassed. Validate the value for\n      delimiter characters (or percent-encode it) before composing.\n    languages: [python]\n    severity: MEDIUM\n    patterns:\n      - pattern-regex: 'f[\"''][^\"'']*://\\{[^}]*header[^}]*\\}'\n    metadata:\n      cwe: [\"CWE-20\", \"CWE-601\"]\n      tags: [\"security\", \"python\", \"url\", \"boundary-injection\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-052",
      "name": "RAPTOR 原始规则 secrets/hardcoded-api-key.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/secrets/hardcoded-api-key.yaml",
          "content": "rules:\n  - id: raptor.secrets.hardcoded.api_key.regex\n    message: Hard-coded secret or key literal detected; consider using a secret manager.\n    languages: [python, javascript, java, go]\n    severity: HIGH\n    pattern-either:\n      - pattern-regex: 'AKIA[0-9A-Z]{16}'\n      - pattern-regex: 'sk_live_[0-9A-Za-z_-]{20,}'\n      - pattern-regex: '-----BEGIN (?:PRIVATE|RSA PRIVATE) KEY-----'\n    metadata:\n      cwe: [\"CWE-798\"]\n      asvs: [\"V6.6\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-053",
      "name": "RAPTOR 原始规则 sinks/open-redirect.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/sinks/open-redirect.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → redirect sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.open-redirect.taint.python\n    message: >-\n      Untrusted data flows into a redirect target. Validate the destination\n      against a strict allowlist of internal paths or domains. Do not rely on\n      URL parsing alone — urlparse does not validate the destination.\n    languages: [python]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          # Django\n          - pattern: redirect($URL)\n          - pattern: django.shortcuts.redirect($URL)\n          - pattern: HttpResponseRedirect($URL)\n          - pattern: HttpResponsePermanentRedirect($URL)\n          # Flask\n          - pattern: flask.redirect($URL)\n          # Starlette / FastAPI\n          - pattern: RedirectResponse($URL, ...)\n          - pattern: RedirectResponse(url=$URL, ...)\n          # Generic — manually setting Location header\n          - pattern: \"Response(..., headers={\\\"Location\\\": $URL}, ...)\"\n    metadata:\n      cwe: [\"CWE-601\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"redirect\", \"open-redirect\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → redirect sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.open-redirect.taint.go\n    message: >-\n      Untrusted data flows into a redirect target. Validate the destination\n      against a strict allowlist of internal paths or domains.\n    languages: [go]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      - pattern-either:\n          # net/http\n          - pattern: http.Redirect($W, $R, $URL, ...)\n          # gin\n          - pattern: $CTX.Redirect($CODE, $URL)\n          # echo\n          - pattern: $CTX.Redirect($CODE, $URL)\n          # Manual header set\n          - pattern: $W.Header().Set(\"Location\", $URL)\n    metadata:\n      cwe: [\"CWE-601\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"redirect\", \"open-redirect\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → redirect sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.open-redirect.taint.java\n    message: >-\n      Untrusted data flows into a redirect target. Validate the destination\n      against a strict allowlist of internal paths or domains.\n    languages: [java]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletResponse $RESP).sendRedirect($URL)\n          # Manual Location header\n          - pattern: (HttpServletResponse $RESP).setHeader(\"Location\", $URL)\n          - pattern: (HttpServletResponse $RESP).addHeader(\"Location\", $URL)\n          # Spring MVC — redirect: prefix in view name\n          # Cannot match \"redirect:\" + tainted as a pattern — the Spring\n          # redirect: prefix in returned view strings is a template-level\n          # construct that semgrep cannot trace. Listed as a known limitation.\n    metadata:\n      cwe: [\"CWE-601\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"redirect\", \"open-redirect\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa params → redirect sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.open-redirect.taint.javascript\n    message: >-\n      Untrusted data flows into a redirect target. Validate the destination\n      against a strict allowlist of internal paths or domains.\n    languages: [javascript, typescript]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          # Express\n          - pattern: $RES.redirect($URL)\n          - pattern: $RES.redirect($CODE, $URL)\n          # Manual Location header\n          - pattern: $RES.set(\"Location\", $URL)\n          - pattern: $RES.setHeader(\"Location\", $URL)\n          - pattern: \"$RES.writeHead($CODE, {..., \\\"Location\\\": $URL, ...})\"\n          # Koa\n          - pattern: $CTX.redirect($URL)\n          # window.location (client-side)\n          - pattern: window.location = $URL\n          - pattern: window.location.href = $URL\n          - pattern: window.location.assign($URL)\n          - pattern: window.location.replace($URL)\n    metadata:\n      cwe: [\"CWE-601\"]\n      owasp_top_10: [\"A1:2021-Broken Access Control\"]\n      tags: [\"security\", \"redirect\", \"open-redirect\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-054",
      "name": "RAPTOR 原始规则 sinks/ssrf-wrappers.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/sinks/ssrf-wrappers.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # SSRF variants that need explicit taint PROPAGATORS: the tainted value\n  # reaches the outbound-request sink through a mutable builder/collection\n  # (side-effect propagation), which semgrep's default expression\n  # propagation does not track. These complement sinks/ssrf.yaml, which\n  # covers the direct source→sink flows.\n  #\n  # No pattern-sanitizers on purpose: real SSRF guards are branch-style\n  # host/scheme allowlist checks, which taint-mode sanitizers cannot\n  # express faithfully — a name-based sanitizer here would silently\n  # suppress true positives. Guard sufficiency is adjudicated downstream\n  # (Z3 charset prescreen / LLM validation), not in the rule.\n  # ---------------------------------------------------------------------------\n\n  # Java — request parameter appended into a StringBuilder that becomes\n  # the request URL. $SB.append($X) taints $SB by side effect.\n  - id: raptor.web.ssrf.stringbuilder.java\n    message: >-\n      Untrusted request data is appended into a string builder that is used\n      as an outbound request URL. Enforce a strict URL allowlist before the\n      request is issued.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (WebRequest $REQ).getParameter(...)\n    pattern-propagators:\n      - pattern: $SB.append($X)\n        from: $X\n        to: $SB\n    pattern-sinks:\n      - pattern-either:\n          - pattern: new URL($SB.toString())\n          - pattern: new URI($SB.toString())\n          - pattern: new HttpGet($SB.toString())\n          - pattern: new HttpPost($SB.toString())\n          - pattern: (RestTemplate $RT).getForObject($SB.toString(), ...)\n          - pattern: (RestTemplate $RT).getForEntity($SB.toString(), ...)\n          - pattern: (RestTemplate $RT).exchange($SB.toString(), ...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\", \"propagator\"]\n\n  # JavaScript / TypeScript — tainted value written into a URL object via\n  # searchParams (side effect), then the URL object is fetched. Covers the\n  # \"attacker controls a query parameter of an otherwise-fixed URL\" shape\n  # only when the tainted value IS the whole URL via URL's first argument,\n  # and the searchParams side-effect shape for completeness of the builder\n  # pattern.\n  - id: raptor.web.ssrf.urlbuilder.javascript\n    message: >-\n      Untrusted request data flows into a URL object that is used for an\n      outbound request. Enforce a strict URL allowlist before the request\n      is issued.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      # Express — receiver-name anchored: a bare $REQ matches ANY\n      # object, so fully hardcoded code self-taints (same fix as the\n      # Express sources in sinks/ssrf.yaml).\n      - patterns:\n          - pattern-either:\n              - pattern: $REQ.query.$PROP\n              - pattern: $REQ.query[...]\n              - pattern: $REQ.params.$PROP\n              - pattern: $REQ.params[...]\n              - pattern: $REQ.body.$PROP\n              - pattern: $REQ.body[...]\n          - metavariable-regex:\n              metavariable: $REQ\n              regex: '(?i)^(req|request)$'\n    pattern-propagators:\n      - pattern: $U.searchParams.set($K, $V)\n        from: $V\n        to: $U\n      - pattern: $U.searchParams.append($K, $V)\n        from: $V\n        to: $U\n      - pattern: $U.href = $X\n        from: $X\n        to: $U\n    pattern-sinks:\n      - pattern-either:\n          - pattern: fetch($U, ...)\n          - pattern: axios.get($U, ...)\n          - pattern: axios.post($U, ...)\n          - pattern: http.get($U, ...)\n          - pattern: http.request($U, ...)\n          - pattern: https.get($U, ...)\n          - pattern: https.request($U, ...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\", \"propagator\"]\n\n  # Python — tainted URL fragment collected into a list that is joined into\n  # the request URL. $L.append($X) taints $L by side effect; \"\".join($L)\n  # then carries taint through the default call propagation.\n  - id: raptor.web.ssrf.listjoin.python\n    message: >-\n      Untrusted request data is accumulated into a sequence that is joined\n      into an outbound request URL. Enforce a strict URL allowlist before\n      the request is issued.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: request.GET[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST[...]\n          - pattern: request.POST.get(...)\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n    pattern-propagators:\n      - pattern: $L.append($X)\n        from: $X\n        to: $L\n      - pattern: $L.extend($X)\n        from: $X\n        to: $L\n      - pattern: $L.insert($I, $X)\n        from: $X\n        to: $L\n    pattern-sinks:\n      - patterns:\n          - pattern-either:\n              - pattern: requests.get($URL, ...)\n              - pattern: requests.post($URL, ...)\n              - pattern: requests.request($METHOD, $URL, ...)\n              - pattern: urllib.request.urlopen($URL, ...)\n              - pattern: httpx.get($URL, ...)\n              - pattern: httpx.post($URL, ...)\n          - pattern-not: flask.request.args.get(...)\n          - pattern-not: flask.request.form.get(...)\n          - pattern-not: request.GET.get(...)\n          - pattern-not: request.POST.get(...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\", \"propagator\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-055",
      "name": "RAPTOR 原始规则 sinks/ssrf.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/sinks/ssrf.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → HTTP client sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.ssrf.taint.python\n    message: >-\n      Untrusted data flows into an outbound HTTP request. Enforce a strict\n      URL allowlist or use a proxy with egress controls.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          # FastAPI / Starlette (function params are the source)\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n    pattern-sinks:\n      - patterns:\n          - pattern-either:\n              # requests\n              - pattern: requests.get($URL, ...)\n              - pattern: requests.post($URL, ...)\n              - pattern: requests.put($URL, ...)\n              - pattern: requests.delete($URL, ...)\n              - pattern: requests.patch($URL, ...)\n              - pattern: requests.head($URL, ...)\n              - pattern: requests.options($URL, ...)\n              - pattern: requests.request($METHOD, $URL, ...)\n              # urllib\n              - pattern: urllib.request.urlopen($URL, ...)\n              - pattern: urllib.request.Request($URL, ...)\n              # httpx\n              - pattern: httpx.get($URL, ...)\n              - pattern: httpx.post($URL, ...)\n              - pattern: httpx.put($URL, ...)\n              - pattern: httpx.delete($URL, ...)\n              - pattern: httpx.patch($URL, ...)\n              - pattern: httpx.head($URL, ...)\n              - pattern: httpx.options($URL, ...)\n              - pattern: httpx.request($METHOD, $URL, ...)\n              # Instance-method HTTP sinks (httpx.Client, aiohttp.ClientSession,\n              # requests.Session, urllib3.PoolManager). $OBJ.get() collides\n              # with dict.get() — LLM triage filters those. Source-expression\n              # collisions (flask.request.args.get etc.) excluded below.\n              - pattern: $CLIENT.get($URL, ...)\n              - pattern: $CLIENT.post($URL, ...)\n              - pattern: $CLIENT.put($URL, ...)\n              - pattern: $CLIENT.delete($URL, ...)\n              - pattern: $CLIENT.patch($URL, ...)\n              - pattern: $CLIENT.head($URL, ...)\n              - pattern: $CLIENT.options($URL, ...)\n              - pattern: $CLIENT.request($METHOD, $URL, ...)\n          # Exclude source expressions that collide with $CLIENT.get()\n          - pattern-not: flask.request.args.get(...)\n          - pattern-not: flask.request.form.get(...)\n          - pattern-not: request.GET.get(...)\n          - pattern-not: request.POST.get(...)\n          - pattern-not: os.environ.get(...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Go — taint: net/http handler params → HTTP client sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.ssrf.taint.go\n    message: >-\n      Untrusted data flows into an outbound HTTP request. Enforce a strict\n      URL allowlist or use a proxy with egress controls.\n    languages: [go]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          - pattern: $REQ.URL.Query().Get(...)\n          - pattern: $REQ.FormValue(...)\n          - pattern: $REQ.PostFormValue(...)\n          - pattern: $REQ.Header.Get(...)\n          - pattern: $REQ.PathValue(...)\n          # gin / echo — receiver-name anchored: a bare $CTX.Query(...)\n          # source also matches the .Query()/.Param() methods of stores,\n          # DB handles, and routers, tainting fully hardcoded data\n          # (self-taint; same fix as raptor.injection.sql.taint.go).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.Query(...)\n                  - pattern: $CTX.Param(...)\n                  - pattern: $CTX.PostForm(...)\n                  - pattern: $CTX.QueryParam(...)\n                  - pattern: $CTX.FormValue(...)\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context|ectx|gctx|cc)$'\n          # environment\n          - pattern: os.Getenv(...)\n          - pattern: os.Args[...]\n    pattern-sinks:\n      - patterns:\n          - pattern-either:\n              - pattern: http.Get($URL)\n              - pattern: http.Post($URL, ...)\n              - pattern: http.PostForm($URL, ...)\n              - pattern: http.Head($URL)\n              - pattern: http.NewRequest($METHOD, $URL, ...)\n              - pattern: http.NewRequestWithContext($CTX, $METHOD, $URL, ...)\n              - pattern: $CLIENT.Get($URL)\n              - pattern: $CLIENT.Post($URL, ...)\n              # exactly two args (url, data): net/http Client.PostForm.\n              # A trailing ... also matched gin's one-arg c.PostForm(key)\n              # — a source read — flagging the read itself as an SSRF\n              # request (source/sink self-overlap).\n              - pattern: $CLIENT.PostForm($URL, $DATA)\n              - pattern: $CLIENT.Head($URL)\n              - pattern: $CLIENT.Do($REQ)\n          # Exclude source expressions that collide with $CLIENT.Get()\n          - pattern-not: $REQ.URL.Query().Get(...)\n          - pattern-not: $REQ.Header.Get(...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → HTTP client sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.ssrf.taint.java\n    message: >-\n      Untrusted data flows into an outbound HTTP request. Enforce a strict\n      URL allowlist or use a proxy with egress controls.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          # Spring MVC (annotated params are the real source, but semgrep\n          # cannot match annotation-driven injection — these catch the\n          # manual-extraction fallback)\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      - pattern-either:\n          # java.net\n          - pattern: new URL($URL).openConnection(...)\n          - pattern: new URL($URL).openStream(...)\n          - pattern: new URI($URL)\n          - pattern: (HttpURLConnection $CONN).connect()\n          # java.net.http (Java 11+)\n          - pattern: HttpRequest.newBuilder().uri(...)\n          - pattern: HttpClient.newHttpClient().send(...)\n          # Apache HttpClient\n          - pattern: new HttpGet($URL)\n          - pattern: new HttpPost($URL)\n          - pattern: new HttpPut($URL)\n          - pattern: new HttpDelete($URL)\n          - pattern: new HttpHead($URL)\n          - pattern: new HttpPatch($URL)\n          # OkHttp\n          - pattern: new Request.Builder().url($URL)\n          # Spring RestTemplate / WebClient\n          - pattern: (RestTemplate $RT).getForObject($URL, ...)\n          - pattern: (RestTemplate $RT).getForEntity($URL, ...)\n          - pattern: (RestTemplate $RT).postForObject($URL, ...)\n          - pattern: (RestTemplate $RT).postForEntity($URL, ...)\n          - pattern: (RestTemplate $RT).exchange($URL, ...)\n          - pattern: WebClient.create($URL)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa/Hapi params → HTTP sinks\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.ssrf.taint.javascript\n    message: >-\n      Untrusted data flows into an outbound HTTP request. Enforce a strict\n      URL allowlist or use a proxy with egress controls.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n    pattern-sinks:\n      - pattern-either:\n          # fetch (Node 18+ / browser)\n          - pattern: fetch($URL, ...)\n          # axios\n          - pattern: axios.get($URL, ...)\n          - pattern: axios.post($URL, ...)\n          - pattern: axios.put($URL, ...)\n          - pattern: axios.delete($URL, ...)\n          - pattern: axios.patch($URL, ...)\n          - pattern: axios.head($URL, ...)\n          - pattern: \"axios.request({url: $URL, ...})\"\n          - pattern: axios($URL, ...)\n          # node-fetch (explicit import only — $FETCH($URL) is too broad)\n          # got\n          - pattern: got($URL, ...)\n          - pattern: got.get($URL, ...)\n          - pattern: got.post($URL, ...)\n          # superagent\n          - pattern: superagent.get($URL)\n          - pattern: superagent.post($URL)\n          # Node http/https\n          - pattern: http.get($URL, ...)\n          - pattern: http.request($URL, ...)\n          - pattern: https.get($URL, ...)\n          - pattern: https.request($URL, ...)\n          # undici\n          - pattern: undici.fetch($URL, ...)\n          - pattern: undici.request($URL, ...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      owasp_top_10: [\"A10:2021-Server-Side Request Forgery\"]\n      tags: [\"security\", \"ssrf\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Cloud metadata — all languages (pattern-only, no taint needed)\n  # Matches string literals containing cloud metadata IPs/hostnames.\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.ssrf.cloud-metadata\n    message: >-\n      Hardcoded cloud metadata endpoint. If this URL is constructed from\n      user input, it is a confirmed SSRF to the instance metadata service.\n    languages: [python, go, java, javascript, typescript]\n    severity: HIGH\n    pattern-regex: \"http://(169\\\\.254\\\\.169\\\\.254|metadata\\\\.google\\\\.internal|100\\\\.100\\\\.100\\\\.200)\"\n    metadata:\n      cwe: [\"CWE-918\"]\n      tags: [\"security\", \"ssrf\", \"cloud-metadata\"]\n\n  # ---------------------------------------------------------------------------\n  # Redirect-following — detect disabled redirect guards\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.ssrf.redirect-following.python\n    message: >-\n      httpx does not follow redirects by default; enabling\n      follow_redirects=True lets an SSRF via open redirect bypass URL\n      allowlists. Validate redirect targets or leave redirects off.\n    languages: [python]\n    severity: MEDIUM\n    # requests' allow_redirects=True is deliberately NOT flagged: it\n    # is the library default made explicit, not a behaviour change.\n    pattern: httpx.$FUNC($URL, ..., follow_redirects=True, ...)\n    metadata:\n      cwe: [\"CWE-918\"]\n      tags: [\"security\", \"ssrf\", \"redirect\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-056",
      "name": "RAPTOR 原始规则 web/prototype-pollution-implementation.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/web/prototype-pollution-implementation.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Prototype pollution in project-OWN merge/deep-set implementations —\n  # complements web/prototype-pollution.yaml, which covers library sinks\n  # (lodash.merge etc.).\n  #\n  # Join-mode note: a cross-file `mode: join` rule correlating a recursive\n  # merge DEFINITION with tainted CALL sites was built and tested against\n  # semgrep 1.172.0 and does not work: join-mode conditions resolve\n  # metavariables from each finding's `extra.metavars`, which current\n  # semgrep JSON output no longer populates (verified empirically — the\n  # model for the definition rule is created with no metavariable columns\n  # and condition evaluation raises AttributeError). Until upstream\n  # restores metavariable export for join mode, the correlation is\n  # unshippable; these single-file rules cover the intra-file cases.\n  # ---------------------------------------------------------------------------\n\n  # JS/TS — tainted KEY used in a nested computed assignment (deep-set).\n  # An attacker-controlled key path of [\"__proto__\", \"x\"] pollutes\n  # Object.prototype. The key, not the value, is the dangerous flow, so\n  # the sink focuses the key metavariables.\n  #\n  # No pattern-sanitizers: the real guard is a key check\n  # ($K === \"__proto__\" / hasOwnProperty), which is branch-style and not\n  # expressible as a taint-mode sanitizer without name-based guessing;\n  # guard sufficiency is adjudicated downstream.\n  - id: raptor.web.prototype-pollution.deep-set.javascript\n    message: >-\n      Untrusted data is used as a property key in a nested assignment. A\n      key path containing __proto__ or constructor.prototype pollutes\n      Object.prototype. Reject __proto__/constructor/prototype keys or use\n      a Map / Object.create(null) container.\n    languages: [javascript, typescript]\n    severity: HIGH\n    mode: taint\n    pattern-sources:\n      # Receiver-name anchored, mirroring the library-sink sibling\n      # (web/prototype-pollution.yaml): a bare $REQ.query/.body source\n      # matches those field names on ANY local object, tainting fully\n      # hardcoded data (self-taint).\n      - patterns:\n          - pattern-either:\n              - pattern: $REQ.query.$PROP\n              - pattern: $REQ.query[...]\n              - pattern: $REQ.params.$PROP\n              - pattern: $REQ.params[...]\n              - pattern: $REQ.body.$PROP\n              - pattern: $REQ.body[...]\n              - pattern: $REQ.headers[...]\n          - metavariable-regex:\n              metavariable: $REQ\n              regex: '(?i)^(req|request)$'\n    pattern-sinks:\n      - patterns:\n          - pattern: $OBJ[$K1][$K2] = $V\n          - focus-metavariable: $K1\n      - patterns:\n          - pattern: $OBJ[$K1][$K2] = $V\n          - focus-metavariable: $K2\n    metadata:\n      cwe: [\"CWE-1321\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"web\", \"prototype-pollution\", \"taint\"]\n\n  # JS/TS — recursive merge implementation with no __proto__ guard\n  # anywhere in its body. The definition itself is the risk surface (any\n  # caller passing parsed user JSON pollutes); pattern-not-regex excludes\n  # implementations that mention __proto__ / hasOwnProperty, the two\n  # canonical guard idioms. Object.keys is deliberately NOT excluded:\n  # JSON.parse yields an own __proto__ key that Object.keys enumerates,\n  # so iterating it guards nothing.\n  - id: raptor.web.prototype-pollution.unguarded-merge-impl.javascript\n    message: >-\n      Recursive merge implementation without a __proto__ /\n      hasOwnProperty guard. Any call site that passes attacker-influenced\n      objects pollutes Object.prototype. Skip __proto__, constructor and\n      prototype keys, or copy onto Object.create(null).\n    languages: [javascript, typescript]\n    severity: MEDIUM\n    patterns:\n      - pattern: |\n          function $F($T, $S) {\n            ...\n            $F($T[$K], $S[$K]);\n            ...\n          }\n      - pattern-not-regex: __proto__\n      - pattern-not-regex: hasOwnProperty\n    metadata:\n      cwe: [\"CWE-1321\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"web\", \"prototype-pollution\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-057",
      "name": "RAPTOR 原始规则 web/prototype-pollution.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/web/prototype-pollution.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # JavaScript / TypeScript — taint: Express/Koa sources → deep merge sinks\n  # CWE-1321: Prototype Pollution via user-controlled object merged into\n  # application objects.\n  # ---------------------------------------------------------------------------\n  - id: raptor.web.prototype-pollution.taint.javascript\n    message: >-\n      Untrusted data flows into a deep merge operation. An attacker can\n      inject __proto__ or constructor.prototype properties to pollute\n      Object.prototype, potentially leading to RCE or auth bypass.\n      Validate input keys or use Object.create(null) as the target.\n    languages: [javascript, typescript]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Express — receiver-name anchored: bare $REQ.query/.params/\n          # .body/.headers sources match those field names on any local\n          # object, tainting fully hardcoded data (self-taint).\n          - patterns:\n              - pattern-either:\n                  - pattern: $REQ.query\n                  - pattern: $REQ.query[...]\n                  - pattern: $REQ.query.$PROP\n                  - pattern: $REQ.params\n                  - pattern: $REQ.params[...]\n                  - pattern: $REQ.params.$PROP\n                  - pattern: $REQ.body\n                  - pattern: $REQ.body[...]\n                  - pattern: $REQ.body.$PROP\n                  - pattern: $REQ.headers[...]\n              - metavariable-regex:\n                  metavariable: $REQ\n                  regex: '(?i)^(req|request)$'\n          # Koa — receiver-name anchored (same self-taint shape as the\n          # Express block above).\n          - patterns:\n              - pattern-either:\n                  - pattern: $CTX.query\n                  - pattern: $CTX.query[...]\n                  - pattern: $CTX.query.$PROP\n                  - pattern: $CTX.params\n                  - pattern: $CTX.params[...]\n                  - pattern: $CTX.params.$PROP\n                  - pattern: $CTX.request.body\n                  - pattern: $CTX.request.body[...]\n              - metavariable-regex:\n                  metavariable: $CTX\n                  regex: '(?i)^(c|ctx|context)$'\n          # Generic\n          - pattern: process.env[...]\n          - pattern: process.env.$PROP\n          - pattern: process.argv[...]\n          # JSON.parse of request body — common intermediate. String\n          # literals excluded: JSON.parse('{\"a\": 1}') is fully hardcoded\n          # data, not attacker input.\n          - patterns:\n              - pattern: JSON.parse(...)\n              - pattern-not: JSON.parse(\"...\")\n    pattern-sinks:\n      # lodash merge / defaultsDeep — focus on $INPUT (the source object)\n      - patterns:\n          - pattern: lodash.merge($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      - patterns:\n          - pattern: _.merge($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      - patterns:\n          - pattern: lodash.defaultsDeep($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      - patterns:\n          - pattern: _.defaultsDeep($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      # Object.assign — shallow but still pollutes if __proto__ is a key\n      - patterns:\n          - pattern: Object.assign($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      # jQuery deep extend\n      - patterns:\n          - pattern: $.extend(true, $TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      # deepmerge library\n      - patterns:\n          - pattern: deepmerge($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      - patterns:\n          - pattern: merge($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n      # hoek.merge (hapi ecosystem)\n      - patterns:\n          - pattern: Hoek.merge($TARGET, $INPUT, ...)\n          - focus-metavariable: $INPUT\n    metadata:\n      cwe: [\"CWE-1321\"]\n      owasp_top_10: [\"A3:2021-Injection\"]\n      tags: [\"security\", \"web\", \"prototype-pollution\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "rule-058",
      "name": "RAPTOR 原始规则 xml/xxe.yaml",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Write",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 30000,
        "args": {
          "file_path": "/workspace/rules/xml/xxe.yaml",
          "content": "rules:\n  # ---------------------------------------------------------------------------\n  # Python — taint: web framework sources → XML parser sinks (XXE)\n  # ---------------------------------------------------------------------------\n  - id: raptor.xml.xxe.taint.python\n    message: >-\n      Untrusted data flows into an XML parser that resolves external entities.\n      Use defusedxml or set resolve_entities=False on lxml parsers.\n    languages: [python]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Django\n          - pattern: request.GET[...]\n          - pattern: request.POST[...]\n          - pattern: request.GET.get(...)\n          - pattern: request.POST.get(...)\n          - pattern: request.data[...]\n          - pattern: request.query_params[...]\n          # Flask\n          - pattern: flask.request.args[...]\n          - pattern: flask.request.args.get(...)\n          - pattern: flask.request.form[...]\n          - pattern: flask.request.form.get(...)\n          - pattern: flask.request.json[...]\n          - pattern: flask.request.get_json(...)\n          - pattern: flask.request.data\n          - pattern: flask.request.get_data(...)\n          # FastAPI / Starlette\n          - pattern: request.query_params[...]\n          - pattern: request.path_params[...]\n          # Generic\n          - pattern: input(...)\n          - pattern: os.environ[...]\n          - pattern: os.environ.get(...)\n          - pattern: sys.argv[...]\n          # File reads (XML from uploaded files / disk). Kept broad but\n          # in-memory buffers over string literals are excluded — that\n          # data is fully hardcoded.\n          - patterns:\n              - pattern: $F.read()\n              - pattern-not: io.StringIO(\"...\").read()\n              - pattern-not: io.BytesIO(\"...\").read()\n              - pattern-not: StringIO(\"...\").read()\n              - pattern-not: BytesIO(\"...\").read()\n    pattern-sinks:\n      # lxml — resolves external entities by default.\n      # pattern-not-inside excludes calls that pass a safe parser\n      # (resolve_entities=False) — the sanitizer on the parser object\n      # itself does not work in taint mode because it is not on the\n      # data-flow path.\n      - patterns:\n          - pattern: lxml.etree.parse($SRC, ...)\n          - pattern-not-inside: |\n              ...\n              $P = lxml.etree.XMLParser(..., resolve_entities=False, ...)\n              ...\n              lxml.etree.parse($SRC, $P)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: lxml.etree.fromstring($SRC, ...)\n          - pattern-not-inside: |\n              ...\n              $P = lxml.etree.XMLParser(..., resolve_entities=False, ...)\n              ...\n              lxml.etree.fromstring($SRC, $P)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: etree.parse($SRC, ...)\n          - pattern-not-inside: |\n              ...\n              $P = etree.XMLParser(..., resolve_entities=False, ...)\n              ...\n              etree.parse($SRC, $P)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: etree.fromstring($SRC, ...)\n          - pattern-not-inside: |\n              ...\n              $P = etree.XMLParser(..., resolve_entities=False, ...)\n              ...\n              etree.fromstring($SRC, $P)\n          - focus-metavariable: $SRC\n      # xml.etree.ElementTree — vulnerable with custom parser\n      - patterns:\n          - pattern: xml.etree.ElementTree.parse($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: ET.parse($SRC, ...)\n          - focus-metavariable: $SRC\n      # xml.sax — parses entities by default\n      - patterns:\n          - pattern: xml.sax.parseString($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: xml.sax.parse($SRC, ...)\n          - focus-metavariable: $SRC\n      # xml.dom.minidom\n      - patterns:\n          - pattern: xml.dom.minidom.parseString($SRC)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: minidom.parseString($SRC)\n          - focus-metavariable: $SRC\n      # xml.dom.pulldom\n      - patterns:\n          - pattern: xml.dom.pulldom.parseString($SRC, ...)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: pulldom.parseString($SRC, ...)\n          - focus-metavariable: $SRC\n    pattern-sanitizers:\n      # defusedxml — safe replacement\n      - pattern: defusedxml.parse(...)\n      - pattern: defusedxml.fromstring(...)\n      - pattern: defusedxml.ElementTree.parse(...)\n      - pattern: defusedxml.ElementTree.fromstring(...)\n      - pattern: defusedxml.minidom.parseString(...)\n      - pattern: defusedxml.sax.parseString(...)\n      # lxml safe parser configuration\n      - pattern: lxml.etree.XMLParser(..., resolve_entities=False, ...)\n      - pattern: etree.XMLParser(..., resolve_entities=False, ...)\n    metadata:\n      cwe: [\"CWE-611\"]\n      owasp_top_10: [\"A5:2021-Security Misconfiguration\"]\n      tags: [\"security\", \"xml\", \"xxe\", \"taint\"]\n\n  # ---------------------------------------------------------------------------\n  # Java — taint: servlet/Spring params → XML parser sinks (XXE)\n  # ---------------------------------------------------------------------------\n  - id: raptor.xml.xxe.taint.java\n    message: >-\n      Untrusted data flows into an XML parser without XXE protections.\n      Disable external entity processing by setting\n      XMLConstants.FEATURE_SECURE_PROCESSING or disallowing doctype\n      declarations on the factory.\n    languages: [java]\n    severity: CRITICAL\n    mode: taint\n    pattern-sources:\n      - pattern-either:\n          # Servlet\n          - pattern: (HttpServletRequest $REQ).getParameter(...)\n          - pattern: (HttpServletRequest $REQ).getHeader(...)\n          - pattern: (HttpServletRequest $REQ).getPathInfo()\n          - pattern: (HttpServletRequest $REQ).getQueryString()\n          - pattern: (HttpServletRequest $REQ).getRequestURI()\n          - pattern: (HttpServletRequest $REQ).getInputStream()\n          - pattern: (HttpServletRequest $REQ).getReader()\n          # Spring MVC\n          - pattern: (WebRequest $REQ).getParameter(...)\n          - pattern: (WebRequest $REQ).getHeader(...)\n    pattern-sinks:\n      # DocumentBuilder.parse — vulnerable unless factory is hardened\n      - patterns:\n          - pattern: (DocumentBuilder $DB).parse($SRC)\n          - focus-metavariable: $SRC\n      # SAXParser.parse\n      - patterns:\n          - pattern: (SAXParser $SP).parse($SRC, ...)\n          - focus-metavariable: $SRC\n      # XMLReader.parse\n      - patterns:\n          - pattern: (XMLReader $XR).parse($SRC)\n          - focus-metavariable: $SRC\n      # Transformer — can process external entities from source\n      - patterns:\n          - pattern: (Transformer $T).transform(new StreamSource($SRC), ...)\n          - focus-metavariable: $SRC\n      # XMLInputFactory.createXMLStreamReader\n      - patterns:\n          - pattern: (XMLInputFactory $F).createXMLStreamReader($SRC)\n          - focus-metavariable: $SRC\n      - patterns:\n          - pattern: (XMLInputFactory $F).createXMLStreamReader($NAME, $SRC)\n          - focus-metavariable: $SRC\n    pattern-sanitizers:\n      # Factory-level hardening — semgrep cannot track factory→builder\n      # assignment, but presence of these calls in the same function is\n      # a strong signal that the parser is safe.\n      - pattern: $FACTORY.setFeature(\"http://apache.org/xml/features/disallow-doctype-decl\", true)\n      - pattern: $FACTORY.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true)\n      - pattern: $FACTORY.setProperty(XMLConstants.ACCESS_EXTERNAL_DTD, \"\")\n      - pattern: $FACTORY.setProperty(XMLConstants.ACCESS_EXTERNAL_SCHEMA, \"\")\n    metadata:\n      cwe: [\"CWE-611\"]\n      owasp_top_10: [\"A5:2021-Security Misconfiguration\"]\n      tags: [\"security\", \"xml\", \"xxe\", \"taint\"]\n"
        }
      },
      "capabilities": [
        "Write"
      ]
    },
    {
      "id": "validate",
      "name": "验证参数并形成隔离用例调用",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 180000,
        "args": {
          "command": "jq -ce 'def safe_path: type == \"string\" and test(\"^[A-Za-z0-9_][A-Za-z0-9_./-]*$\") and (split(\"/\") | all(. != \"..\" and . != \"\"));\ndef line_number: type == \"number\" and . >= 1 and floor == .;\ndef valid_case:\n  type == \"object\" and (.id | type == \"string\" and test(\"^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$\"))\n  and (.rulePath == \".\" or (.rulePath | safe_path))\n  and (.targets | type == \"array\" and length > 0 and all(safe_path))\n  and (.expectation == \"positive\" or .expectation == \"negative\" or .expectation == \"observe\")\n  and ((.expected // []) | type == \"array\" and all(type == \"object\" and (.path | safe_path) and (.line | line_number) and (.ruleIdSuffix | type == \"string\" and length > 0)))\n  and ((.expectedLines // []) | type == \"array\" and all(type == \"object\" and (.path | safe_path) and (.lines | type == \"array\" and all(line_number))));\nif (.cases | type == \"array\" and length > 0 and length <= 100 and all(valid_case))\n   and ((.cases | map(.id) | unique | length) == (.cases | length))\nthen {calls: [.cases[] | {case: .}]} else error(\"Invalid case manifest: unique safe ids, safe relative paths, supported expectations and exact-match constraints are required\") end' flow/cases.json",
          "timeout_ms": 180000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "arguments",
      "name": "提取已验证调用参数",
      "plugin": "builtin.transform",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "operation": "pick",
        "value": "${nodes.validate.outputs.result}",
        "path": [
          "stdout",
          "calls"
        ],
        "type": "json"
      }
    },
    {
      "id": "cases",
      "name": "逐用例执行并收集全部对照结果",
      "plugin": "builtin.flow",
      "pluginVersion": "2.0.0",
      "inputs": {},
      "config": {
        "flowId": "raptor-parity-case",
        "parameterSets": "${nodes.arguments.outputs.result}",
        "maxConcurrency": 2
      }
    },
    {
      "id": "summary",
      "name": "所有用例完成后保存汇总并执行最终成功门禁",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 180000,
        "args": {
          "command": "set -e\njq -s --slurpfile manifest flow/cases.json '($manifest[0].cases | map(.id)) as $ids |\n[.[] | select(.caseId as $id | $ids | index($id))] as $reports |\n{workflow:\"raptor-parity\",upstreamCommit:\"2ac96303d5e382c196aa34b2984a3c6a218132a9\",ruleFiles:58,ruleCount:166,\n expectedCases:($ids|length),completedCases:($reports|length),missingCaseIds:($ids - ($reports|map(.caseId))),\n failedCaseIds:[$reports[]|select(.passed != true)|.caseId],parityMismatchCaseIds:[$reports[]|select(.equal != true)|.caseId],\n expectationFailureCaseIds:[$reports[]|select(.expectationPassed != true)|.caseId],\n scannerFailureCaseIds:[$reports[]|select(.scanExitCode != 0 or .actual.valid != true or (.actual.errors|length) != 0)|.caseId],\n baselineFindings:([$reports[].baseline.findings|length]|add // 0),flowFindings:([$reports[].actual.findings|length]|add // 0),\n passed:(($ids|length) == ($reports|length) and all($reports[];.passed == true))}' flow/*.comparison.json > flow/summary.json\njq -c '{summary:.}' flow/summary.json\njq -e '.passed' flow/summary.json > /dev/null",
          "timeout_ms": 180000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "report",
      "name": "返回持久验收汇总",
      "plugin": "builtin.transform",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "operation": "pick",
        "value": "${nodes.summary.outputs.result}",
        "path": [
          "stdout",
          "summary"
        ],
        "type": "json"
      }
    }
  ],
  "edges": [
