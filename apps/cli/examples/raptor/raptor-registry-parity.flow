    {
      "id": "compare",
      "name": "按 RAPTOR SARIF 去重身份合并并校验全部结果",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 300000,
        "args": {
          "command": "set -e\njq -s '.' output/*.status.json > output/statuses.json\njq -s '.' output/*.metadata.json > output/metadata.json\njq -s --slurpfile baseline baseline/combined.sarif --slurpfile metrics baseline/scan_metrics.json --slurpfile status output/statuses.json --slurpfile metadata output/metadata.json 'def relative_path: sub(\"^.*[/]official-scan-target/\"; \"\") | sub(\"^\\\\./\"; \"\") | sub(\"^target/\"; \"\");\ndef rule_id: sub(\"^.*\\\\.raptor\\\\.\"; \"raptor.\");\ndef fingerprint:\n  (.partialFingerprints // {}) as $fp |\n  if ($fp.primaryLocationLineHash | type) == \"string\" and ($fp.primaryLocationLineHash | length) > 0 then $fp.primaryLocationLineHash\n  elif ($fp | length) > 0 then ($fp | to_entries | sort_by(.key) | tojson) else \"\" end;\ndef findings:\n  [.runs[] as $run | $run.results[]? | . as $finding |\n   (.locations[0].physicalLocation) as $location |\n   {tool:$run.tool.driver.name,ruleId:(.ruleId|rule_id),path:($location.artifactLocation.uri|relative_path),\n    start:{line:($location.region.startLine // 0),col:($location.region.startColumn // 0)},\n    end:{line:($location.region.endLine // $location.region.startLine // 0),col:($location.region.endColumn // 0)},\n    fingerprint:fingerprint,message:(.message.text // .message.markdown // \"\"),\n    severity:(.level // ([$run.tool.driver.rules[]? | select(.id == $finding.ruleId)][0].defaultConfiguration.level) // \"warning\")}];\ndef identity: [.tool,.ruleId,.path,.start.line,.end.line,.start.col,.fingerprint];\ndef deduplicate: group_by(identity) | map(last) | sort_by(identity);\n($baseline[0] | findings | deduplicate) as $expected |\n([.[] | findings[]]) as $raw |\n($raw | deduplicate) as $actual |\n($status[0]) as $statuses |\n($metadata[0]) as $metas |\n{workflow:\"raptor-registry-parity\",upstreamCommit:\"2ac96303d5e382c196aa34b2984a3c6a218132a9\",\n scope:\"Official Python/JavaScript targets under python.generic and policy-groups all\",\n registryPinned:false,localRuleFilesVerified:58,scanCount:($statuses|length),\n expectedRawFindings:$metrics[0].total_findings,flowRawFindings:($raw|length),\n baselineCount:($expected|length),flowCount:($actual|length),\n failedPacks:[$statuses[]|select(.exitCode != 0 and .exitCode != 1)],\n errors:[$metas[]|.errors[]?],skipped:[$metas[]|.paths.skipped[]?],\n metadataCount:($metas|length),equal:($expected == $actual),\n missing:($expected-$actual),extra:($actual-$expected),baseline:$expected,actual:$actual,\n passed:(($expected == $actual) and ($statuses|length)==9 and ($metas|length)==9\n   and all($statuses[];.exitCode == 0 or .exitCode == 1) and all($metas[];(.errors|type)==\"array\" and (.errors|length)==0)\n   and ($raw|length)==$metrics[0].total_findings)}' output/*.sarif > output/comparison.json\njq '.baseline' output/comparison.json > output/baseline.normalized.json\njq '.actual' output/comparison.json > output/flow.normalized.json\njq '{summary:(del(.baseline,.actual,.errors,.skipped) + {errorCount:(.errors|length),skippedCount:(.skipped|length)})}' output/comparison.json > output/summary.json\ncat output/summary.json\njq -e '.passed' output/comparison.json > /dev/null",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "report",
