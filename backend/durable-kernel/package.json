{
  "name": "@itookit/durable-kernel",
  "version": "0.1.0",
  "description": "Durable Session/Task scheduling and resource kernel",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./core": {
      "types": "./src/core.ts",
      "import": "./src/core.ts",
      "default": "./src/core.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@itookit/vfs-core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./core": {
        "import": {
          "types": "./dist/core.d.ts",
          "default": "./dist/core.js"
        },
        "require": {
          "types": "./dist/core.d.cts",
          "default": "./dist/core.cjs"
        }
      },
      "./contracts": {
        "import": {
          "types": "./dist/contracts.d.ts",
          "default": "./dist/contracts.js"
        },
        "require": {
          "types": "./dist/contracts.d.cts",
          "default": "./dist/contracts.cjs"
        }
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
