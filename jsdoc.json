{
  "source": {
    "include": ["libraries/mdxeditor/src"],
    "exclude": [
      "libraries/mdxeditor/node_modules",
      "libraries/mdxeditor/dist",
      "libraries/mdxeditor/tailwind.config.js",
      "libraries/mdxeditor/postcss.config.js"
    ],
    "includePattern": ".+\\.js(doc|x)?$",
    "excludePattern": "(^|\\/|\\\\)_(?!.*\\/)"
  },
  "opts": {
    "destination": "./docs/mdxeditor/",
    "encoding": "utf8",
    "recurse": true
  },
  "plugins": ["jsdoc-tsimport-plugin"]
}
