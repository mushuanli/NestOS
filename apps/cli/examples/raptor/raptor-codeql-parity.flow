 [.threadFlows[]? | [.locations[]? | .location | location]]]|sort)}] | sort),\n errors:([.runs[].invocations[]?.toolExecutionNotifications[]? | select(.level==\"error\") |\n {id:.descriptor.id,message:.message.text,locations:[.locations[]?|location]}]|sort),\n successful:all(.runs[].invocations[]?;.executionSuccessful==true)}' flow/go.sarif > flow/go.flow.normalized.json\njq -n --arg language go --slurpfile baseline flow/go.baseline.normalized.json --slurpfile flow flow/go.flow.normalized.json '($baseline[0]) as $expected | ($flow[0]) as $actual |\n{language:$language,baselineCount:($expected.findings|length),flowCount:($actual.findings|length),\n codeFlows:([$actual.findings[].codeFlows[]]|length),\n baselineErrors:$expected.errors,flowErrors:$actual.errors,\n missing:($expected.findings-$actual.findings),extra:($actual.findings-$expected.findings),\n passed:($expected==$actual and $actual.successful and ($actual.errors|length)==0)}' > flow/go.comparison.json\njq -s '{workflow:\"raptor-codeql-parity\",scope:\"Native CodeQL extraction and original queries only; excludes LLM eligibility and Z3 feasibility\",languages:5,databases:length,baselineCount:([.[].baselineCount]|add),flowCount:([.[].flowCount]|add),codeFlows:([.[].codeFlows]|add),passed:all(.[];.passed),results:.,knownCoverageGaps:[\"Python allowlist false-positive remains a conservative CodeQL flow; IRIS LLM filtering has not been run.\",\"SMT C nine-case SAT/UNSAT/indeterminate expectations require the separate Z3/LLM pipeline and are not asserted here.\"]}' flow/*.comparison.json > flow/summary.json\ncat flow/summary.json\njq -e '.passed' flow/summary.json > /dev/null",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
      "portSchemas": {
        "outputs": {
          "result": {
            "id": "raptor.parity.shell-result",
            "version": "1",
            "definition": {
              "type": "object",
              "required": [
                "stdout",
                "exitCode",
                "truncated"
              ],
              "properties": {
                "stdout": {
                  "type": "string"
                },
                "exitCode": {
                  "type": "integer",
                  "enum": [
                    0
                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "report",
      "name": "返回 CodeQL 五语言对照与已知覆盖缺口",
      "plugin": "builtin.transform",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "operation": "pick",
        "value": "${nodes.compare.outputs.result}",
        "path": [
          "stdout"
        ],
        "type": "json"
      }
    }
  ],
