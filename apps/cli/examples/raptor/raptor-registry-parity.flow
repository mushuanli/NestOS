                  ]
                },
                "truncated": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "local",
      "name": "原生 Semgrep 执行 rules",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "Bash",
        "toolVersion": "1",
        "approval": "none",
        "timeoutMs": 300000,
        "args": {
          "command": ": > output/local.metadata.json\nsemgrep scan --config rules --verbose --metrics off --disable-version-check --error --sarif --disable-nosem --no-git-ignore --x-ignore-semgrepignore-files --timeout 120 --jobs 1 --json-output output/local.metadata.json --exclude node_modules/ --exclude bower_components/ --exclude .yarn/ --exclude .npm/ --exclude vendor/ --exclude third_party/ --exclude site-packages/ --exclude .venv/ --exclude .tox/ --exclude build/ --exclude dist/ --exclude '*.min.js' --exclude '*.min.css' --exclude package-lock.json --exclude yarn.lock --exclude pnpm-lock.yaml --exclude poetry.lock --exclude Pipfile.lock --exclude Cargo.lock --exclude composer.lock --exclude Gemfile.lock --exclude go.sum target > output/local.sarif 2> output/local.stderr.log\nscan_status=$?\njq -nc --arg pack rules --argjson exitCode \"$scan_status\" '{pack:$pack,exitCode:$exitCode}' > output/local.status.json\ncat output/local.status.json",
          "timeout_ms": 300000
        }
      },
      "capabilities": [
        "Bash"
      ],
