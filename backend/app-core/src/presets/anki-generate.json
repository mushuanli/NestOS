{
  "updatedAt": 0,
  "defaultConnection": "text",
  "runPolicy": {
    "maxNodes": 4096,
    "maxConcurrency": 4
  },
  "id": "anki-generate",
  "name": "Anki 制卡（文本或图片）",
  "draftVersion": 3,
  "parameters": [
    {
      "name": "words",
      "label": "文本",
      "type": "string",
      "required": false,
      "nonBlank": false,
      "onMissing": "interact",
      "widget": "textarea",
      "description": "填写英文单词、Unit N 分组或 WordData JSON；也可仅选择图片。图片和文字可从同一入口提交。",
      "default": "",
      "inputSource": "composer.text",
      "presentation": {},
      "role": "input"
    },
    {
      "name": "images",
      "label": "图片",
      "type": "json",
      "widget": "images",
      "required": false,
      "onMissing": "interact",
      "description": "可替代文字输入。按页面顺序选择教材图片；识别后校对，再自动分批补全并打包。",
      "imageConstraints": {
        "maxItems": 12,
        "maxBytes": 83886080,
        "mimeTypes": [
          "image/png",
          "image/jpeg",
          "image/webp"
        ]
      },
      "inputSource": "composer.attachments",
      "presentation": {},
      "role": "input"
    },
    {
      "name": "wordsGroups",
      "label": "分组",
      "type": "json",
      "default": null,
      "widget": "textarea",
      "description": "输入 JSON 数组，例如 [\"Unit 1\\napple\", \"Unit 2\\npear\"]。",
      "presentation": {
        "contentSource": false
      },
      "role": "input"
    },
    {
      "name": "requirements",
      "label": "学习要求",
      "type": "string",
      "default": "面向中国青少年英语学习者，例句简洁自然，中文解释清楚，难度适中。",
      "widget": "textarea",
      "description": "年级、例句难度和记忆技巧偏好。图片及语音默认关闭，可按需开启；需要宿主安装 anki-cli 工具模块。",
      "presentation": {},
      "role": "option"
    },
    {
      "name": "deckName",
      "label": "牌组名称",
      "type": "string",
      "required": true,
      "nonBlank": true,
      "default": "英语单词",
      "presentation": {},
      "role": "option"
    },
    {
      "name": "outputDirectory",
      "label": "输出目录",
      "type": "string",
      "required": true,
      "nonBlank": true,
      "default": "anki-output",
      "description": "授权工作区内的相对目录；每次打包保存到独立子目录，保留此前产物。",
      "presentation": {},
      "role": "option"
    },
    {
      "name": "generateImages",
      "label": "生成配图",
      "type": "boolean",
      "default": false,
      "widget": "checkbox",
      "presentation": {
        "group": "生成选项",
        "connectionToggle": "image"
      },
      "role": "option"
    },
    {
      "name": "generateAudio",
      "label": "生成单词和例句语音",
      "type": "boolean",
      "default": false,
      "widget": "checkbox",
      "presentation": {
        "group": "生成选项",
        "connectionToggle": "speech"
      },
      "role": "option"
    },
    {
      "name": "voice",
      "label": "语音音色",
      "type": "string",
      "default": "",
      "description": "选择语音模型支持的音色。",
      "presentation": {
        "group": "生成选项",
        "visibleWhen": {
          "kind": "eq",
          "args": [
            {
              "kind": "param",
              "path": [
                "generateAudio"
              ]
            },
            {
              "kind": "literal",
              "value": true
            }
          ]
        },
        "connectionVoices": "speech"
      },
      "role": "option"
    },
    {
      "name": "processingMode",
      "label": "多项输入处理方式",
      "type": "string",
      "default": "combined",
      "widget": "select",
      "options": [
        "combined",
        "grouped"
      ],
      "description": "combined 将多张图片或多个文本组一起处理；grouped 按指定分组分别处理。全部结果最终汇总为一个完整 Anki 包。",
      "presentation": {
        "visibleWhen": {
          "kind": "or",
          "args": [
            {
              "kind": "and",
              "args": [
                {
                  "kind": "exists",
                  "args": [
                    {
                      "kind": "param",
                      "path": [
                        "images",
                        "length"
                      ]
                    }
                  ]
                },
                {
                  "kind": "gt",
                  "args": [
                    {
                      "kind": "param",
                      "path": [
                        "images",
                        "length"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": 1
                    }
                  ]
                }
              ]
            },
            {
              "kind": "and",
              "args": [
                {
                  "kind": "exists",
                  "args": [
                    {
                      "kind": "param",
                      "path": [
                        "wordsGroups",
                        "length"
                      ]
                    }
                  ]
                },
                {
                  "kind": "gt",
                  "args": [
                    {
                      "kind": "param",
                      "path": [
                        "wordsGroups",
                        "length"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": 1
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "role": "option"
    },
    {
      "name": "imageGroups",
      "label": "图片分组索引",
      "type": "json",
      "default": [],
      "widget": "textarea",
      "description": "分组模式可填 [[0,1],[2]]，索引从0开始，每张图片必须恰好属于一组；留空时每张图片一组。",
      "presentation": {
        "visibleWhen": {
          "kind": "and",
          "args": [
            {
              "kind": "eq",
              "args": [
                {
                  "kind": "param",
                  "path": [
                    "processingMode"
                  ]
                },
                {
                  "kind": "literal",
                  "value": "grouped"
                }
              ]
            },
            {
              "kind": "gt",
              "args": [
                {
                  "kind": "param",
                  "path": [
                    "images",
                    "length"
                  ]
                },
                {
                  "kind": "literal",
                  "value": 0
                }
              ]
            }
          ]
        }
      },
      "role": "policy"
    },
    {
      "name": "groupUnits",
      "label": "各图片组的起始单元",
      "type": "json",
      "default": [],
      "widget": "textarea",
      "description": "可填 [1,3,5]，用于图片页首未写单元标题时的延续单元；每组图片有明确单元标题时以图片为准。",
      "presentation": {
        "visibleWhen": {
          "kind": "and",
          "args": [
            {
              "kind": "eq",
              "args": [
                {
                  "kind": "param",
                  "path": [
                    "processingMode"
                  ]
                },
                {
                  "kind": "literal",
                  "value": "grouped"
                }
              ]
            },
            {
              "kind": "gt",
              "args": [
                {
                  "kind": "param",
                  "path": [
                    "images",
                    "length"
                  ]
                },
                {
                  "kind": "literal",
                  "value": 0
                }
              ]
            }
          ]
        }
      },
      "role": "policy"
    }
  ],
  "connections": [
    {
      "name": "text",
      "required": true,
      "tier": "standard",
      "requirements": {
        "operation": "chat",
        "inputModalities": [
          "text"
        ],
        "outputModalities": [
          "text"
        ]
      },
      "description": "生成单词卡片文本的模型连接",
      "label": "文本生成连接"
    },
    {
      "name": "image",
      "required": false,
      "tier": "optimal",
      "requirements": {
        "operation": "image.generate",
        "inputModalities": [
          "text"
        ],
        "outputModalities": [
          "image"
        ]
      },
      "description": "选择连接以启用，选择关闭则不生成。",
      "label": "文生图连接",
      "requiredWhen": {
        "kind": "eq",
        "args": [
          {
            "kind": "param",
            "path": [
              "generateImages"
            ]
          },
          {
            "kind": "literal",
            "value": true
          }
        ]
      },
      "presentation": {
        "group": "生成选项"
      }
    },
    {
      "name": "speech",
      "required": false,
      "tier": "optimal",
      "requirements": {
        "operation": "speech.synthesize",
        "inputModalities": [
          "text"
        ],
        "outputModalities": [
          "audio"
        ]
      },
      "description": "选择连接以启用，选择关闭则不生成。",
      "label": "tts语音连接",
      "requiredWhen": {
        "kind": "eq",
        "args": [
          {
            "kind": "param",
            "path": [
              "generateAudio"
            ]
          },
          {
            "kind": "literal",
            "value": true
          }
        ]
      },
      "presentation": {
        "group": "生成选项"
      }
    },
    {
      "name": "vision",
      "required": false,
      "tier": "optimal",
      "requirements": {
        "operation": "chat",
        "inputModalities": [
          "text",
          "image"
        ],
        "outputModalities": [
          "text"
        ]
      },
      "description": "提供图片时必选；纯文本无需绑定。",
      "label": "OCR图片识别连接",
      "requiredWhen": {
        "kind": "and",
        "args": [
          {
            "kind": "exists",
            "args": [
              {
                "kind": "param",
                "path": [
                  "images",
                  "length"
                ]
              }
            ]
          },
          {
            "kind": "gt",
            "args": [
              {
                "kind": "param",
                "path": [
                  "images",
                  "length"
                ]
              },
              {
                "kind": "literal",
                "value": 0
              }
            ]
          }
        ]
      }
    }
  ],
  "nodes": [
    {
      "id": "source",
      "name": "选择文本或图片输入",
      "plugin": "builtin.route",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "mode": "exclusive",
        "rules": [
          {
            "edgeId": "source-images",
            "expression": {
              "kind": "and",
              "args": [
                {
                  "kind": "exists",
                  "args": [
                    {
                      "kind": "param",
                      "path": [
                        "images",
                        "length"
                      ]
                    }
                  ]
                },
                {
                  "kind": "gt",
                  "args": [
                    {
                      "kind": "param",
                      "path": [
                        "images",
                        "length"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": 0
                    }
                  ]
                }
              ]
            },
            "priority": 0
          },
          {
            "edgeId": "source-groups",
            "priority": 1,
            "expression": {
              "kind": "neq",
              "args": [
                {
                  "kind": "param",
                  "path": [
                    "wordsGroups"
                  ]
                },
                {
                  "kind": "literal",
                  "value": null
                }
              ]
            }
          }
        ],
        "defaultEdgeId": "source-text"
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "collect-groups",
      "name": "使用已提供的文本分组",
      "plugin": "builtin.transform",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {},
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "collect",
      "name": "填写单词与学习要求",
      "plugin": "builtin.input",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "prompt": "请填写英文单词列表（支持 Unit N 分组）或 WordData JSON 数组。",
        "param": {
          "words": {
            "type": "string",
            "label": "单词列表或 WordData JSON",
            "nonBlank": true,
            "widget": "textarea"
          },
          "requirements": {
            "type": "string",
            "label": "学习要求",
            "default": "面向中国青少年英语学习者，例句简洁自然，中文解释清楚，难度适中。",
            "widget": "textarea"
          }
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "prepare",
      "name": "校验单词输入与工具环境",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "capabilities": [
        "anki.prepare"
      ],
      "config": {
        "toolId": "anki.prepare",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "source": "${param.words}",
          "sources": "${param.wordsGroups}"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "collect-images",
      "name": "选择教材图片",
      "plugin": "builtin.input",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "prompt": "选择教材图片；系统将保留原图，按工作流配方生成用于识别的灰度图。",
        "param": {
          "images": {
            "label": "教材或单词图片",
            "type": "json",
            "widget": "images",
            "required": true,
            "imageConstraints": {
              "maxItems": 12,
              "maxBytes": 83886080,
              "mimeTypes": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            }
          }
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "recognition",
      "name": "规划整批或分组图片识别",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "anki.recognize",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "images": "${param.images}",
          "groups": "${param.imageGroups}",
          "groupUnits": "${param.groupUnits}",
          "mode": "${param.processingMode}"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      },
      "capabilities": [
        "anki.recognize"
      ]
    },
    {
      "id": "dispatch-recognition",
      "name": "按组调用图片识别函数",
      "plugin": "builtin.flow",
      "pluginVersion": "2.0.0",
      "inputs": {},
      "config": {
        "flowId": "anki-recognize-group",
        "parameterSets": "${nodes.recognition.outputs.result.parameterSets}",
        "maxConcurrency": 4,
        "connectionBindings": {
          "vision": "vision"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "recognized",
      "name": "汇合各图片组完整识别结果",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "toolId": "anki.collect",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "sources": "${nodes.dispatch-recognition.outputs.result}"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      },
      "capabilities": [
        "anki.collect"
      ]
    },
    {
      "id": "review",
      "name": "校对图片识别结果",
      "plugin": "builtin.input",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "review": true,
        "prompt": "请对照原图校对完整的单词、单元、音标和中文释义，可直接修改 JSON。确认后自动分批补全、按需生成媒体，并将全部卡片汇总为一个 Anki 包。 分组模式请保留各组顺序；若增删卡片，同时修改各图片组卡片数量，使数量总和与卡片数一致。",
        "param": {
          "cards": {
            "type": "json",
            "label": "校对后的单词数据",
            "required": true,
            "widget": "textarea"
          },
          "groupSizes": {
            "type": "json",
            "label": "各图片组卡片数量",
            "required": true,
            "widget": "textarea"
          }
        },
        "initial": {
          "cards": "${nodes.recognized.outputs.result.cards}",
          "groupSizes": "${nodes.recognized.outputs.result.groupSizes}"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "prepare-image",
      "name": "校验单词输入与工具环境",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "capabilities": [
        "anki.prepare"
      ],
      "config": {
        "toolId": "anki.prepare",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "source": "${param.cards}",
          "additionalSource": "${param.words}",
          "sources": "${param.wordsGroups}",
          "sourceGroupSizes": "${param.groupSizes}",
          "mode": "${param.processingMode}"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "normalize",
      "name": "汇合已校验的单词数据",
      "plugin": "builtin.transform",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {},
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "build",
      "name": "调用公共制卡与打包",
      "plugin": "builtin.flow",
      "pluginVersion": "2.0.0",
      "inputs": {},
      "config": {
        "flowId": "anki-build",
        "parameters": {
          "cards": "${nodes.normalize.outputs.result.cards}",
          "requirements": "${param.requirements}",
          "deckName": "${param.deckName}",
          "outputDirectory": "${param.outputDirectory}",
          "generateImages": "${param.generateImages}",
          "generateAudio": "${param.generateAudio}",
          "voice": "${param.voice}",
          "processingMode": "${param.processingMode}",
          "groups": "${nodes.normalize.outputs.result.groups}"
        },
        "connectionBindings": {
          "text": "text",
          "image": "image",
          "speech": "speech"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    }
  ],
  "edges": [
    {
      "id": "source-text",
      "from": "source",
      "to": "collect",
      "kind": "control"
    },
    {
      "id": "source-images",
      "from": "source",
      "to": "collect-images",
      "kind": "control"
    },
    {
      "id": "collect-prepare",
      "from": "collect",
      "to": "prepare",
      "kind": "control"
    },
    {
      "id": "review-prepare-image",
      "from": "review",
      "to": "prepare-image",
      "kind": "control"
    },
    {
      "id": "prepare-normalize",
      "from": "prepare",
      "to": "normalize",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "prepare-image-normalize",
      "from": "prepare-image",
      "to": "normalize",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "normalize-build",
      "from": "normalize",
      "to": "build",
      "kind": "control"
    },
    {
      "id": "collect-images-recognition",
      "from": "collect-images",
      "to": "recognition",
      "kind": "control"
    },
    {
      "id": "recognition-dispatch-recognition",
      "from": "recognition",
      "to": "dispatch-recognition",
      "kind": "control"
    },
    {
      "id": "dispatch-recognition-recognized",
      "from": "dispatch-recognition",
      "to": "recognized",
      "kind": "control"
    },
    {
      "id": "recognized-review",
      "from": "recognized",
      "to": "review",
      "kind": "control"
    },
    {
      "id": "source-groups",
      "from": "source",
      "to": "collect-groups",
      "kind": "control"
    },
    {
      "id": "collect-groups-prepare",
      "from": "collect-groups",
      "to": "prepare",
      "kind": "control"
    }
  ],
  "outputs": {
    "manifest": {
      "value": "${nodes.build.outputs.manifest}",
      "schema": {
        "type": "object",
        "required": [
          "path",
          "mimeType"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "package": {
      "value": "${nodes.build.outputs.package}",
      "schema": {
        "type": "object",
        "required": [
          "path",
          "mimeType"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "layout": {
    "nodes": {
      "source": {
        "x": 0,
        "y": 100
      },
      "collect": {
        "x": 320,
        "y": 100
      },
      "prepare": {
        "x": 640,
        "y": 100
      },
      "collect-images": {
        "x": 960,
        "y": 100
      },
      "recognition": {
        "x": 1280,
        "y": 100
      },
      "dispatch-recognition": {
        "x": 1600,
        "y": 100
      },
      "recognized": {
        "x": 1920,
        "y": 100
      },
      "review": {
        "x": 2240,
        "y": 100
      },
      "prepare-image": {
        "x": 2560,
        "y": 100
      },
      "normalize": {
        "x": 2880,
        "y": 100
      },
      "build": {
