{
  "name": "@itookit/mdx-adapter",
  "version": "0.1.0",
  "description": "MindOS host and VFS adapter for the standalone mdxeditor.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style.css": "./src/styles/index.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./style.css": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@itookit/common": "workspace:*",
    "@itookit/ui-common": "workspace:*",
    "@itookit/vfs-core": "workspace:*"
  },
  "peerDependencies": {
    "@itookit/mdxeditor": "workspace:*"
  },
  "devDependencies": {
    "@itookit/mdxeditor": "workspace:*",
    "@types/node": "^20.19.25",
    "jsdom": "^27.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.5"
  },
  "author": "lizlok@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mushuanli/itookit.git",
    "directory": "packages/mdx-adapter"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
