{
  "name": "@itookit/llm-settings-ui",
  "version": "0.1.0",
  "description": "LLM settings editors (Agent / Provider / Connection / MCP / Skill / Cost) and config import/export",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ocr": {
      "types": "./src/ocr.ts",
      "import": "./src/ocr.ts",
      "default": "./src/ocr.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./ocr": {
        "types": "./dist/ocr.d.ts",
        "import": "./dist/ocr.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@itookit/llm-ui": "workspace:*",
    "@itookit/common": "workspace:*",
    "@itookit/ui-common-adapter": "workspace:*",
    "@itookit/driver-llm": "workspace:*",
    "@itookit/vfs-core": "workspace:*",
    "js-yaml": "^4.1.1",
    "@itookit/kernel-adapters": "workspace:*",
    "@itookit/tools": "workspace:*",
    "@itookit/app-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.25",
    "jsdom": "^27.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
