{
    "name": "itookit",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "pnpm --filter mind-os dev",
        "httpd": "pnpm --filter @itookit/http-app dev",
        "build": "pnpm -r build",
        "build:libs": "pnpm --filter './libraries/*' --filter './packages/*' build",
        "test": "pnpm architecture:check && node --test scripts/tests/test-all.test.mjs && node scripts/test-all.mjs",
        "release": "pnpm --filter ./apps/web-app build && node scripts/release.js",
        "deploy:pages": "pnpm --filter ./apps/web-app build && node scripts/deploy-gh-pages.js",
        "tauri:dev": "pnpm --filter tauri-app tauri:dev",
        "tau": "pnpm --filter tauri-app tauri:dev",
        "tauri:build": "pnpm build:libs && pnpm --filter tauri-app tauri:build",
        "cli": "node apps/cli/dist/cli.js",
        "cli:build": "pnpm --filter @itookit/cli build",
        "migrate:legacy-chats": "pnpm --filter @itookit/cli exec tsx scripts/migrate-legacy-chats.ts",
        "clean": "pnpm -r clean && rm -rf node_modules",
        "typecheck": "pnpm -r typecheck",
        "docs:check": "node scripts/check-docs.mjs",
        "styles:check": "node scripts/check-styles.mjs",
        "architecture:check": "node --test scripts/tests/check-boundaries.test.mjs && node scripts/check-boundaries.mjs",
        "test:matrix": "pnpm architecture:check && node --test scripts/tests/test-all.test.mjs && node scripts/test-all.mjs",
        "npm:prepare": "node scripts/release-npm-libraries.mjs prepare",
        "npm:publish": "node scripts/release-npm-libraries.mjs publish",
        "workspace:check": "node scripts/check-workspace.mjs",
        "preinstall": "node scripts/check-workspace.mjs",
        "build:registry": "node scripts/build-registry.mjs"
    },
    "keywords": [],
    "author": "lizlok@gmail.com",
    "license": "ISC",
    "packageManager": "pnpm@10.20.0",
    "devDependencies": {
        "jsdoc": "^4.0.5",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "@itookit/vfs-sync": "workspace:*",
        "@itookit/vfs-core": "workspace:*",
        "@itookit/vfs-ui": "workspace:*",
        "@itookit/vfsdriver-indexeddb": "workspace:*",
        "@itookit/vfsdriver-local": "workspace:*",
        "@itookit/driver-llm": "workspace:*",
        "@itookit/mdxeditor": "workspace:*"
    },
    "dependencies": {
        "jsdoc-tsimport-plugin": "^1.0.5",
        "vite": "^7.2.4"
    }
}
