{
  "name": "@itookit/app-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./profile": {
      "types": "./src/profile/mindos-profile.ts",
      "import": "./src/profile/mindos-profile.ts",
      "default": "./src/profile/mindos-profile.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/backend.ts",
      "import": "./src/contracts/backend.ts",
      "default": "./src/contracts/backend.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@itookit/common": "workspace:*",
    "@itookit/durable-kernel": "workspace:*",
    "@itookit/kernel-adapters": "workspace:*",
    "@itookit/llm-flow": "workspace:*",
    "@itookit/llm-session": "workspace:*",
    "@itookit/vfs-core": "workspace:*",
    "@itookit/driver-llm": "workspace:*",
    "@itookit/llm-context": "workspace:*",
    "@itookit/llm-tasks": "workspace:*",
    "@itookit/tools": "workspace:*",
    "@itookit/vfs-sync": "workspace:*",
    "@itookit/piagent-driver": "workspace:*",
    "@itookit/app-contracts": "workspace:*"
  },
  "devDependencies": {
    "@itookit/vfsdriver-indexeddb": "workspace:*",
    "@types/node": "^20.19.25",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@itookit/vfs-ui": "workspace:*"
  }
}
