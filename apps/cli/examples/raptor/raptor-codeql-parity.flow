        "timeoutMs": 300000,
        "args": {
          "command": "set -e\njq 'def location:\n  .physicalLocation as $p | {path:($p.artifactLocation.uri // \"\"),\n  start:{line:($p.region.startLine // 0),col:($p.region.startColumn // 0)},\n  end:{line:($p.region.endLine // $p.region.startLine // 0),col:($p.region.endColumn // 0)},\n  message:(.message.text // .message.markdown // \"\")};\n{findings:([.runs[] as $run | $run.results[]? | . as $finding |\n {ruleId:.ruleId,message:(.message.text // .message.markdown // \"\"),\n severity:(.level // ([$run.tool.driver.rules[]? | select(.id==$finding.ruleId)][0].defaultConfiguration.level) // \"warning\"),\n locations:[.locations[]? | location],relatedLocations:([.relatedLocations[]? | location]|sort),\n codeFlows:([.codeFlows[]? | [.threadFlows[]? | [.locations[]? | .location | location]]]|sort)}] | sort),\n errors:([.runs[].invocations[]?.toolExecutionNotifications[]? | select(.level==\"error\") |\n {id:.descriptor.id,message:.message.text,locations:[.locations[]?|location]}]|sort),\n successful:all(.runs[].invocations[]?;.executionSuccessful==true)}' baseline/cpp-smt-reference.sarif > flow/cpp-smt.baseline.normalized.json\njq 'def location:\n  .physicalLocation as $p | {path:($p.artifactLocation.uri // \"\"),\n  start:{line:($p.region.startLine // 0),col:($p.region.startColumn // 0)},\n  end:{line:($p.region.endLine // $p.region.startLine // 0),col:($p.region.endColumn // 0)},\n  message:(.message.text // .message.markdown // \"\")};\n{findings:([.runs[] as $run | $run.results[]? | . as $finding |\n {ruleId:.ruleId,message:(.message.text // .message.markdown // \"\"),\n severity:(.level // ([$run.tool.driver.rules[]? | select(.id==$finding.ruleId)][0].defaultConfiguration.level) // \"warning\"),\n locations:[.locations[]? | location],relatedLocations:([.relatedLocations[]? | location]|sort),\n codeFlows:([.codeFlows[]? | [.threadFlows[]? | [.locations[]? | .location | location]]]|sort)}] | sort),\n errors:([.runs[].invocations[]?.toolExecutionNotifications[]? | select(.level==\"error\") |\n {id:.descriptor.id,message:.message.text,locations:[.locations[]?|location]}]|sort),\n successful:all(.runs[].invocations[]?;.executionSuccessful==true)}' flow/cpp-smt.sarif > flow/cpp-smt.flow.normalized.json\njq -n --arg language cpp-smt --slurpfile baseline flow/cpp-smt.baseline.normalized.json --slurpfile flow flow/cpp-smt.flow.normalized.json '($baseline[0]) as $expected | ($flow[0]) as $actual |\n{language:$language,baselineCount:($expected.findings|length),flowCount:($actual.findings|length),\n codeFlows:([$actual.findings[].codeFlows[]]|length),\n baselineErrors:$expected.errors,flowErrors:$actual.errors,\n missing:($expected.findings-$actual.findings),extra:($actual.findings-$expected.findings),\n passed:($expected==$actual and $actual.successful and ($actual.errors|length)==0)}' > flow/cpp-smt.comparison.json\njq 'def location:\n  .physicalLocation as $p | {path:($p.artifactLocation.uri // \"\"),\n  start:{line:($p.region.startLine // 0),col:($p.region.startColumn // 0)},\n  end:{line:($p.region.endLine // $p.region.startLine // 0),col:($p.region.endColumn // 0)},\n  message:(.message.text // .message.markdown // \"\")};\n{findings:([.runs[] as $run | $run.results[]? | . as $finding |\n {ruleId:.ruleId,message:(.message.text // .message.markdown // \"\"),\n severity:(.level // ([$run.tool.driver.rules[]? | select(.id==$finding.ruleId)][0].defaultConfiguration.level) // \"warning\"),\n locations:[.locations[]? | location],relatedLocations:([.relatedLocations[]? | location]|sort),\n codeFlows:([.codeFlows[]? | [.threadFlows[]? | [.locations[]? | .location | location]]]|sort)}] | sort),\n errors:([.runs[].invocations[]?.toolExecutionNotifications[]? | select(.level==\"error\") |\n {id:.descriptor.id,message:.message.text,locations:[.locations[]?|location]}]|sort),\n successful:all(.runs[].invocations[]?;.executionSuccessful==true)}' baseline/cpp-iris-reference.sarif > flow/cpp-iris.baseline.normalized.json\njq 'def location:\n  .p