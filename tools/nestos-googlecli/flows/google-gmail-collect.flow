{
  "id": "google-gmail-collect",
  "name": "Gmail 邮件采集",
  "draftVersion": 1,
  "updatedAt": 0,
  "parameters": [
    {
      "name": "connection",
      "label": "我的 Google 连接",
      "type": "string",
      "required": true,
      "default": "personal",
      "description": "填写“我的数据连接”中的连接标识；始终使用当前登录用户自己的凭据。",
      "role": "option"
    },
    {
      "name": "directory",
      "label": "保存来源目录",
      "type": "string",
      "required": true,
      "default": "imports/mail",
      "description": "当前用户授权的资源保存目录；账号目录由工具按连接标识隔离。",
      "role": "option"
    },
    {
      "name": "maxItems",
      "label": "每批处理条数",
      "type": "number",
      "default": 100,
      "description": "每批处理 1–500 条；保存进度后继续后续批次，不限制整个范围的总量。",
      "role": "policy",
      "minimum": 1,
      "maximum": 500,
      "integer": true
    },
    {
      "name": "query",
      "label": "邮件范围",
      "type": "string",
      "required": true,
      "default": "newer_than:30d -in:trash -in:spam",
      "description": "Gmail 搜索语法，例如 newer_than:7d label:work。完整读取范围内的邮件，不修改邮箱。",
      "role": "option"
    },
    {
      "name": "sourceKey",
      "label": "来源标识",
      "type": "string",
      "default": "default",
      "description": "同一账号的多个独立采集范围使用不同标识；修改范围时保留标识，已有归档保留并重新核对新范围。只使用英文字母、数字、点、下划线或连字符。",
      "role": "policy"
    }
  ],
  "runPolicy": {
    "maxNodes": 4,
    "maxConcurrency": 1
  },
  "nodes": [
    {
      "id": "collect",
      "name": "读取并保存来源",
      "plugin": "builtin.tool",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "capabilities": [
        "google.collect"
      ],
      "config": {
        "toolId": "google.collect",
        "toolVersion": "1",
        "approval": "none",
        "args": {
          "connection": "${param.connection}",
          "directory": "${param.directory}",
          "maxItems": "${param.maxItems}",
          "query": "${param.query}",
          "sourceKey": "${param.sourceKey}",
          "resource": "mail"
        }
      }
    }
  ],
  "edges": [],
  "outputs": {
    "result": {
      "value": "${nodes.collect.outputs.result}"
    }
  },
  "layout": {
    "nodes": {
      "collect": {
        "x": 80,
        "y": 80
      }
    },
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}
