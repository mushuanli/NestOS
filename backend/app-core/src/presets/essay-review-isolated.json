{
  "id": "essay-review-isolated",
  "name": "作文四维评审",
  "draftVersion": 1,
  "updatedAt": 0,
  "layout": {
    "nodes": {
      "collect": {
        "x": 0,
        "y": 250
      },
      "review": {
        "x": 520,
        "y": 250
      },
      "check-content": {
        "x": 810,
        "y": 0
      },
      "check-structure": {
        "x": 810,
        "y": 180
      },
      "check-language": {
        "x": 810,
        "y": 360
      },
      "check-logic": {
        "x": 810,
        "y": 540
      },
      "aggregate": {
        "x": 1390,
        "y": 250
      },
      "judge": {
        "x": 1680,
        "y": 250
      },
      "report": {
        "x": 1980,
        "y": 250
      },
      "rewrite": {
        "x": 1680,
        "y": 540
      },
      "loop": {
        "x": 260,
        "y": 250
      },
      "join": {
        "x": 1100,
        "y": 250
      }
    },
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 0.65
    }
  },
  "parameters": [
    {
      "name": "requirements",
      "type": "string",
      "required": true,
      "onMissing": "interact"
    },
    {
      "name": "essay",
      "type": "string",
      "required": true,
      "onMissing": "interact"
    },
    {
      "name": "maxRounds",
      "type": "number",
      "required": true,
      "default": 10,
      "minimum": 1,
      "maximum": 1000,
      "integer": true,
      "description": "最多评审轮数"
    },
    {
      "name": "maxConcurrency",
      "type": "number",
      "required": true,
      "default": 4,
      "minimum": 1,
      "maximum": 4,
      "integer": true,
      "description": "同时执行的检查数"
    },
    {
      "name": "passScore",
      "type": "number",
      "required": true,
      "default": 9,
      "minimum": 0,
      "maximum": 10,
      "description": "各项达标分数"
    },
    {
      "name": "maxExchanges",
      "type": "number",
      "required": true,
      "default": 4,
      "minimum": 2,
      "maximum": 100,
      "integer": true,
      "description": "每个检查节点最多模型交互次数，包含工具调用后的续答和格式修复；与评审轮数独立"
    }
  ],
  "nodes": [
    {
      "id": "collect",
      "name": "补全作文输入",
      "plugin": "builtin.input",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "prompt": "请补充以下缺失或无效的内容：",
        "param": {
          "requirements": {
            "type": "string",
            "label": "作文要求",
            "nonBlank": true,
            "widget": "textarea"
          },
          "essay": {
            "type": "string",
            "label": "作文内容",
            "nonBlank": true,
            "widget": "textarea"
          },
          "passScore": {
            "type": "number",
            "default": 9,
            "widget": "number"
          }
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "loop",
      "name": "评审循环",
      "plugin": "builtin.loop",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "maxRounds": "${param.maxRounds}"
      },
      "assign": {
        "round": "${output.round}"
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "review",
      "name": "并发评审任务组",
      "plugin": "builtin.taskGroup",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "maxConcurrency": "${param.maxConcurrency}"
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "check-content",
      "name": "审题与内容检查",
      "plugin": "builtin.agent",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "systemPrompt": [
          "执行审题与内容检查。按作文要求评审作文，给出0到10分的score、具体issues和suggestions。只输出符合schema的JSON，不修改作文，不参考其他检查评分。"
        ],
        "instruction": "作文要求：${param.requirements}\n作文内容：${vars.essay}\n请根据你的 system prompt 中的职责进行检查，返回 score、issues、suggestions。",
        "invocationContext": "isolated",
        "historyPolicy": "none",
        "includeDependencyOutputs": false,
        "approval": "none",
        "maxExchanges": "${param.maxExchanges}",
        "temperature": 0,
        "connectionId": "default",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "review_result",
            "schema": {
              "type": "object",
              "required": [
                "score",
                "issues",
                "suggestions"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suggestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "strict": true
          }
        },
        "outputValidation": {
          "onInvalid": "repair",
          "retries": 3
        }
      }
    },
    {
      "id": "check-structure",
      "name": "结构主旨检查",
      "plugin": "builtin.agent",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "systemPrompt": [
          "执行结构主旨检查。按作文要求评审作文，给出0到10分的score、具体issues和suggestions。只输出符合schema的JSON，不修改作文，不参考其他检查评分。"
        ],
        "instruction": "作文要求：${param.requirements}\n作文内容：${vars.essay}\n请根据你的 system prompt 中的职责进行检查，返回 score、issues、suggestions。",
        "invocationContext": "isolated",
        "historyPolicy": "none",
        "includeDependencyOutputs": false,
        "approval": "none",
        "maxExchanges": "${param.maxExchanges}",
        "temperature": 0,
        "connectionId": "default",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "review_result",
            "schema": {
              "type": "object",
              "required": [
                "score",
                "issues",
                "suggestions"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suggestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "strict": true
          }
        },
        "outputValidation": {
          "onInvalid": "repair",
          "retries": 3
        }
      }
    },
    {
      "id": "check-language",
      "name": "描写语言检查",
      "plugin": "builtin.agent",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "systemPrompt": [
          "执行描写语言检查。按作文要求评审作文，给出0到10分的score、具体issues和suggestions。只输出符合schema的JSON，不修改作文，不参考其他检查评分。"
        ],
        "instruction": "作文要求：${param.requirements}\n作文内容：${vars.essay}\n请根据你的 system prompt 中的职责进行检查，返回 score、issues、suggestions。",
        "invocationContext": "isolated",
        "historyPolicy": "none",
        "includeDependencyOutputs": false,
        "approval": "none",
        "maxExchanges": "${param.maxExchanges}",
        "temperature": 0,
        "connectionId": "default",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "review_result",
            "schema": {
              "type": "object",
              "required": [
                "score",
                "issues",
                "suggestions"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suggestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "strict": true
          }
        },
        "outputValidation": {
          "onInvalid": "repair",
          "retries": 3
        }
      }
    },
    {
      "id": "check-logic",
      "name": "逻辑一致性检查",
      "plugin": "builtin.agent",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "systemPrompt": [
          "执行逻辑一致性检查。按作文要求评审作文，给出0到10分的score、具体issues和suggestions。只输出符合schema的JSON，不修改作文，不参考其他检查评分。"
        ],
        "instruction": "作文要求：${param.requirements}\n作文内容：${vars.essay}\n请根据你的 system prompt 中的职责进行检查，返回 score、issues、suggestions。",
        "invocationContext": "isolated",
        "historyPolicy": "none",
        "includeDependencyOutputs": false,
        "approval": "none",
        "maxExchanges": "${param.maxExchanges}",
        "temperature": 0,
        "connectionId": "default",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "review_result",
            "schema": {
              "type": "object",
              "required": [
                "score",
                "issues",
                "suggestions"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "suggestions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "strict": true
          }
        },
        "outputValidation": {
          "onInvalid": "repair",
          "retries": 3
        }
      }
    },
    {
      "id": "join",
      "name": "等待全部评审结果",
      "plugin": "builtin.join",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "mode": "all",
        "remaining": "continue",
        "failure": "fail",
        "result": "collect",
        "keys": {
          "check-content": "content",
          "check-structure": "structure",
          "check-language": "language",
          "check-logic": "logic"
        }
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "aggregate",
      "name": "汇总各项结果",
      "plugin": "builtin.aggregate",
      "pluginVersion": "3.0.0",
      "inputs": {},
      "config": {
        "reducer": "latest@1",
        "previous": "${vars.results}",
        "updates": {
          "content": {
            "value": "${nodes.join.outputs.result.results.content}",
            "current": true,
            "round": "${iteration.round}",
            "inputRevision": "${iteration.round}"
          },
          "structure": {
            "value": "${nodes.join.outputs.result.results.structure}",
            "current": true,
            "round": "${iteration.round}",
            "inputRevision": "${iteration.round}"
          },
          "language": {
            "value": "${nodes.join.outputs.result.results.language}",
            "current": true,
            "round": "${iteration.round}",
            "inputRevision": "${iteration.round}"
          },
          "logic": {
            "value": "${nodes.join.outputs.result.results.logic}",
            "current": true,
            "round": "${iteration.round}",
            "inputRevision": "${iteration.round}"
          }
        }
      },
      "assign": {
        "results": "${output}"
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "judge",
      "name": "路由：结束或继续修改",
      "plugin": "builtin.route",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "mode": "exclusive",
        "rules": [
          {
            "edgeId": "judge-report",
            "expression": {
              "kind": "and",
              "args": [
                {
                  "kind": "gte",
                  "args": [
                    {
                      "kind": "path",
                      "path": [
                        "input",
                        "content",
                        "value",
                        "score"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": "${param.passScore}"
                    }
                  ]
                },
                {
                  "kind": "gte",
                  "args": [
                    {
                      "kind": "path",
                      "path": [
                        "input",
                        "structure",
                        "value",
                        "score"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": "${param.passScore}"
                    }
                  ]
                },
                {
                  "kind": "gte",
                  "args": [
                    {
                      "kind": "path",
                      "path": [
                        "input",
                        "language",
                        "value",
                        "score"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": "${param.passScore}"
                    }
                  ]
                },
                {
                  "kind": "gte",
                  "args": [
                    {
                      "kind": "path",
                      "path": [
                        "input",
                        "logic",
                        "value",
                        "score"
                      ]
                    },
                    {
                      "kind": "literal",
                      "value": "${param.passScore}"
                    }
                  ]
                }
              ]
            },
            "value": "condition_met"
          },
          {
            "edgeId": "judge-report",
            "expression": {
              "kind": "gte",
              "args": [
                {
                  "kind": "literal",
                  "value": "${iteration.round}"
                },
                {
                  "kind": "literal",
                  "value": "${param.maxRounds}"
                }
              ]
            },
            "value": "max_rounds"
          }
        ],
        "defaultEdgeId": "judge-rewrite"
      },
      "outputPolicy": {
        "includeInRunOutput": false,
        "publishToHistory": false
      }
    },
    {
      "id": "rewrite",
      "name": "根据评审意见修改作文",
      "plugin": "builtin.agent",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "systemPrompt": [
          "你是作文修改员。根据四维评审意见修改作文，保持原题意、事实和作者立场。只输出一个符合 schema 的 JSON 对象，essay 为完整修改稿。不得添加 Markdown 代码块或解释。essay 字符串内的换行、双引号、反斜杠必须按 JSON 规则转义，不得截断输出。"
        ],
        "instruction": "作文要求：${param.requirements}\n当前作文：${vars.essay}\n本轮评审意见：${vars.results}\n请针对这些意见改写作文，返回完整的 essay。",
        "invocationContext": "isolated",
        "historyPolicy": "none",
        "includeDependencyOutputs": false,
        "approval": "none",
        "maxExchanges": "${param.maxExchanges}",
        "connectionId": "default",
        "responseFormat": {
          "type": "json_schema",
          "json_schema": {
            "name": "revised_essay",
            "schema": {
              "type": "object",
              "properties": {
                "essay": {
                  "type": "string"
                }
              },
              "required": [
                "essay"
              ],
              "additionalProperties": false
            },
            "strict": true
          }
        },
        "outputValidation": {
          "onInvalid": "repair",
          "retries": 3
        }
      },
      "assign": {
        "essay": "${output.essay}"
      }
    },
    {
      "id": "report",
      "name": "最终评审状态",
      "plugin": "builtin.transform",
      "pluginVersion": "1.0.0",
      "inputs": {},
      "config": {
        "value": {
          "results": "${vars.results}",
          "completedRounds": "${vars.round}",
          "stopReason": "${nodes.judge.outputs.result.selectedValue}",
          "inputs": {
            "essay": "${param.essay}"
          },
          "vars": {
            "essay": "${vars.essay}"
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "collect-loop",
      "from": "collect",
      "to": "loop",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "loop-review",
      "from": "loop",
      "to": "review",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "review-check-content",
      "from": "review",
      "to": "check-content",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "check-content-join",
      "from": "check-content",
      "to": "join",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "review-check-structure",
      "from": "review",
      "to": "check-structure",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "check-structure-join",
      "from": "check-structure",
      "to": "join",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "review-check-language",
      "from": "review",
      "to": "check-language",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "check-language-join",
      "from": "check-language",
      "to": "join",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "review-check-logic",
      "from": "review",
      "to": "check-logic",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "check-logic-join",
      "from": "check-logic",
      "to": "join",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "join-aggregate",
      "from": "join",
      "to": "aggregate",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "aggregate-judge",
      "from": "aggregate",
      "to": "judge",
      "kind": "data",
      "output": "result",
      "input": "input"
    },
    {
      "id": "judge-report",
      "from": "judge",
      "to": "report",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "judge-rewrite",
      "from": "judge",
      "to": "rewrite",
      "kind": "control",
      "output": "result",
      "input": "input"
    },
    {
      "id": "rewrite-loop",
      "from": "rewrite",
      "to": "loop",
      "kind": "control",
      "output": "result",
      "input": "input"
    }
  ],
  "variables": {
    "essay": {
      "type": "string",
      "initial": "${param.essay}"
    },
    "results": {
      "type": "json",
      "initial": {}
    },
    "round": {
      "type": "number",
      "initial": 0
    }
  }
}
