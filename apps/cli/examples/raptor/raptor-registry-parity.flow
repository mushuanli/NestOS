          "command": ": > output/jwt.metadata.json\nsemgrep scan --config p/jwt --verbose --metrics off --disable-version-check --error --sarif --disable-nosem --no-git-ignore --x-ignore-semgrepignore-files --timeout 120 --jobs 1 --json-output output/jwt.metadata.json --exclude node_modules/ --exclude bower_components/ --exclude .yarn/ --exclude .npm/ --exclude vendor/ --exclude third_party/ --exclude site-packages/ --exclude .venv/ --exclude .tox/ --exclude build/ --exclude dist/ --exclude '*.min.js' --exclude '*.min.css' --exclude package-lock.json --exclude yarn.lock --exclude pnpm-lock.yaml --exclude poetry.lock --exclude Pipfile.lock --exclude Cargo.lock --exclude composer.lock --exclude Gemfile.lock --exclude go.sum target > output/jwt.sarif 2> output/jwt.stderr.log\nscan_status=$?\njq -nc --arg pack p/jwt --argjson exitCode \"$scan_status\" '{pack:$pack,exitCode:$exitCode}' > output/jwt.status.json\ncat output/jwt.status.json",
