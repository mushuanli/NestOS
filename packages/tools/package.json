{
  "name": "@itookit/tools",
  "version": "0.1.0",
  "description": "Built-in LLM tools — File, Search, Shell, Task, Agent with buildTool() factory pattern",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./mcp-contracts": {
      "types": "./src/mcp-contracts.ts",
      "import": "./src/mcp-contracts.ts",
      "default": "./src/mcp-contracts.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./contracts": {
        "import": {
          "types": "./dist/contracts.d.ts",
          "default": "./dist/contracts.js"
        },
        "require": {
          "types": "./dist/contracts.d.cts",
          "default": "./dist/contracts.cjs"
        }
      },
      "./mcp-contracts": {
        "import": {
          "types": "./dist/mcp-contracts.d.ts",
          "default": "./dist/mcp-contracts.js"
        },
        "require": {
          "types": "./dist/mcp-contracts.d.cts",
          "default": "./dist/mcp-contracts.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "itookit",
    "tools",
    "llm",
    "agent"
  ],
  "author": "lizlok@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mushuanli/itookit.git",
    "directory": "packages/tools"
  },
  "dependencies": {
    "@itookit/vfs-core": "workspace:*",
    "zod": "^4.4.2",
    "@itookit/llm-context": "workspace:*",
    "@itookit/driver-llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
