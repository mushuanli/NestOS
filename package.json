{
    "name": "itookit",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "pnpm --filter mind-os dev",
        "httpd": "pnpm --filter @itookit/http-app dev",
        "build": "pnpm -r build",
        "build:libs": "pnpm --filter './packages/*' build",
        "test": "pnpm architecture:check && node --test scripts/tests/test-all.test.mjs && node scripts/test-all.mjs",
        "release": "pnpm --filter ./apps/web-app build && node scripts/release.js",
        "deploy:pages": "pnpm --filter ./apps/web-app build && node scripts/deploy-gh-pages.js",
        "tauri:dev": "pnpm --filter tauri-app tauri:dev",
        "tau": "pnpm --filter tauri-app tauri:dev",
        "tauri:build": "pnpm build:libs && pnpm --filter tauri-app tauri:build",
        "cli": "node apps/cli/dist/cli.js",
        "cli:build": "pnpm --filter @itookit/cli build",
        "migrate:legacy-chats": "pnpm --filter @itookit/cli exec tsx scripts/migrate-legacy-chats.ts",
        "clean": "pnpm -r clean && rm -rf node_modules",
        "typecheck": "pnpm -r typecheck",
        "docs:check": "node scripts/check-docs.mjs",
        "styles:check": "node scripts/check-styles.mjs",
        "architecture:check": "node --test scripts/tests/check-boundaries.test.mjs && node scripts/check-boundaries.mjs",
        "test:matrix": "pnpm architecture:check && node --test scripts/tests/test-all.test.mjs && node scripts/test-all.mjs",
        "npm:prepare": "node scripts/release-npm-libraries.mjs prepare",
        "npm:publish": "node scripts/release-npm-libraries.mjs publish",
        "npm:migrate": "node scripts/migrate-npm-libraries.mjs apply"
    },
    "keywords": [],
    "author": "lizlok@gmail.com",
    "license": "ISC",
    "packageManager": "pnpm@10.20.0",
    "devDependencies": {
        "jsdoc": "^4.0.5",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "@itookit/vfs-sync": "0.1.0",
        "@itookit/vfs-core": "5.3.1",
        "@itookit/vfs-ui": "0.5.5",
        "@itookit/vfsdriver-indexeddb": "5.3.1",
        "@itookit/vfsdriver-local": "5.3.0",
        "@itookit/driver-llm": "0.2.0",
        "@itookit/mdxeditor": "0.5.1"
    },
    "pnpm": {
        "overrides": {
            "@codemirror/view": "^6.43.5",
            "@codemirror/autocomplete": "^6.20.3",
            "@codemirror/commands": "^6.10.4",
            "@codemirror/lang-javascript": "^6.2.5",
            "@codemirror/language": "^6.12.4",
            "@codemirror/lint": "^6.9.7",
            "@codemirror/search": "^6.7.1",
            "@codemirror/state": "^6.7.1",
            "@lezer/common": "^1.5.2",
            "@lezer/lr": "^1.4.10",
            "@marijn/find-cluster-break": "^1.0.3",
            "@babel/helper-string-parser": "^7.29.7",
            "@babel/helper-validator-identifier": "^7.29.7",
            "@babel/parser": "^7.29.7",
            "@babel/types": "^7.29.7",
            "acorn": "^8.17.0",
            "crelt": "^1.0.7",
            "hasown": "^2.0.4",
            "is-core-module": "^2.16.2",
            "lodash": "^4.17.23",
            "nanoid": "^3.3.15",
            "picomatch": "^4.0.5",
            "postcss": "^8.5.16",
            "resolve": "^1.22.12",
            "semver": "^7.8.5",
            "vscode-uri": "^3.1.0",
            "@types/estree": "^1.0.9"
        }
    },
    "dependencies": {
        "jsdoc-tsimport-plugin": "^1.0.5",
        "vite": "^7.2.4"
    }
}
