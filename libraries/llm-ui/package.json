{
  "name": "@itookit/llm-ui",
  "version": "0.2.1",
  "description": "Host-driven native DOM chat and Flow components",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css",
    "./flow": "./src/flow.ts",
    "./flow.css": "./src/flow.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/llm-ui.umd.cjs",
    "module": "./dist/llm-ui.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/llm-ui.js",
        "require": "./dist/llm-ui.umd.cjs"
      },
      "./style.css": "./dist/style.css",
      "./flow": {
        "types": "./dist/flow.d.ts",
        "import": "./dist/flow.js"
      },
      "./flow.css": "./dist/flow.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.flow.config.ts && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@itookit/mdxeditor": "^0.5.8"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^1.6.1",
    "jsdom": "^27.2.0",
    "@types/node": "^20.19.25"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mushuanli/itookit.git",
    "directory": "libraries/llm-ui"
  }
}
